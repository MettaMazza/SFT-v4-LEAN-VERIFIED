torical adverse retention"),("falsification_condition",.text "Reject if any source identity or registered row changes; if the exact terminal prediction leaves any registered current electronic, muonic, CODATA or outward PRad interval; if the historical CODATA-2014 conflict or current extraction limitations are omitted; if a probe, radius or Compton value enters before sealing; if observation is claimed to select ten charge cells; or if target access precedes the seal.")])

def releasedTargets (files : List (String × ByteArray)) (payload : Value) : Except String (List (String × Value)) := do
 let record ← ProtonRadiusRecords.authoritativeRecord files payload
 pure [("WITHHELD-PROTON-RADIUS-COMPLETE-VECTOR",← field record "registered_target")]
def envelope (derivationSeal : String) (inputs : List (String × CapabilityValues.Value)) (registrationHash : String) : Value := .object [
 ("experiment_id",.text experimentId),("registered_inputs",.object (inputs.map (fun (key,value) => (key,.text (admissionIdentity (CapabilityValues.canonical value)))))),
 ("withheld_target_ids",.array (targetIds.map Value.text)),("frozen_relation_hash",.text (admissionIdentity (.array [.text derivationSeal,.text frozenRelation]))),("experiment_registration_hash",.text registrationHash)]
end SFT.Physics.ProtonRadiusExperiment
