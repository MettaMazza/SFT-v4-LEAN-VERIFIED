import SFT.Consciousness.StructuralModel
namespace SFT.Consciousness.RedRecurrence
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 distinction : String
 operation : String
 retained_record : String
 evidence_boundary : String
 statement : String
def original : Obligation := ⟨"SFT-CONSC-RED-RECURRENCE-001","Red recurrence","red_of_red","three-position-quality-support","stable-return/changed-quality","one-seven-two-seven-four-seven-cycle","complete-cycle-and-label","formal-plus-first-person","The least registered three-position qualitative support is the exact one-seventh, two-sevenths, four-sevenths recurrence whose parts compose to the One; empirical evidence tests whether red identity is retained across the cycle."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def distinctionWitness : Bool := !(SFT.Host.Text.equal original.distinction original.operation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier) && !(SFT.Host.Text.equal original.evidence_boundary original.distinction)
def exactFoldWitness : Bool := ((match StructuralModel.structuralWitnesses.find? (fun row => SFT.Host.Text.equal row.1 "red_of_red_form_is_complete") with | some (_, passed) => passed | none => false))
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem distinctionWitnessPassed : distinctionWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by decide
end SFT.Consciousness.RedRecurrence
