import SFT.EarthEnvironment.StructuralModel
namespace SFT.EarthEnvironment.EarthCryosphere
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 relation : String
 retained_record : String
 evidence_boundary : String
 statement : String
 falsification_condition : String
def original : Obligation := ⟨"SFT-EARTH-CRYOSPHERE-001","Cryosphere state and transition","hydrosphere_cryosphere","snow-ice-frozen-ground-carrier","accumulation-transport-phase-and-loss-relation","extent-thickness-mass-motion-age-and-uncertainty-held","method-region-time-bounded","A cryosphere state retains snow, ice and frozen-ground identities, mass, extent, thickness, motion, age, phase transitions and measurement uncertainty.","Reject if area alone is substituted for mass, if unavailable thickness becomes absence, or if distinct ice reservoirs are pooled without record."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def relationWitness : Bool := !(SFT.Host.Text.equal original.carrier original.relation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier)
def exactFoldWitness : Bool :=
 match StructuralModel.structuralWitnesses with
 | .error _ => false
 | .ok rows =>
  (match rows.find? (fun row => SFT.Host.Text.equal row.1 "complementary_cycle_recurs") with
   | none => false | some row => row.2) &&
  (match rows.find? (fun row => SFT.Host.Text.equal row.1 "reservoir_partition_closes") with
   | none => false | some row => row.2)
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem relationWitnessPassed : relationWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by rfl
end SFT.EarthEnvironment.EarthCryosphere
