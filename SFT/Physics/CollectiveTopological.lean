import SFT.Physics.CollectivePhaseOrder
namespace SFT.Physics.CollectiveTopological
open SFT.Mathematics.GraphOperations

structure Complex where
 cells : CollectiveCoarseGrain.NetworkObservation
 faces : List GeneratedGraph
 boundaryRecords : List (String × String)
 faceContained : ∀ face, face ∈ faces →
   (∀ node, node ∈ face.nodes → node ∈ cells.graph.nodes) ∧
   (∀ edge, edge ∈ face.edges → edge ∈ cells.graph.edges)

def endpoints (path : List String) := (path.head?,path.reverse.head?)

-- A local deformation retains its actual face, both routes, context and
-- complete endpoint record. The inverse uses the same registered face.
inductive Elementary (c : Complex) : List String → List String → Prop where
 | face (registered : GeneratedGraph) (held : registered ∈ c.faces)
   (left right beforePath afterPath : List String)
   (leftSupported : pathIsValid registered left = true)
   (rightSupported : pathIsValid registered right = true)
   (sameBoundary : endpoints (beforePath ++ left ++ afterPath) = endpoints (beforePath ++ right ++ afterPath))
   (beforeValid : pathIsValid c.cells.graph (beforePath ++ left ++ afterPath) = true)
   (afterValid : pathIsValid c.cells.graph (beforePath ++ right ++ afterPath) = true) :
   Elementary c (beforePath ++ left ++ afterPath) (beforePath ++ right ++ afterPath)

variable {c : Complex} {a b d : List String}

theorem elementaryReverse (change : Elementary c a b) : Elementary c b a := by
 cases change with
 | face registered held left right beforePath afterPath ls rs boundary before after =>
   exact .face registered held right left beforePath afterPath rs ls boundary.symm after before

theorem elementarySourceValid (change : Elementary c a b) : pathIsValid c.cells.graph a = true := by
 cases change with
 | face _ _ _ _ _ _ _ _ _ before _ => exact before

theorem elementaryTargetValid (change : Elementary c a b) : pathIsValid c.cells.graph b = true :=
 elementarySourceValid (elementaryReverse change)

theorem elementaryBoundary (change : Elementary c a b) : endpoints a = endpoints b := by
 cases change with
 | face _ _ _ _ _ _ _ _ boundary _ _ => exact boundary

inductive Trace (c : Complex) : List String → List String → Prop where
 | identity (path : List String) (valid : pathIsValid c.cells.graph path = true) : Trace c path path
 | append {first prior next : List String} : Trace c first prior → Elementary c prior next → Trace c first next

theorem traceSourceValid (trace : Trace c a b) : pathIsValid c.cells.graph a = true := by
 induction trace with
 | identity valid => exact valid
 | append prior change ih => exact ih

theorem traceTargetValid (trace : Trace c a b) : pathIsValid c.cells.graph b = true := by
 cases trace with
 | identity valid => exact valid
 | append prior change => exact elementaryTargetValid change

theorem traceCompose (first : Trace c a b) (second : Trace c b d) : Trace c a d := by
 induction second with
 | identity => exact first
 | append prior change ih => exact .append ih change

theorem traceReverse (trace : Trace c a b) : Trace c b a := by
 induction trace with
 | identity valid => exact .identity _ valid
 | @append prior next history change ih =>
   have reverseStep : Trace c next prior :=
     .append (.identity next (elementaryTargetValid change)) (elementaryReverse change)
   exact traceCompose reverseStep ih

theorem traceBoundary (trace : Trace c a b) : endpoints a = endpoints b := by
 induction trace with
 | identity => rfl
 | append prior change ih => exact ih.trans (elementaryBoundary change)

-- The global class is the complete relation generated by these reversible
-- local moves, not a finite sample of endpoint coincidences.
def sameClass (c : Complex) (left right : List String) : Prop := Trace c left right

theorem completeClassInvariant (change : Trace c a b) (path : List String) :
 sameClass c a path ↔ sameClass c b path :=
 ⟨fun earlier => traceCompose (traceReverse change) earlier,
  fun later => traceCompose change later⟩

theorem differentClassRetained (change : Trace c a b) (path : List String)
 (different : ¬ sameClass c a path) : ¬ sameClass c b path :=
 fun same => different ((completeClassInvariant change path).mpr same)

theorem noBoundaryChangingTrace (different : endpoints a ≠ endpoints b) : ¬ Trace c a b :=
 fun trace => different (traceBoundary trace)

-- The generated class contains precisely the finite closure of the source moves.
theorem leastGeneratedRelation (relation : List String → List String → Prop)
 (identity : ∀ p, pathIsValid c.cells.graph p = true → relation p p)
 (step : ∀ p q r, relation p q → Elementary c q r → relation p r)
 (trace : Trace c a b) : relation a b := by
 induction trace with
 | identity valid => exact identity _ valid
 | append prior change ih => exact step _ _ _ ih change

def recordedBoundary (c : Complex) (path : List String) : Prop :=
 ∃ pair, pair ∈ c.boundaryRecords ∧ endpoints path = (some pair.1, some pair.2)

theorem boundaryCorrespondence (trace : Trace c a b) :
 recordedBoundary c a ↔ recordedBoundary c b := by
 constructor
 · intro ⟨pair, held, equal⟩
   exact ⟨pair, held, (traceBoundary trace).symm.trans equal⟩
 · intro ⟨pair, held, equal⟩
   exact ⟨pair, held, (traceBoundary trace).trans equal⟩

def squareFace : GeneratedGraph :=
 ⟨["1","2","3","4"],[("1","2"),("2","4"),("1","3"),("3","4")]⟩

theorem squareLeftSupported : pathIsValid squareFace ["1","2","4"] = true := by decide
theorem squareRightSupported : pathIsValid squareFace ["1","3","4"] = true := by decide
theorem squareEndpoints : endpoints ["1","2","4"] = endpoints ["1","3","4"] := rfl

theorem registeredSquareDeformation (held : squareFace ∈ c.faces)
 (left : pathIsValid c.cells.graph ["1","2","4"] = true)
 (right : pathIsValid c.cells.graph ["1","3","4"] = true) :
 Elementary c ["1","2","4"] ["1","3","4"] :=
 .face squareFace held ["1","2","4"] ["1","3","4"] [] []
 squareLeftSupported squareRightSupported squareEndpoints left right

theorem registeredSquareClass (held : squareFace ∈ c.faces)
 (left : pathIsValid c.cells.graph ["1","2","4"] = true)
 (right : pathIsValid c.cells.graph ["1","3","4"] = true) :
 sameClass c ["1","2","4"] ["1","3","4"] :=
 .append (.identity _ left) (registeredSquareDeformation held left right)

end SFT.Physics.CollectiveTopological
