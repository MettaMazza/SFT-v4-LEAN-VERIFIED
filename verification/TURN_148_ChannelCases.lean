import SFT.InformationScience.ChannelExtension
open SFT.InformationScience.ChannelRelation SFT.InformationScience.ChannelSelections SFT.InformationScience.ChannelExtension
set_option maxRecDepth 100000
set_option maxHeartbeats 0
def check (channel : FiniteChannel) (fresh : String) (targets : List String) (supports candidates : List (List String)) : Bool :=
  let next := extend channel fresh targets
  decide (next.inputs.map (rawSupport next.relation) = supports) && decide (codeCandidates next = candidates)
