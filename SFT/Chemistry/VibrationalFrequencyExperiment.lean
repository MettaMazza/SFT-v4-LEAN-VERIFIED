def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-009 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 if !sameValue (get document "schema") (.text "sft-v3-vibrational-frequency-identities/1") ||
    !sameValue (get document "all_frequency_values_absent") (.boolean true) ||
    !sameValue (get document "complete_row_count") (.integer 2009) || rows.length != 2009 ||
    !sameValue (get document "complete_displayed_molecule_count") (.integer 145) ||
    !(rows.all fun row => sameValue (get row "target_value_absent") (.boolean true) &&
     match row with
     | .object fields => !(fields.any fun (key,_) => ["measurement_present","frequency_inscription_cm_inverse",
       "exact_positive_recurrence_ratio_per_centimeter","external_measurement_absence"].any (Text.equal key))
     | .null | .boolean _ | .integer _ | .text _ | .array _ => false) then
  throw "PROP-009 value-free identity boundary changed"
 pure rows
def identityFields : List (String × String) := [("formula","molecular-formula"),("name","molecular-name"),("symmetry_label","vibrational-symmetry"),("measurement_kind","measurement-kind"),("measurement_unit","measurement-unit"),("source_id","source-identity"),("source_locator","source-locator")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "vibrational-frequency-row-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= text
  let destination := Text.intercalate "" [rowPrefix,"-label-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let counted ← ["mode_count","molecule_count","vibration_count"].zipIdx.mapM fun (key,index) => do
  let value ← field row key >>= JointCorrelationTargets.integer
  let destination := Text.intercalate "" [rowPrefix,"-count-",toString (index+1)]
  pure (instruction "count" destination [(match value with | .ofNat n => toString n | .negSucc n => Text.append "-" (toString (n+1)))],destination)
 let uncertainty := Text.append rowPrefix "-uncertainty"
 let uncertaintyInstruction := instruction "label" uncertainty ["source-uncertainty-status","source-row-does-not-display-uncertainty"]
 let laws := [("frequency-law","positive-finite-recurrence-count-over-positive-interval-count"),
 ("unit-translation-law","recurrence-ratio-before-held-reciprocal-centimeter-label"),
 ("measurement-absence-law","unmeasured-displayed-cell-is-structural-EmptyOne")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (12+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ counted.map Prod.snd ++ [uncertainty] ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  counted.map Prod.fst ++ [uncertaintyInstruction] ++ lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-displayed-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "vibrational-frequency-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["vibrational-frequency-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_measurement_registry",.array [.text targetPath,.text targetHash]),
 ("source_snapshot",.array [.text snapshotPath,.text snapshotHash]),
 ("normalized_primary_records",.array [.text primaryPath,.text primaryHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_2009_frequency_values_absent_from_prediction",.boolean true),("falsification_condition",.text falsification)])
def expectedLabel : String := "exact-positive-finite-recurrence-ratio-with-held-mode-and-unit-translation"
def dimensions : List (String × List (String × Bool)) := [("carrier",[("frequency-answer-with-erased-mode",false),("complete-molecule-mode-symmetry-carrier",true)]),("recurrence",[("continuum-sinusoid-premise",false),("finite-generated-recurrence-count",true)]),("magnitude",[("imported-frequency-scalar",false),("exact-recurrence-over-interval-ratio",true)]),("mode",[("merged-or-relabelled-mode-support",false),("held-distinct-mode-and-symmetry-support",true)]),("translation",[("frequency-unit-selects-law",false),("post-recurrence-held-unit-translation",true)]),("prediction",[("frequency-target-readable-before-seal",false),("value-free-complete-mode-seal",true)]),("record",[("favorable-measured-row-subset",false),("complete-displayed-NIST-surface-with-gap-custody",true)]),("extension",[("fitted-scale-or-molecular-correction",false),("one-recurrence-law-no-scale-factor",true)])]
