def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-010 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 if !sameValue (get document "schema") (.text "sft-v3-rotational-constant-identities/1") ||
    !sameValue (get document "all_rotational_constant_values_absent") (.boolean true) ||
    !sameValue (get document "complete_row_count") (.integer 3015) || rows.length != 3015 ||
    !sameValue (get document "complete_displayed_molecular_row_count") (.integer 1005) ||
    !(rows.all fun row => sameValue (get row "target_value_absent") (.boolean true) &&
     match row with
     | .object fields => !(fields.any fun (key,_) => ["measurement_present","rotational_constant_inscription_cm_inverse",
       "exact_positive_axis_recurrence_ratio_per_centimeter","external_measurement_absence"].any (Text.equal key))
     | .null | .boolean _ | .integer _ | .text _ | .array _ => false) then
  throw "PROP-010 value-free identity boundary changed"
 pure rows
def identityFields : List (String × String) := [("name","molecular-name"),("species","molecular-species"),("external_charge_inscription","external-charge-inscription"),("axis_label","rotational-axis"),("measurement_kind","measurement-kind"),("measurement_unit","measurement-unit"),("source_id","source-identity"),("source_locator","source-locator")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "rotational-constant-axis-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= text
  let destination := Text.intercalate "" [rowPrefix,"-label-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let counted ← ["displayed_molecular_row","displayed_axis_ordinal"].zipIdx.mapM fun (key,index) => do
  let value ← field row key >>= JointCorrelationTargets.integer
  let destination := Text.intercalate "" [rowPrefix,"-count-",toString (index+1)]
  pure (instruction "count" destination [(match value with | .ofNat n => toString n | .negSucc n => Text.append "-" (toString (n+1)))],destination)
 let laws := [("source-uncertainty-status","source-row-does-not-display-uncertainty"),
 ("geometry-law","finite-generated-molecular-geometry-with-held-axis"),
 ("rotational-constant-law","positive-axis-recurrence-count-over-positive-interval-count"),
 ("rotational-ladder-law","positive-JJplusOne-level-with-adjacent-2J-gap"),
 ("measurement-absence-law","blank-axis-cell-is-structural-EmptyOne")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (11+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ counted.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  counted.map Prod.fst ++ lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-axis-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "rotational-constant-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["rotational-constant-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_measurement_registry",.array [.text targetPath,.text targetHash]),
 ("complete_species_list_snapshot",.array [.text listSnapshotPath,.text listSnapshotHash]),
 ("complete_choice_snapshot",.array [.text choiceSnapshotPath,.text choiceSnapshotHash]),
 ("complete_result_snapshot",.array [.text snapshotPath,.text snapshotHash]),
 ("normalized_primary_records",.array [.text primaryPath,.text primaryHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_3015_rotational_values_absent_from_prediction",.boolean true),("falsification_condition",.text falsification)])
