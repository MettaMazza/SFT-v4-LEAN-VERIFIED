def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
 claimId := claimId
 title := "Terminal preparation-depth, support-uncertainty and joint-correlation law"
 branch := "physics"
 statement := "A complete binary preparation of N=2^k branches uniquely fixes its observation depth k and indivisible branch unit 1/N; depth three and eighth-One outcomes occur exactly for an eight-branch preparation, not universally. The Fold-held/returned parity table generates the complete Walsh observation without an imported signed, imaginary or irrational scalar. Exact phase-count orthogonality forces Parseval counting and therefore s_t*s_f>=N for every nonempty dyadic support. Weighting support counts by reciprocal exact grid spacings cancels the spacing and forces unit-free product (s_t*s_f)/N>=One; the squared normalized support-spread product is at least 1/N^2 and gives 1/16 at depth two. These are support-spread laws, not an unproved identification with statistical moment variance. Coprime 2-by-3 and 3-by-5 preparations visit every product cell once, but the complete product is factorable and is not entanglement by itself. Exhaustive joint-subset enumeration forces entanglement exactly at nonfactorability, preserves complete projections and makes remote relabelling locally invariant. Every factorized deterministic two-setting Bell record wins at most three of four setting classes; complete setting-inclusive joint support exceeds that factorization boundary while preserving exact local marginals and no signalling."
 evidenceMode := .formal
 rootTheorems := [SFT.Engine.rootTheoremId]
 dependencies := dependencies
 axioms := []
 freeParameters := []
 provenance := [.forwardForcing,.observationalDerivation]
 sourceHash := sourceHash
def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)
def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
 candidateId := candidateId c
 exactForm := exactForm c
 traceHash := admissionIdentity (.array [.text claimId,.text generationRule,candidateRecord c])
def censusData : SFT.Engine.CandidateCensus where
 generationRule := generationRule
 grammarBoundary := grammarBoundary
 expectedCardinality := .ofNat candidates.length
 completenessCertificateHash := admissionIdentity completenessRecord
 candidates := candidates.map generatedCandidateData
def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
 candidateId := candidateId c
 survives := survives c
 reason := decisionReason c
 proofHash := admissionIdentity (.array [.text claimId,.array (dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
 | some c => .ok (decisionData c)
 | none => .error "StopIteration"
def closureValue : Value := .object [("result",.text "For every complete dyadic preparation N=2^k and every nonempty position support, exact Fold-parity observation forces s_t*s_f>=N, unit-free support-spread product (s_t*s_f)/N>=One and squared normalized support-spread product at least 1/N^2; depth two attains 1/16 and an eight-branch preparation uniquely has depth three with branch unit 1/8. The complete 2-by-3 census has 63 nonempty supports: 21 factorable and 42 nonfactorable. The complete 3-by-5 census has 32767: 217 factorable and 32550 nonfactorable. Both full products are factorable, correcting their prior relabelling as entanglement; entanglement is the nonfactorable class. Complete projection preserves local counts under remote relabelling. All sixteen local deterministic Bell-response pairs obey the three-of-four bound, while setting-inclusive joint support can exceed it with invariant exact local marginals and no signalling."),("base",.text "At one binary preparation step, two held/returned branches generate two parity modes; diagonal products persist, the off-diagonal pair cancels, and the support, spread and measurement-unit relations close exactly."),("successor",.text "Appending one binary preparation label doubles branches and modes; each old phase row receives one preserving and one alternating successor, preserving diagonal completeness, off-diagonal cancellation, Parseval counting, the support bound and exact branch-unit refinement at the next depth."),("exclusions",.array [.text "no imported Fourier, Donoho-Stark, Heisenberg, tensor-product or Bell theorem as a premise",.text "no universal depth-three measurement rule independent of preparation",.text "no relabelling of support extent as statistical moment variance",.text "no relabelling of a complete Cartesian product or product-greater-than-sum arithmetic as entanglement",.text "no claim that fifteen is irreducible to its three-by-five product factors",.text "no ontic nondeterminism, stochastic setting oracle, superluminal signal or omitted preparation/setting record",.text "no measured Bell or uncertainty value accessible to candidate selection",.text "no numerical-nothingness, negative, irrational, imaginary, floating, NaN, continuum or completed-infinity proof magnitude"]),("witnesses",witnessRecords),("unique_survivor",.text survivorId)]
def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
 scope := .depthIndependent
 exactBoundary := grammarBoundary
 minimalityPassed := true
 namedShapeUniquenessPassed := true
 proofHash := admissionIdentity (.array [closureValue,.array (decisions.map SFT.Engine.decisionValue)])
 generalityCertificateHash := some (admissionIdentity closureValue)
def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

def control (kind : SFT.Engine.ControlKind) (passed : Bool) (observation : String) : SFT.Engine.ControlResult where
 kind := kind
 passed := passed
 expectedBehavior := observation
 observedBehavior := if passed then observation else "control failed"
 receiptHash := identity (.array [.text claimId,.text (SFT.Engine.kindName kind),.boolean passed,.text observation])
def exclusions : List String := ["no imported Fourier, Donoho-Stark, Heisenberg, tensor-product or Bell theorem as a premise", "no universal depth-three measurement rule independent of preparation", "no relabelling of support extent as statistical moment variance", "no relabelling of a complete Cartesian product or product-greater-than-sum arithmetic as entanglement", "no claim that fifteen is irreducible to its three-by-five product factors", "no ontic nondeterminism, stochastic setting oracle, superluminal signal or omitted preparation/setting record", "no measured Bell or uncertainty value accessible to candidate selection", "no numerical-nothingness, negative, irrational, imaginary, floating, NaN, continuum or completed-infinity proof magnitude"]
def controls (sourceHash : String) : List SFT.Engine.ControlResult := [
 control .falsePremise (!(SFT.Host.Text.equal (candidateId {survivor with depth := .rejected}) survivorId)) "reject the form missing the first structural preservation",
 control .tamperedSource (!(SFT.Host.Text.equal (identity (.object [("changed",.text sourceHash)])) sourceHash)) "reject a changed source identity",
 control .tamperedArtifact ((candidates.filter survives).length==1) "reject a missing, duplicate or additional survivor",
 control .boundary (!exclusions.isEmpty && witness0 && witness1 && witness2 && witness3 && witness4 && witness5 && witness6) "reject forbidden values, target feedback and extra laws"]
def runControls (sourceHash : String) : Value := .array ((controls sourceHash).map SFT.Engine.controlResultValue)

theorem registrationNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl
theorem registrationNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl
theorem decisionPreservesSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl
end SFT.Physics.QuantumSupportEntryEvidence
