import SFT.EarthEnvironment.StructuralModel
namespace SFT.EarthEnvironment.EarthNitrogenCycle
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 relation : String
 retained_record : String
 evidence_boundary : String
 statement : String
 falsification_condition : String
def original : Obligation := ⟨"SFT-EARTH-NITROGEN-CYCLE-001","Earth nitrogen cycle","biogeochemical_ecological","nitrogen-species-reservoir-network","transformation-storage-and-transfer-relation","species-isotopes-organisms-stocks-flows-and-time-held","earth-nitrogen-domain-bounded","The Earth nitrogen cycle retains each chemical species, abiotic and biological transformation, reservoir, transfer and observation boundary.","Reject if oxidation states, biological processes or atmospheric and aquatic boundaries are silently merged."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def relationWitness : Bool := !(SFT.Host.Text.equal original.carrier original.relation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier)
def exactFoldWitness : Bool :=
 match StructuralModel.structuralWitnesses with
 | .error _ => false
 | .ok rows =>
  match rows.find? (fun row => SFT.Host.Text.equal row.1 "coupled_cycle_recurs_and_closes") with
  | none => false
  | some row => row.2
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem relationWitnessPassed : relationWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by rfl
end SFT.EarthEnvironment.EarthNitrogenCycle
