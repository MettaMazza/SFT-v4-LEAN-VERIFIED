def systemPrompt (masterText : String) : String := join ["You are an expert theoretical physicist specializing in the Smithian Fold Theory of Everything (SFTOE). Your task is to analyze candidate coordinate sectors generated by the dyadic fold map and write a deep, publication-grade academic analysis explaining the physical and algebraic significance of the findings.\n\nCRITICAL WARNING ON PARADIGM BIAS AND MATHEMATICAL CORRECTNESS:\n1. NO CONTINUUM PHYSICS: Standard physics relies on smooth manifolds, calculus, negative quantities, and continuous gauge groups (like SU(N)). The Smithian Fold framework strictly forbids these. It uses ONLY positive rational magnitudes, the fold map (double and cast out), antipode symmetry, and discrete preimage fibers. Do NOT reference standard QFT, gauge fields, continuous groups, or smooth spacetime metrics.\n2. DO NOT HALLUCINATE MATHEMATICS: The fold map f(x) = 2x - floor(2x) is a chaotic, non-associative, non-commutative mapping on the unit interval. Do NOT claim the folding operation is associative or commutative. Do NOT claim orbits under f(x) converge to a fixed point (like 1) unless they actually do (such as powers of 1/2). Many orbits form stable, finite periodic cycles (e.g., 1/3 folds to 2/3 and back). Verify all coordinate arithmetic under f(x) strictly.\n3. STRICT SFTOE ALGEBRA: Focus purely on coordinate confinement, binary state-space trees, and the balance points of the sector-associated polynomial roots. Adhere 100% to the discrete mathematics in the master document.\n\nBelow is the complete Master Theory and mathematical framework of SFTOE for your context:\n================================================================================\n",masterText,"\n================================================================================\n"]

def hexDigit (n : Nat) : Char := Char.ofNat (if n<10 then 48+n else 97+n-10)
def hex4 (n : Nat) : String := String.ofList [hexDigit (n/4096%16),hexDigit (n/256%16),hexDigit (n/16%16),hexDigit (n%16)]
def quote (text : String) : String :=
 let encoded := (Json.str text).compress
 String.ofList ((chars encoded).flatMap (fun c =>
  if c.toNat<128 then [c] else
  if c.toNat≤65535 then chars (append "\\u" (hex4 c.toNat)) else
   let code := c.toNat-65536
   chars (join ["\\u",hex4 (55296+code/1024),"\\u",hex4 (56320+code%1024)])))
def jsonFloat (x : Float) : String :=
 if x.isNaN then "NaN" else if x.isInf then if x<0 then "-Infinity" else "Infinity" else FloatText.repr x

def objectText (indent : Nat) (fields : List (String × String)) : String :=
 if fields.isEmpty then "{}" else
  let pad := String.ofList (List.replicate (indent+2) ' ')
  join ["{\n",intercalate ",\n" (fields.map (fun (k,v) => join [pad,quote k,": ",v])),"\n",String.ofList (List.replicate indent ' '),"}"]
def arrayText (indent : Nat) (values : List String) : String :=
 if values.isEmpty then "[]" else
  let pad := String.ofList (List.replicate (indent+2) ' ')
  join ["[\n",intercalate ",\n" (values.map (append pad)),"\n",String.ofList (List.replicate indent ' '),"]"]

def physicsJson (a : PhysicsAlignment) : String := objectText 4 [
 ("name",quote a.name),("sector",number a.sector),("calculated",jsonFloat a.calculated),("measured",jsonFloat a.measured),("deviation_pct",jsonFloat a.deviationPct)]
def rawData (group : List Fraction) (sector : Int) (eigenvalues : List Float) (proof : AnalyticalProof) (physical : List PhysicsAlignment) : String :=
 objectText 0 [
 ("sector_m",number sector),("coordinate_count",n group.length),
 ("coordinates",arrayText 2 ((sortFractions group).map (fun x => quote (fractionText x)))),
 ("eigenvalues",arrayText 2 (eigenvalues.map jsonFloat)),
 ("invariants",objectText 2 ((AcademicReport.invariantDescriptions.zip (AcademicReport.flags proof)).map (fun ((k,_,_),passed) => (k,quote (if passed then "PASS" else "FAIL"))))),
 ("physical_alignments",arrayText 2 (physical.map physicsJson))]
def prompt (sector : Int) (raw : String) : String := join ["Analyze the following raw discovery data for Sector m = ",number sector,":\n",raw,"\n\nPlease write a comprehensive, non-heuristic academic report for this sector. Structure your response with:\n1. **Algebraic Structure Analysis**: Explain the coordinate orbit under the dyadic map, focusing on how the coordinates form a closed discrete algebra under folding.\n2. **Invariant Proof Interpretation**: Explain the physical meaning of the T1-T12 checks and why this sector passed or failed specific ones in the context of the theory. Strictly avoid standard continuum physics justifications; explain it in terms of coordinate confinement, discrete preimages, and symmetry balance.\n3. **Eigenvalue Spectrum & Observable Correspondence**: Explain how the eigenvalues relate to the physical masses (especially if there are matches like Lepton or Boson mass ratios) purely as balance points of the sector polynomial.\nKeep the tone strictly scientific, professional, and dense with physical insight, adhering 100% to the discrete fold axioms."]

structure Target where
 group : List Fraction
 sector : Int
 eigenvalues : List Float
 physical : List PhysicsAlignment

def targetGroups (particles : ParticleQueries) (limit : Nat) (limitToMatches : Bool) : Except String (List Target) := do
 let scan := USDESweep.candidateGroups limit false
 scan.groups.foldlM (fun out group => do
  match group with
  | [] => .error "list index out of range"
  | first::_ =>
   let sector := first.denominator+1
   let eigenvalues ← solveEigenvalues sector
   let physical := (crossReferencePhysics particles sector eigenvalues).alignments
   return if !limitToMatches || !physical.isEmpty then out++[{group := group,sector := sector,eigenvalues := eigenvalues,physical := physical}] else out) []
def cacheKey (target : Target) : String :=
 join ["sector_",number target.sector,"_coords_",intercalate "_" ((sortFractions target.group).map (fun x => join [number x.numerator,"-",number x.denominator]))]
def eigenvaluesText (values : List Float) : String := join ["[",intercalate ", " (values.map FloatText.repr),"]"]
def reportSection (target : Target) (analysis : String) : List String := [
 join ["## Sector m = ",number target.sector," Analysis"],"### Raw Data Summary",
 join ["- **Coordinates**: `",intercalate ", " ((sortFractions target.group).map fractionText),"`"],
 join ["- **Eigenvalues**: `",eigenvaluesText target.eigenvalues,"`"],"","### LLM Physical Inference & Proof Explanation",analysis,"\n---\n"]

def generate (particles : ParticleQueries) (limit : Nat) (model outputPath masterText time : String)
 (limitToMatches : Bool := true) (transport : Transport := request)
 (sleep : IO Unit := IO.sleep 2000) : IO Nat := do
 let targets ← lift (targetGroups particles limit limitToMatches)
 let directory := reportDirectory outputPath
 IO.FS.createDirAll directory
 let cachePath := directory / "usde_inference_cache.json"
 let cache ← IO.mkRef (← readCache cachePath)
 let mut lines := ["# Smithian Fold Theory — LLM Inference Discovery Atlas",append "Generated at: " time,join ["Ollama Model: `",model,"`"],append "Sweep Limit Depth N: " (n limit),"","## Executive Summary","This document contains physical and mathematical explanations of coordinate sectors and physical matches, generated using a local deep neural network. The network was system-prompted with the complete mathematical and physical axiomatic structure of the Smithian Fold Theory of Everything (SFTOE).","","---",""]
 line (join ["Generating LLM inference reports for ",n targets.length," sectors using model '",model,"'..."])
 for target in targets do
  let proof := runAutoProof target.group target.sector
  let key := cacheKey target
  let analysis ← IO.mkRef ""
  match (← cache.get).getObjVal? key with
  | .ok value =>
   match value with
   | .null => pure ()
   | _ => analysis.set (← lift value.getStr?)
   line (join ["  Loaded analysis for Sector m=",number target.sector," from cache."])
  | .error _ =>
   let data := rawData target.group target.sector target.eigenvalues proof target.physical
   let body := payload model (prompt target.sector data) (systemPrompt masterText)
   for attempt in [1,2,3] do
    try
     let response ← transport body
     if response.getObjValD "done" == .bool true then
      let value := response.getObjValD "response"
      match value with
      | .null => analysis.set ""
      | _ => analysis.set (← lift value.getStr?)
      if nonblank (← analysis.get) then
       cache.set (← lift (cacheSet (← cache.get) key (.str (← analysis.get))))
       IO.FS.writeFile cachePath (← cache.get).pretty
       break
     throw (IO.userError "Ollama response incomplete or truncated.")
    catch e =>
     line (join ["  Attempt ",n attempt," for Sector m=",number target.sector," failed: ",e.toString])
     if attempt<3 then sleep
  if nonempty (← analysis.get) then
   lines := lines++reportSection target (← analysis.get)
   line (join ["  Completed analysis for Sector m=",number target.sector,"."])
  else throw (IO.userError (join ["Failed to generate analysis for Sector m=",number target.sector," after 3 attempts."]))
 IO.FS.writeFile outputPath (intercalate "\n" lines)
 line (append "LLM Inference Report saved to: " outputPath)
 return targets.length

def generateInferenceReport (particles : ParticleQueries) (limit : Nat) (model : String)
 (masterPath : System.FilePath) (outputPath : String := "usde_reports/discovery_atlas_inference.md")
 (limitToMatches : Bool := true) : IO Nat := do
 let master ← readMaster masterPath
 let time ← timestamp
 generate particles limit model outputPath master time limitToMatches
end SFT.Applications.Discovery.InferenceSector
