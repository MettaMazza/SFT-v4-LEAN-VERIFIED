import SFT.Physics.SpatialStability
import SFT.Foundation.CommonRefinement
namespace SFT.Physics.SpatialThreeGrammar
open SFT.Foundation
set_option maxRecDepth 20000

inductive Carrier where
  | rejected | admitted

def carrierName : Carrier → String
  | .rejected => "coordinate-name-only"
  | .admitted => "independent-generated-direction-carrier"

inductive Lower where
  | rejected | admitted

def lowerName : Lower → String
  | .rejected => "one-or-collapsed-fibre-count"
  | .admitted => "strictly-beyond-two-Fold-fibres"

inductive Upper where
  | rejected | admitted

def upperName : Upper → String
  | .rejected => "unbounded-coordinate-extension"
  | .admitted => "strictly-within-four-pair-cells"

inductive Interval where
  | rejected | admitted

def intervalName : Interval → String
  | .rejected => "closed-or-one-sided-window"
  | .admitted => "open-Fold-stability-window"

inductive Census where
  | rejected | admitted

def censusName : Census → String
  | .rejected => "selected-dimension"
  | .admitted => "complete-positive-count-enumeration"

inductive Value where
  | rejected0 | admitted | rejected2 | rejected3

def valueName : Value → String
  | .rejected0 => "two-directions"
  | .admitted => "three-directions"
  | .rejected2 => "four-directions"
  | .rejected3 => "target-selected-directions"

inductive Crosslock where
  | rejected | admitted

def crosslockName : Crosslock → String
  | .rejected => "no-independent-lock"
  | .admitted => "equals-generator-three"

inductive Measurement where
  | rejected | admitted

def measurementName : Measurement → String
  | .rejected => "space-count-read-from-measurement"
  | .admitted => "forced-count-then-observed"

inductive Extension where
  | rejected | admitted

def extensionName : Extension → String
  | .rejected => "extra-dimensional-model"
  | .admitted => "no-extra-rule"

structure Candidate where
  carrier : Carrier
  lower : Lower
  upper : Upper
  interval : Interval
  census : Census
  value : Value
  crosslock : Crosslock
  measurement : Measurement
  extension : Extension

def sourceFields (c : Candidate) : List String := [carrierName c.carrier, lowerName c.lower, upperName c.upper, intervalName c.interval, censusName c.census, valueName c.value, crosslockName c.crosslock, measurementName c.measurement, extensionName c.extension]

def candidateId (c : Candidate) : String := SFT.Host.Text.intercalate "__" (sourceFields c)
def exactForm (c : Candidate) : String := SFT.Host.Text.intercalate "; " [SFT.Host.Text.append "carrier=" (carrierName c.carrier), SFT.Host.Text.append "lower=" (lowerName c.lower), SFT.Host.Text.append "upper=" (upperName c.upper), SFT.Host.Text.append "interval=" (intervalName c.interval), SFT.Host.Text.append "census=" (censusName c.census), SFT.Host.Text.append "value=" (valueName c.value), SFT.Host.Text.append "crosslock=" (crosslockName c.crosslock), SFT.Host.Text.append "measurement=" (measurementName c.measurement), SFT.Host.Text.append "extension=" (extensionName c.extension)]
def survivorId : String := "independent-generated-direction-carrier__strictly-beyond-two-Fold-fibres__strictly-within-four-pair-cells__open-Fold-stability-window__complete-positive-count-enumeration__three-directions__equals-generator-three__forced-count-then-observed__no-extra-rule"
def survives (c : Candidate) : Bool := SFT.Host.Text.equal (candidateId c) survivorId
def criteriaDecision (c : Candidate) : Bool :=
  SFT.Host.Text.equal (carrierName c.carrier) "independent-generated-direction-carrier" &&
  SFT.Host.Text.equal (lowerName c.lower) "strictly-beyond-two-Fold-fibres" &&
  SFT.Host.Text.equal (upperName c.upper) "strictly-within-four-pair-cells" &&
  SFT.Host.Text.equal (intervalName c.interval) "open-Fold-stability-window" &&
  SFT.Host.Text.equal (censusName c.census) "complete-positive-count-enumeration" &&
  SFT.Host.Text.equal (valueName c.value) "three-directions" &&
  SFT.Host.Text.equal (crosslockName c.crosslock) "equals-generator-three" &&
  SFT.Host.Text.equal (measurementName c.measurement) "forced-count-then-observed" &&
  SFT.Host.Text.equal (extensionName c.extension) "no-extra-rule"

def decisionReason (c : Candidate) : String :=
  if SFT.Host.Text.equal (carrierName c.carrier) "coordinate-name-only" then "A coordinate name has no independence or incidence trace." else
  if SFT.Host.Text.equal (lowerName c.lower) "one-or-collapsed-fibre-count" then "At or below the fibre count the common return is identified with a fibre role." else
  if SFT.Host.Text.equal (upperName c.upper) "unbounded-coordinate-extension" then "An unbounded extension adds roles not generated by one Fold closure." else
  if SFT.Host.Text.equal (intervalName c.interval) "closed-or-one-sided-window" then "Including two collapses return; including four exhausts the restoring remainder." else
  if SFT.Host.Text.equal (censusName c.census) "selected-dimension" then "Selecting a familiar dimension is not forcing." else
  if SFT.Host.Text.equal (valueName c.value) "two-directions" then "Two does not remain beyond both Fold fibres." else
  if SFT.Host.Text.equal (valueName c.value) "four-directions" then "Four saturates the pair-cell boundary." else
  if SFT.Host.Text.equal (valueName c.value) "target-selected-directions" then "A measured spatial target cannot enter derivation." else
  if SFT.Host.Text.equal (crosslockName c.crosslock) "no-independent-lock" then "A single route cannot expose a changed stability bound." else
  if SFT.Host.Text.equal (measurementName c.measurement) "space-count-read-from-measurement" then "Measurement cannot select the spatial law." else
  if SFT.Host.Text.equal (extensionName c.extension) "extra-dimensional-model" then "An added manifold or conventional dimension rule supplies the answer." else
  "The unique Fold-stable spatial dimension count is three, independently equal to generator three."

def generationRule : String := "Generate every spatial stability form over carrier, fibre lower bound, pair-cell upper bound, interval status, positive-count census, spatial count, generator cross-lock, measurement direction and extra rule."
def grammarBoundary : String := "All positive finite independent-direction counts classified by the Fold fibre lower boundary, ordered pair-cell closure boundary, return stability and generator-three cross-lock."

def candidates : List Candidate :=
  ([Carrier.rejected,Carrier.admitted]).flatMap fun carrier =>
  ([Lower.rejected,Lower.admitted]).flatMap fun lower =>
  ([Upper.rejected,Upper.admitted]).flatMap fun upper =>
  ([Interval.rejected,Interval.admitted]).flatMap fun interval =>
  ([Census.rejected,Census.admitted]).flatMap fun census =>
  ([Value.rejected0,Value.admitted,Value.rejected2,Value.rejected3]).flatMap fun value =>
  ([Crosslock.rejected,Crosslock.admitted]).flatMap fun crosslock =>
  ([Measurement.rejected,Measurement.admitted]).flatMap fun measurement =>
  ([Extension.rejected,Extension.admitted]).map fun extension =>
  ⟨carrier,lower,upper,interval,census,value,crosslock,measurement,extension⟩

def survivor : Candidate := ⟨.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted⟩

theorem generatedCardinality : candidates.length = 1024 := rfl

theorem candidatesComplete (c : Candidate) : c ∈ candidates := by
  cases c with
  | mk carrier lower upper interval census value crosslock measurement extension =>
    have hcarrier : carrier ∈ [Carrier.rejected,Carrier.admitted] := by
      cases carrier <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hlower : lower ∈ [Lower.rejected,Lower.admitted] := by
      cases lower <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hupper : upper ∈ [Upper.rejected,Upper.admitted] := by
      cases upper <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hinterval : interval ∈ [Interval.rejected,Interval.admitted] := by
      cases interval <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hcensus : census ∈ [Census.rejected,Census.admitted] := by
      cases census <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hvalue : value ∈ [Value.rejected0,Value.admitted,Value.rejected2,Value.rejected3] := by
      cases value <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hcrosslock : crosslock ∈ [Crosslock.rejected,Crosslock.admitted] := by
      cases crosslock <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hmeasurement : measurement ∈ [Measurement.rejected,Measurement.admitted] := by
      cases measurement <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hextension : extension ∈ [Extension.rejected,Extension.admitted] := by
      cases extension <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    unfold candidates
    apply CommonRefinement.memFlatMap _ _ carrier _ hcarrier
    apply CommonRefinement.memFlatMap _ _ lower _ hlower
    apply CommonRefinement.memFlatMap _ _ upper _ hupper
    apply CommonRefinement.memFlatMap _ _ interval _ hinterval
    apply CommonRefinement.memFlatMap _ _ census _ hcensus
    apply CommonRefinement.memFlatMap _ _ value _ hvalue
    apply CommonRefinement.memFlatMap _ _ crosslock _ hcrosslock
    apply CommonRefinement.memFlatMap _ _ measurement _ hmeasurement
    exact Count.TraceDerivation.memMap _ extension _ hextension

set_option maxHeartbeats 20000000 in
theorem sourceDecisionMatchesCriteria (c : Candidate) : survives c = criteriaDecision c := by
  cases c with
  | mk carrier lower upper interval census value crosslock measurement extension =>
    cases carrier <;> cases lower <;> cases upper <;> cases interval <;> cases census <;> cases value <;> cases crosslock <;> cases measurement <;> cases extension
    all_goals rfl

set_option maxHeartbeats 10000000 in
theorem uniqueCriteriaSurvivor (c : Candidate) : criteriaDecision c = true ↔ c = survivor := by
  cases c with
  | mk carrier lower upper interval census value crosslock measurement extension =>
    cases carrier <;> cases lower <;> cases upper <;> cases interval <;> cases census <;> cases value <;> cases crosslock <;> cases measurement <;> cases extension
    all_goals constructor <;> intro h <;> first | rfl | cases h

theorem uniqueSurvivor (c : Candidate) : survives c = true ↔ c = survivor := by
  rw [sourceDecisionMatchesCriteria]
  exact uniqueCriteriaSurvivor c

theorem survivorAccepted : survives survivor = true := rfl

def ExactCriteria (c : Candidate) : Prop :=
  c.carrier = .admitted ∧ c.lower = .admitted ∧ c.upper = .admitted ∧ c.interval = .admitted ∧ c.census = .admitted ∧ c.value = .admitted ∧ c.crosslock = .admitted ∧ c.measurement = .admitted ∧ c.extension = .admitted

theorem acceptanceIffExactCriteria (c : Candidate) : survives c = true ↔ ExactCriteria c := by
  constructor
  · intro h
    have eq := (uniqueSurvivor c).mp h
    cases eq
    exact ⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
  · intro h
    cases c with
    | mk carrier lower upper interval census value crosslock measurement extension =>
      obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7,h8⟩ := h
      cases h0; cases h1; cases h2; cases h3; cases h4; cases h5; cases h6; cases h7; cases h8
      rfl

theorem carrier_rejected_rejected (c : Candidate) (h : c.carrier = .rejected) : survives c = false := by
  cases hs : survives c with
  | false => rfl
  | true =>
    have eq := (uniqueSurvivor c).mp hs
    have field := congrArg Candidate.carrier eq
    rw [h] at field
    cases field

