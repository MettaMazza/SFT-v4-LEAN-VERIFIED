import SFT.Host.Text
namespace SFT.Biology.Physiology
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-PHYSIOLOGY-001","Physiological process","organism_physiology","organ-system-state-carrier","coordinated-function-transition","parts-flows-controls-and-time-held","organism-condition-bounded","Physiology is the complete coordinated transition record by which organismal parts maintain or change a biological function under declared conditions."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.Physiology
