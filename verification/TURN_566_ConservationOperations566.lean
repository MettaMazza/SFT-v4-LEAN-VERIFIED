import SFT.Chemistry.ReactionTotals
open SFT.Chemistry.ReactionTotals SFT.Host.Canonical
def dict (rows : List (String × Nat)) : Value := .object (rows.map fun x => (x.1,.integer (Int.ofNat x.2)))
def run (rows : List (Except String Species)) : Value :=
 match rows.mapM id with
 | .error e => .object [("error",.text e)]
 | .ok word => .object [("balanced",.boolean (reactionIsBalanced word)),("reactant",dict (sideTotals word "reactant")),("product",dict (sideTotals word "product")),("unknown",dict (sideTotals word "other"))]
def main : IO Unit := do
 IO.println (render (run []))
 IO.println (render (run [((([makeElement "A" 1 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "AB" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "AB" 1 (by decide) elements)),((([makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "A" 1 (by decide) elements)),((([makeElement "A" 2 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "product" "A2B" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "AB" 1 (by decide) elements)),((([makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "A" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "AB" 1 (by decide) elements)),((([makeElement "A" 2 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "product" "A2B" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "X" 2 (by decide) elements)),((([makeElement "A" 2 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "product" "Y" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "X" 1 (by decide) elements)),((([makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "product" "Y" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "B" 1 (by decide),makeElement "A" 2 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "product" "Y" 1 (by decide) elements)),((([makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "A" 1 (by decide) elements)),((([makeElement "A" 1 (by decide),makeElement "B" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "AB" 1 (by decide) elements))]))
 IO.println (render (run [((([makeElement "A" 1 (by decide),makeElement "A" 1 (by decide)] : List (Except String Element)).mapM id).bind (fun elements => makeSpecies "reaction-side" "reactant" "x" 1 (by decide) elements))]))
