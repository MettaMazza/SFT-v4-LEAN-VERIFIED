def emit (tag : String) (state : Board) (full : Bool) : IO Unit := do
 for side in ([0,1] : List Int) do
  IO.println (tag ++ s!" map {side} " ++ String.intercalate "," ((attackMinReachMap state side).toList.map toString))
  if full then
   for sq in List.range 65 do
    for threshold in ([0,2,8,14,27] : List Int) do
     IO.println s!"{tag} lesser {side} {sq} {threshold} {if lesserAttackerExists state (Int.ofNat sq) threshold side then 1 else 0}"
