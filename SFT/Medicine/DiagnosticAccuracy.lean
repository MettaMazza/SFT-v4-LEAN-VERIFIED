import SFT.Host.Text
import SFT.Medicine.StructuralCounts
namespace SFT.Medicine.DiagnosticAccuracy
structure Obligation where
 claimId : String
 title : String
 family : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-MED-DIAGNOSTIC-ACCURACY-001","Diagnostic accuracy","symptom_sign_measurement_diagnosis","paired-index-and-reference-results","agreement-disagreement-incidence","complete-two-by-two-observation-table","target-population-spectrum-and-verification","Diagnostic accuracy requires all four cells generated by held condition and test-result distinctions plus population spectrum, reference method and verification record."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
def diagnosticTableWitness : Bool := StructuralCounts.diagnosticTableCertificate.complete && StructuralCounts.diagnosticTableCertificate.cellCount == 4
theorem diagnosticTableWitnessPassed : diagnosticTableWitness = true := rfl
end SFT.Medicine.DiagnosticAccuracy
