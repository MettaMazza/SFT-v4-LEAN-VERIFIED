def claimCount : Nat := 74
private def objectEntries : Value → Except String (List (String × Value))
 | .object xs => .ok xs
 | .null | .text _ | .boolean _ | .integer _ | .array _ => .error "source object expected"
private def arrayEntries : Value → Except String (List Value)
 | .array xs => .ok xs
 | .null | .text _ | .boolean _ | .integer _ | .object _ => .error "source array expected"
private def required (payload : Value) (key : String) : Except String Value :=
 if hasField payload key then .ok (field payload key)
 else .error (Text.append "KeyError: " key)
private def number : Value → Except String Int
 | .integer n => .ok n
 | .boolean b => .ok (if b then 1 else 0)
 | .null | .text _ | .array _ | .object _ => .error "source count expected"
private def isTrue : Value → Bool
 | .boolean b => b
 | .null | .text _ | .integer _ | .array _ | .object _ => false
private def truthy : Value → Bool
 | .null => false
 | .boolean b => b
 | .integer n => !(Text.equal (render (.integer n)) "0")
 | .text s => !(Text.equal s "")
 | .array xs => !xs.isEmpty
 | .object xs => !xs.isEmpty

def verifiedPayload (payload : Value) (key relative : String) : Except String Value := do
 let claimed ← required payload key
 let entries ← objectEntries payload
 let content := Value.object (entries.filter (fun x => !Text.equal x.1 key))
 if !Text.equal (identity content) (string claimed) then
  throw (Text.append "Earth evidence identity mismatch: " relative)
 return payload

def validatePreSourceSeal (payload : Value) (files : List Snapshot) : Except String String := do
 let claimed ← required payload "complete_branch_pre_source_seal_hash"
 let entries ← objectEntries payload
 let content := Value.object (entries.filter (fun x => !Text.equal x.1 "complete_branch_pre_source_seal_hash"))
 if !Text.equal (identity content) (string claimed) then throw "Earth pre-source seal payload changed"
 if !(isFalse (field payload "external_source_identities_selected")) ||
    !(isFalse (field payload "external_source_content_opened")) ||
    !(isFalse (field payload "external_outcomes_opened")) then
  throw "Earth derivation was not sealed before source selection"
 if !(integerEqual (field payload "required_claim_count") claimCount) ||
    !(integerEqual (field payload "candidate_count") (claimCount*256)) then
  throw "Earth pre-source census changed"
 if !Text.equal (string (field payload "claim_prediction_set_hash")) (identity predictionSet) then
  throw "Earth sealed prediction set changed"
 let sealed ← required payload "sealed_files" >>= objectEntries
 let _ ← sealed.mapM fun (path,wanted) => do
  let bytes ← readSnapshot files path
  if !Text.equal (bytesHash bytes) (string wanted) then
   throw (Text.append "Earth pre-source file changed: " path)
  pure ()
 return string claimed

def validateExternalEvidence (audit targets bindings first holdout : Value)
 (files : List Snapshot) : Except String (Value × Value × Value) := do
 let audit ← verifiedPayload audit "audit_hash" "experiments/earth_environment/source_feature_audit.json"
 let targets ← verifiedPayload targets "targets_hash" "experiments/earth_environment/claim_specific_external_targets.json"
 let bindings ← verifiedPayload bindings "bindings_hash" "experiments/earth_environment/claim_source_bindings.json"
 let targetAudit ← required targets "source_feature_audit_hash"
 let auditHash ← required audit "audit_hash"
 let targetBindings ← required targets "bindings_hash"
 let bindingsHash ← required bindings "bindings_hash"
 if !Text.equal (render targetAudit) (render auditHash) || !Text.equal (render targetBindings) (render bindingsHash) then
  throw "Earth target record binds different evidence"
 let total ← required targets "claim_count"
 let passed ← required targets "passed_claim_count"
 let unresolved ← required targets "unresolved_claim_count"
 if !(integerEqual total claimCount) || !(integerEqual passed claimCount) || !(integerEqual unresolved 0) then
  throw "Earth external target record is incomplete"
 let present ← required audit "present_feature_count" >>= number
 let absent ← required audit "absent_feature_count" >>= number
 let registered ← required audit "registered_feature_count" >>= number
 if !Text.equal (render (.integer (Int.add present absent))) (render (.integer registered)) then
  throw "Earth source-feature accounting is incomplete"
 let failedPreserved ← required audit "failed_transports_preserved"
 let adversePreserved ← required targets "all_adverse_absent_and_failed_rows_preserved"
 if !(truthy failedPreserved) || !(truthy adversePreserved) then
  throw "Earth adverse evidence was not preserved"
 let sources ← required audit "sources" >>= arrayEntries
 let _ ← sources.mapM fun source => do
  let transports ← required source "transport_history" >>= arrayEntries
  let _ ← transports.mapM fun transport => do
   let path := field transport "snapshot_path"
   let wanted := field transport "snapshot_hash"
   if truthy path && truthy wanted then
    let bytes ← readSnapshot files (string path)
    if !Text.equal (bytesHash bytes) (string wanted) then
     throw (Text.append "Earth source snapshot changed: " (string path))
   pure ()
  pure ()
 let first ← verifiedPayload first "result_hash" "experiments/earth_environment/quake_magnitude_frequency_result.json"
 let holdout ← verifiedPayload holdout "result_hash" "experiments/earth_environment/quake_magnitude_frequency_holdout_result_v2.json"
 let rows ← required targets "targets" >>= arrayEntries
 let quake ← match rows.find? (fun row => Text.equal (string (field row "claim_id")) "SFT-EARTH-QUAKE-MAGNITUDE-FREQUENCY-001") with
  | none => throw "StopIteration"
  | some row => pure row
 let numeric ← required quake "numeric_comparison"
 let firstPassed ← required first "passed"
 let holdoutPassed ← required holdout "passed"
 let reclassified ← required numeric "first_adverse_result_reclassified"
 if !(isFalse firstPassed) || !(isTrue holdoutPassed) || !(isFalse reclassified) then
  throw "Earth earthquake adverse/holdout disposition changed"
 let firstRecord ← required numeric "first_mixed_catalog_result"
 let firstRecordedHash ← required firstRecord "result_hash"
 let firstHash ← required first "result_hash"
 let holdoutRecord ← required numeric "independent_homogeneous_holdout"
 let holdoutRecordedHash ← required holdoutRecord "result_hash"
 let holdoutHash ← required holdout "result_hash"
 if !Text.equal (render firstRecordedHash) (render firstHash) ||
    !Text.equal (render holdoutRecordedHash) (render holdoutHash) then
  throw "Earth earthquake result identity changed"
 return (audit,targets,bindings)

def targetRow (claimId targetId expectedLabel : String) (audit targets bindings first holdout : Value)
 (files : List Snapshot) : Except String (Value × String) := do
 let (audit,targets,bindings) ← validateExternalEvidence audit targets bindings first holdout files
 let rows ← required targets "targets" >>= arrayEntries
 let row ← match rows.find? (fun row => Text.equal (string (field row "claim_id")) claimId) with
  | none => throw "StopIteration"
  | some row => pure row
 let actualTarget ← required row "target_id"
 let expected ← required row "expected_label"
 if !Text.equal (string actualTarget) targetId || !Text.equal (string expected) expectedLabel then
  throw "Earth target binding changed"
 let observed ← required row "observed_label"
 let matched ← required row "exact_match"
 if !Text.equal (render observed) (render expected) || !(isTrue matched) then
  throw "Earth external boundary consequence is unresolved"
 let selected ← required row "external_evidence_selected_survivor"
 if !(isFalse selected) then throw "Earth evidence selected the structural survivor"
 let direct ← required row "formal_structure_relabelled_as_direct_measurement"
 let forecast ← required row "model_or_forecast_relabelled_as_observation"
 if !(isFalse direct) || !(isFalse forecast) then throw "Earth evidence classes were conflated"
 return (row,identity (.array [field audit "audit_hash",field targets "targets_hash",field bindings "bindings_hash",row]))
end SFT.EarthEnvironment.Source
