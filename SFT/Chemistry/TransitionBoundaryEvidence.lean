def claimId : String := "SFT-CHEM-TRANSITION-STATE-EQUIVALENT-BOUNDARY-005"
def dependencies : List String := ["SFT-FOUNDATION-FORM-ENFORCEMENT-001","SFT-FOUNDATION-MEASURED-VALUE-BOUNDARY-001","SFT-MATH-EXACT-ARITHMETIC-001","SFT-MATH-DISCRETE-001","SFT-MATH-COMBINATORICS-001","SFT-MATH-GRAPH-NETWORK-001","SFT-MATH-ORDER-LATTICE-001","SFT-INFO-CONSERVATION-LOSS-001","SFT-COMP-FORM-STATE-TRANSITION-001","SFT-COMP-CPLX-TIME-SPACE-001","SFT-CHEM-RXN-IDENTITY-001","SFT-CHEM-RXN-MECHANISM-001","SFT-CHEM-KIN-ACTIVATION-001","SFT-CHEM-CONFIGURATION-ORDER-PATH-011","SFT-CHEM-STATE-ENERGY-ORDER-004","SFT-CHEM-ELEMENTARY-TRANSITION-RATE-001","SFT-CHEM-CONCENTRATION-DEPENDENCE-RELATION-002","SFT-CHEM-TEMPERATURE-DEPENDENCE-RELATION-003","SFT-CHEM-ACTIVATION-BARRIER-VALUE-RELATION-004"]
def candidateRecord (c : Candidate) : Value := .object [("candidate_id",.text (candidateId c)),("coordinates",.array [.array [.text "carrier",.text (carrierName c.carrier)],.array [.text "identity",.text (identityName c.identity)],.array [.text "location",.text (locationName c.location)],.array [.text "partition",.text (partitionName c.partition)],.array [.text "orientation",.text (orientationName c.orientation)],.array [.text "observation",.text (observationName c.observation)],.array [.text "provenance",.text (provenanceName c.provenance)],.array [.text "prediction",.text (predictionName c.prediction)]]),("exact_form",.text (exactForm c))]
def completenessRecord : Value := .object [("claim_id",.text claimId),("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),("dimensions",.array [.array [.text "carrier",.array [.array [.text "saddle-point-or-continuum-transition-state-premise",.text "A named continuum saddle imports geometry not generated by the Fold path."],.array [.text "finite-generated-path-boundary-carrier",.text "The complete finite path forces its boundary carrier without a continuum premise."]]],.array [.text "identity",.array [.array [.text "isotopologue-or-reaction-identity-collapsed",.text "Collapsed identities cannot preserve isotope-dependent observations."],.array [.text "held-reaction-path-and-isotopologue-identities",.text "Reaction, path and isotopologue remain held through the boundary."]]],.array [.text "location",.array [.array [.text "arbitrary-named-state-or-fitted-coordinate",.text "A selected state or fitted coordinate could choose the boundary."],.array [.text "unique-greatest-exact-positive-path-support",.text "Exact order and uniqueness force one boundary state."]]],.array [.text "partition",.array [.array [.text "endpoint-only-or-boundary-answer-only",.text "Endpoints alone erase the states adjacent to crossing."],.array [.text "complete-entry-boundary-exit-partition",.text "Every state is retained exactly before, at or after the boundary."]]],.array [.text "orientation",.array [.array [.text "signed-or-negative-proof-scalar",.text "A signed scalar imports a prohibited negative number."],.array [.text "positive-magnitude-plus-held-orientation",.text "Magnitude remains positive while direction is a held structural label."]]],.array [.text "observation",.array [.array [.text "single-favorable-isotope-or-barrier-only",.text "Selecting one isotope erases the measured contrast."],.array [.text "complete-H2-D2-signature-uncertainty-and-adverse-record",.text "Both measured isotope directions, magnitudes, uncertainties and disclosures remain held."]]],.array [.text "provenance",.array [.array [.text "experimental-calculated-fitted-records-mixed",.text "Mixing provenance can promote a fitted calculation to measurement."],.array [.text "experimental-targets-separated-from-calculated-and-fitted-records",.text "Experimental targets and calculated/fitted disclosures are retained but never conflated."]]],.array [.text "prediction",.array [.array [.text "conventional-KIE-equation-target-access-or-refit",.text "A conventional equation, target access or refit can select the outcome."],.array [.text "value-free-complete-isotopologue-identity-seal-and-depth-independent-append",.text "All target identities seal before values open; appending a complete path preserves prior boundaries."]]]]),("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),("exhaustion",.text "The literal product contains each registered form combination exactly once.")]
def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
 claimId := claimId
 title := "Finite transition-state-equivalent Fold path-boundary law"
 branch := "chemistry"
 statement := "A complete generated finite reaction path with held reaction, path and isotopologue identities and one unique greatest exact positive support forces a transition-state-equivalent boundary carrier as the exact entry, boundary and exit partition. External signed barrier inscriptions remain provenance only and translate to positive magnitude plus held orientation; no saddle-point continuum or conventional kinetic-isotope equation enters the law."
 evidenceMode := .empirical
 rootTheorems := [SFT.Engine.rootTheoremId]
 dependencies := dependencies
 axioms := []
 freeParameters := []
 provenance := [.observationalDerivation]
 sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)
def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
 candidateId := candidateId c
 exactForm := exactForm c
 traceHash := identity (.array [.text claimId,candidateRecord c])
def censusData : SFT.Engine.CandidateCensus where
 generationRule := generationRule
 grammarBoundary := grammarBoundary
 expectedCardinality := .ofNat candidates.length
 completenessCertificateHash := identity completenessRecord
 candidates := candidates.map generatedCandidateData
def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
 candidateId := candidateId c
 survives := survives c
 reason := decisionReason c
 proofHash := identity (.array [.text claimId,.array (dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
 | some c => .ok (decisionData c)
 | none => .error "StopIteration"
def closureValue : Value := .object [("claim_id",.text claimId),("result",.text "finite-generated-path-boundary-carrier__held-reaction-path-and-isotopologue-identities__unique-greatest-exact-positive-path-support__complete-entry-boundary-exit-partition__positive-magnitude-plus-held-orientation__complete-H2-D2-signature-uncertainty-and-adverse-record__experimental-targets-separated-from-calculated-and-fitted-records__value-free-complete-isotopologue-identity-seal-and-depth-independent-append"),("base",.text "One complete finite path with one unique greatest exact positive state forces one entry-boundary-exit carrier."),("successor",.text "Appending one complete source-bound path preserves every prior path, boundary, isotope identity, measurement and adverse provenance record without reselection, fitting or correction."),("exclusions",.array [.text "no numerical zero; structural absence is EmptyOne and external zero glyphs remain provenance only",.text "no negative, irrational, imaginary, logarithmic, floating, signed or continuum SFT proof value",.text "no imported transition-state geometry, saddle-point continuum, conventional KIE equation or Arrhenius law",.text "no fitted barrier, prefactor, model adjustment, selected isotope/surface/condition/row or target-derived correction",.text "no isotope direction, barrier, uncertainty, temperature, exposure, coverage, curve or target hash before prediction seal",.text "calculated, path-integral, DFT and KMC records remain disclosed post-seal provenance and never measurement targets"]),("witnesses",witnesses),("survivor",.text survivorId)]
def exclusions : List String := ["no numerical zero; structural absence is EmptyOne and external zero glyphs remain provenance only","no negative, irrational, imaginary, logarithmic, floating, signed or continuum SFT proof value","no imported transition-state geometry, saddle-point continuum, conventional KIE equation or Arrhenius law","no fitted barrier, prefactor, model adjustment, selected isotope/surface/condition/row or target-derived correction","no isotope direction, barrier, uncertainty, temperature, exposure, coverage, curve or target hash before prediction seal","calculated, path-integral, DFT and KMC records remain disclosed post-seal provenance and never measurement targets"]
def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
 scope := .depthIndependent
 exactBoundary := grammarBoundary
 minimalityPassed := true
 namedShapeUniquenessPassed := true
 proofHash := identity (.array [closureValue,.array (decisions.map SFT.Engine.decisionValue)])
 generalityCertificateHash := some (identity closureValue)
def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

def control (kind : SFT.Engine.ControlKind) (passed : Bool) (observation : String) : SFT.Engine.ControlResult where
 kind := kind
 passed := passed
 expectedBehavior := observation
 observedBehavior := if passed then observation else "control failed"
 receiptHash := identity (.array [.text claimId,.text (SFT.Engine.kindName kind),.boolean passed,.text observation])
def runControls (sourceHash : String) : Value := .array ([
 control .falsePremise (!(SFT.Host.Text.equal (candidateId {survivor with carrier := .rejected}) survivorId)) "reject the generated form lacking the complete physical carrier",
 control .tamperedSource (!(SFT.Host.Text.equal (identity (.object [("changed",.text sourceHash)])) sourceHash)) "reject a changed registered source identity",
 control .tamperedArtifact ((candidates.filter survives).length == 1) "reject a missing, duplicate or additional survivor",
 control .boundary (!exclusions.isEmpty) "reject target access, forbidden proof values, imported laws and free parameters"].map SFT.Engine.controlResultValue)

theorem registrationNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl
theorem registrationNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl
theorem decisionSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl
end SFT.Chemistry.TransitionBoundaryEvidence
