def alphabetEq (a b : Except String (List Symbol)) : Bool := match a,b with
 | .ok x,.ok y => decide (x = y)
 | .error x,.error y => decide (x = y)
 | _,_ => false
def labelEq (a b : Except String (String)) : Bool := match a,b with
 | .ok x,.ok y => decide (x = y)
 | .error x,.error y => decide (x = y)
 | _,_ => false
def boolEq (a b : Except String (Bool)) : Bool := match a,b with
 | .ok x,.ok y => decide (x = y)
 | .error x,.error y => decide (x = y)
 | _,_ => false
