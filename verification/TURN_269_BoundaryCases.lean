def main : IO Unit := do
 for (n,d,k,expectedN,expectedD) in cases do
  if hn : 0 < n then
   if hd : 0 < d then
    let value := normalizePositive n d hn hd
    match repeatedPositiveProduct (.fraction (asFraction value)) (.integer (.ofNat k)) with
    | .error e => throw (IO.userError e)
    | .ok actual => if (actual.numerator,actual.denominator) != (expectedN,expectedD) then throw (IO.userError s!"product mismatch {n}/{d}^{k}")
 for (n,d,expectedN,expectedD) in growthCases do
  if hn : 0 < n then
   if hd : 0 < d then
    let value := normalizePositive n d hn hd
    match boundaryGrowth (.fraction (asFraction value)) with
    | .error e => if n > d || e != "ValueError: distance ratio must be exact and above the One" then throw (IO.userError "wrong growth rejection")
    | .ok actual => if n ≤ d || (actual.numerator,actual.denominator) != (expectedN,expectedD) then throw (IO.userError "wrong growth output")
 let invalidBases : List Input := [.nonFraction,.fraction ⟨.ofNat 0,1,by decide,by decide⟩,.fraction ⟨.negSucc 0,1,by decide,by decide⟩]
 for input in invalidBases do
  match repeatedPositiveProduct input (.boolean false) with
  | .error e => if e != "ValueError: repeated product requires an exact positive part or ratio" then throw (IO.userError "base error precedence")
  | .ok _ => throw (IO.userError "invalid base admitted")
  match boundaryGrowth input with
  | .error e => if e != "ValueError: distance ratio must be exact and above the One" then throw (IO.userError "growth error")
  | .ok _ => throw (IO.userError "invalid growth admitted")
 for input in [CountInput.integer (-1),.integer 0,.boolean false,.boolean true] do
  match repeatedPositiveProduct (.fraction (asFraction two)) input with
  | .error e => if e != "ValueError: repeated product requires a positive count" then throw (IO.userError "count error")
  | .ok _ => throw (IO.userError "invalid count admitted")
 IO.println "PASS 864 complete product outputs, 144 boundary-growth outputs/rejections and 10 invalid-input/precedence checks"
