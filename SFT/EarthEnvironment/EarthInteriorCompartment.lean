import SFT.EarthEnvironment.StructuralModel
namespace SFT.EarthEnvironment.EarthInteriorCompartment
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 relation : String
 retained_record : String
 evidence_boundary : String
 statement : String
 falsification_condition : String
def original : Obligation := ⟨"SFT-EARTH-INTERIOR-COMPARTMENT-001","Earth interior compartments","interior_geodynamics","nested-interior-region-carrier","boundary-and-property-contrast-relation","depth-composition-state-observation-and-uncertainty-held","geophysical-inference-bounded","An inferred Earth-interior compartment requires a reproducible property contrast across a declared boundary with its observation and inversion limits retained.","Reject if an inversion model is presented as direct access or if incompatible observations and nonunique interiors are erased."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def relationWitness : Bool := !(SFT.Host.Text.equal original.carrier original.relation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier)
def exactFoldWitness : Bool :=
 match StructuralModel.structuralWitnesses with
 | .error _ => false
 | .ok rows =>
  (match rows.find? (fun row => SFT.Host.Text.equal row.1 "layers_are_positive_and_ordered") with
   | none => false | some row => row.2) &&
  (match rows.find? (fun row => SFT.Host.Text.equal row.1 "boundary_transfer_is_two_sided") with
   | none => false | some row => row.2)
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem relationWitnessPassed : relationWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by rfl
end SFT.EarthEnvironment.EarthInteriorCompartment
