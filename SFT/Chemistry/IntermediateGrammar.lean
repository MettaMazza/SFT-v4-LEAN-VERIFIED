import SFT.Foundation.CommonRefinement
import SFT.Foundation.CommonRefinement
namespace SFT.Chemistry.IntermediateGrammar
open SFT.Foundation
set_option maxRecDepth 20000

inductive Identity where
  | rejected | admitted

def identityName : Identity → String
  | .rejected => "anonymous-transient"
  | .admitted => "named-internal-species"

inductive Production where
  | rejected | admitted

def productionName : Production → String
  | .rejected => "not-produced"
  | .admitted => "produced-by-one-step"

inductive Consumption where
  | rejected | admitted

def consumptionName : Consumption → String
  | .rejected => "not-consumed"
  | .admitted => "consumed-by-later-step"

inductive Order where
  | rejected | admitted

def orderName : Order → String
  | .rejected => "consumed-before-produced"
  | .admitted => "production-precedes-consumption"

inductive Net where
  | rejected | admitted

def netName : Net → String
  | .rejected => "present-in-net-products"
  | .admitted => "cancels-from-net-endpoints"

inductive Retention where
  | rejected | admitted

def retentionName : Retention → String
  | .rejected => "intermediate-erased"
  | .admitted => "intermediate-path-identity-held"

inductive Record where
  | rejected | admitted

def recordName : Record → String
  | .rejected => "intermediate-name-only"
  | .admitted => "production-consumption-trace"

inductive Extra where
  | rejected | admitted

def extraName : Extra → String
  | .rejected => "free-short-lived-premise"
  | .admitted => "no-extra-rule"

structure Candidate where
  identity : Identity
  production : Production
  consumption : Consumption
  order : Order
  net : Net
  retention : Retention
  record : Record
  extra : Extra

def sourceFields (c : Candidate) : List String := [identityName c.identity, productionName c.production, consumptionName c.consumption, orderName c.order, netName c.net, retentionName c.retention, recordName c.record, extraName c.extra]

def candidateId (c : Candidate) : String := SFT.Host.Text.intercalate "__" (sourceFields c)
def exactForm (c : Candidate) : String := SFT.Host.Text.intercalate "; " [SFT.Host.Text.append "identity=" (identityName c.identity), SFT.Host.Text.append "production=" (productionName c.production), SFT.Host.Text.append "consumption=" (consumptionName c.consumption), SFT.Host.Text.append "order=" (orderName c.order), SFT.Host.Text.append "net=" (netName c.net), SFT.Host.Text.append "retention=" (retentionName c.retention), SFT.Host.Text.append "record=" (recordName c.record), SFT.Host.Text.append "extra=" (extraName c.extra)]
def survivorId : String := "named-internal-species__produced-by-one-step__consumed-by-later-step__production-precedes-consumption__cancels-from-net-endpoints__intermediate-path-identity-held__production-consumption-trace__no-extra-rule"
def survives (c : Candidate) : Bool := SFT.Host.Text.equal (candidateId c) survivorId
def criteriaDecision (c : Candidate) : Bool :=
  SFT.Host.Text.equal (identityName c.identity) "named-internal-species" &&
  SFT.Host.Text.equal (productionName c.production) "produced-by-one-step" &&
  SFT.Host.Text.equal (consumptionName c.consumption) "consumed-by-later-step" &&
  SFT.Host.Text.equal (orderName c.order) "production-precedes-consumption" &&
  SFT.Host.Text.equal (netName c.net) "cancels-from-net-endpoints" &&
  SFT.Host.Text.equal (retentionName c.retention) "intermediate-path-identity-held" &&
  SFT.Host.Text.equal (recordName c.record) "production-consumption-trace" &&
  SFT.Host.Text.equal (extraName c.extra) "no-extra-rule"

def decisionReason (c : Candidate) : String :=
  if !(SFT.Host.Text.equal (identityName c.identity) "named-internal-species") then "Its recurrence cannot be checked." else
  if !(SFT.Host.Text.equal (productionName c.production) "produced-by-one-step") then "It is not generated by the mechanism." else
  if !(SFT.Host.Text.equal (consumptionName c.consumption) "consumed-by-later-step") then "It remains a product, not an intermediate." else
  if !(SFT.Host.Text.equal (orderName c.order) "production-precedes-consumption") then "The trace is causally open." else
  if !(SFT.Host.Text.equal (netName c.net) "cancels-from-net-endpoints") then "It is then an endpoint product." else
  if !(SFT.Host.Text.equal (retentionName c.retention) "intermediate-path-identity-held") then "Erasure destroys the mechanism proof." else
  if !(SFT.Host.Text.equal (recordName c.record) "production-consumption-trace") then "A name lacks step witnesses." else
  if !(SFT.Host.Text.equal (extraName c.extra) "no-extra-rule") then "Lifetime alone cannot define path role." else
  "named-internal-species__produced-by-one-step__consumed-by-later-step__production-precedes-consumption__cancels-from-net-endpoints"

def generationRule : String := "Generate the literal product of identity, production, consumption, order, net, retention, record and extension choices."
def grammarBoundary : String := "Every named chemical species produced by one internal elementary step and consumed by a later step of the same complete mechanism, absent from the net endpoint difference but retained in the path trace."

def candidates : List Candidate :=
  ([Identity.rejected,Identity.admitted]).flatMap fun identity =>
  ([Production.rejected,Production.admitted]).flatMap fun production =>
  ([Consumption.rejected,Consumption.admitted]).flatMap fun consumption =>
  ([Order.rejected,Order.admitted]).flatMap fun order =>
  ([Net.rejected,Net.admitted]).flatMap fun net =>
  ([Retention.rejected,Retention.admitted]).flatMap fun retention =>
  ([Record.rejected,Record.admitted]).flatMap fun record =>
  ([Extra.rejected,Extra.admitted]).map fun extra =>
  ⟨identity,production,consumption,order,net,retention,record,extra⟩

def survivor : Candidate := ⟨.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted⟩

theorem generatedCardinality : candidates.length = 256 := rfl

theorem candidatesComplete (c : Candidate) : c ∈ candidates := by
  cases c with
  | mk identity production consumption order net retention record extra =>
    have hidentity : identity ∈ [Identity.rejected,Identity.admitted] := by
      cases identity <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hproduction : production ∈ [Production.rejected,Production.admitted] := by
      cases production <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hconsumption : consumption ∈ [Consumption.rejected,Consumption.admitted] := by
      cases consumption <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have horder : order ∈ [Order.rejected,Order.admitted] := by
      cases order <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hnet : net ∈ [Net.rejected,Net.admitted] := by
      cases net <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hretention : retention ∈ [Retention.rejected,Retention.admitted] := by
      cases retention <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hrecord : record ∈ [Record.rejected,Record.admitted] := by
      cases record <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hextra : extra ∈ [Extra.rejected,Extra.admitted] := by
      cases extra <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    unfold candidates
    apply CommonRefinement.memFlatMap _ _ identity _ hidentity
    apply CommonRefinement.memFlatMap _ _ production _ hproduction
    apply CommonRefinement.memFlatMap _ _ consumption _ hconsumption
    apply CommonRefinement.memFlatMap _ _ order _ horder
    apply CommonRefinement.memFlatMap _ _ net _ hnet
    apply CommonRefinement.memFlatMap _ _ retention _ hretention
    apply CommonRefinement.memFlatMap _ _ record _ hrecord
    exact Count.TraceDerivation.memMap _ extra _ hextra

set_option maxHeartbeats 20000000 in
theorem sourceDecisionMatchesCriteria (c : Candidate) : survives c = criteriaDecision c := by
  cases c with
  | mk identity production consumption order net retention record extra =>
    cases identity <;> cases production <;> cases consumption <;> cases order <;> cases net <;> cases retention <;> cases record <;> cases extra
    all_goals rfl

set_option maxHeartbeats 10000000 in
theorem uniqueCriteriaSurvivor (c : Candidate) : criteriaDecision c = true ↔ c = survivor := by
  cases c with
  | mk identity production consumption order net retention record extra =>
    cases identity <;> cases production <;> cases consumption <;> cases order <;> cases net <;> cases retention <;> cases record <;> cases extra
    all_goals constructor <;> intro h <;> first | rfl | cases h

theorem uniqueSurvivor (c : Candidate) : survives c = true ↔ c = survivor := by
  rw [sourceDecisionMatchesCriteria]
  exact uniqueCriteriaSurvivor c

theorem survivorAccepted : survives survivor = true := rfl

def ExactCriteria (c : Candidate) : Prop :=
  c.identity = .admitted ∧ c.production = .admitted ∧ c.consumption = .admitted ∧ c.order = .admitted ∧ c.net = .admitted ∧ c.retention = .admitted ∧ c.record = .admitted ∧ c.extra = .admitted

theorem acceptanceIffExactCriteria (c : Candidate) : survives c = true ↔ ExactCriteria c := by
  constructor
  · intro h
    have eq := (uniqueSurvivor c).mp h
    cases eq
    exact ⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
  · intro h
    cases c with
    | mk identity production consumption order net retention record extra =>
      obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩ := h
      cases h0; cases h1; cases h2; cases h3; cases h4; cases h5; cases h6; cases h7
      rfl

theorem identity_rejected_rejected (c : Candidate) (h : c.identity = .rejected) : survives c = false := by
  cases hs : survives c with
  | false => rfl
  | true =>
    have eq := (uniqueSurvivor c).mp hs
    have field := congrArg Candidate.identity eq
    rw [h] at field
    cases field

