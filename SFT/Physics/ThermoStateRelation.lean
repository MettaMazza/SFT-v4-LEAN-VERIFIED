import SFT.Physics.ThermoStatisticalWeight
import SFT.Physics.FieldGaugeEquivalence
namespace SFT.Physics.ThermoStateRelation

-- The four independently observed carrier roles named by STATE_RELATION.
structure StateRow (Content Boundary Thermal Energy : Type) where
 content : Content
 boundary : Boundary
 thermal : Thermal
 energy : Energy

variable {State Content Boundary Thermal Energy Extra : Type}

structure RegisteredDomain (State Content Boundary Thermal Energy : Type) where
 states : List State
 observe : State → StateRow Content Boundary Thermal Energy

-- The exact relation is generated by the complete registered domain.
def relation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (row : StateRow Content Boundary Thermal Energy) : Prop :=
 ∃ state, state ∈ d.states ∧ d.observe state = row

def covers (d : RegisteredDomain State Content Boundary Thermal Energy)
 (r : StateRow Content Boundary Thermal Energy → Prop) : Prop :=
 ∀ state, state ∈ d.states → r (d.observe state)

theorem completeClosure (d : RegisteredDomain State Content Boundary Thermal Energy) : covers d (relation d) :=
 fun state member => ⟨state,member,rfl⟩

theorem leastClosedRelation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (r : StateRow Content Boundary Thermal Energy → Prop) (complete : covers d r)
 (row : StateRow Content Boundary Thermal Energy) (generated : relation d row) : r row := by
 obtain ⟨state,member,equal⟩ := generated
 rw [← equal]
 exact complete state member

theorem uniqueMinimalRelation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (r : StateRow Content Boundary Thermal Energy → Prop) (complete : covers d r)
 (minimal : ∀ q, covers d q → ∀ row, r row → q row)
 (row : StateRow Content Boundary Thermal Energy) : r row ↔ relation d row :=
 ⟨minimal (relation d) (completeClosure d) row,leastClosedRelation d r complete row⟩

theorem deletingGeneratedRowBreaksClosure (d : RegisteredDomain State Content Boundary Thermal Energy)
 (r : StateRow Content Boundary Thermal Energy → Prop) (row : StateRow Content Boundary Thermal Energy)
 (generated : relation d row) (missing : ¬ r row) : ¬ covers d r :=
 fun complete => missing (leastClosedRelation d r complete row generated)

theorem addingUngeneratedRowBreaksExactness (d : RegisteredDomain State Content Boundary Thermal Energy)
 (row : StateRow Content Boundary Thermal Energy) (outside : ¬ relation d row) :
 ¬ (∀ held, (relation d held ∨ held = row) → relation d held) :=
 fun exact => outside (exact row (Or.inr rfl))

-- A redundant coordinate is reconstructed from the retained independent row.
-- Projection deletes that description coordinate without deleting a carrier.
def expandedRelation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (derive : StateRow Content Boundary Thermal Energy → Extra)
 (row : StateRow Content Boundary Thermal Energy) (extra : Extra) : Prop :=
 ∃ state, state ∈ d.states ∧ d.observe state = row ∧ derive (d.observe state) = extra

theorem redundantCoordinateExactlyDetermined (d : RegisteredDomain State Content Boundary Thermal Energy)
 (derive : StateRow Content Boundary Thermal Energy → Extra)
 (row : StateRow Content Boundary Thermal Energy) (extra : Extra) :
 expandedRelation d derive row extra ↔ relation d row ∧ derive row = extra := by
 constructor
 · intro ⟨state,member,equal,value⟩
   exact ⟨⟨state,member,equal⟩,(congrArg derive equal).symm.trans value⟩
 · intro ⟨⟨state,member,equal⟩,value⟩
   exact ⟨state,member,equal,(congrArg derive equal).trans value⟩

theorem redundantCoordinateRemovalPreservesRelation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (derive : StateRow Content Boundary Thermal Energy → Extra) (row : StateRow Content Boundary Thermal Energy) :
 (∃ extra, expandedRelation d derive row extra) ↔ relation d row := by
 constructor
 · intro ⟨extra,expanded⟩
   exact ((redundantCoordinateExactlyDetermined d derive row extra).mp expanded).1
 · intro generated
   exact ⟨derive row,(redundantCoordinateExactlyDetermined d derive row (derive row)).mpr ⟨generated,rfl⟩⟩

theorem noFreeRedundantReading (d : RegisteredDomain State Content Boundary Thermal Energy)
 (derive : StateRow Content Boundary Thermal Energy → Extra) (row : StateRow Content Boundary Thermal Energy)
 (a b : Extra) (ha : expandedRelation d derive row a) (hb : expandedRelation d derive row b) : a = b :=
 (((redundantCoordinateExactlyDetermined d derive row a).mp ha).2).symm.trans
  (((redundantCoordinateExactlyDetermined d derive row b).mp hb).2)

theorem fullCarrierEquality (a b : StateRow Content Boundary Thermal Energy) :
 a = b ↔ a.content = b.content ∧ a.boundary = b.boundary ∧ a.thermal = b.thermal ∧ a.energy = b.energy := by
 constructor
 · intro same; cases same; exact ⟨rfl,rfl,rfl,rfl⟩
 · intro ⟨hc,hb,ht,he⟩
   cases a; cases b; cases hc; cases hb; cases ht; cases he; rfl

-- Extending the registered finite domain retains every previous relation row.
theorem successorRelation (d : RegisteredDomain State Content Boundary Thermal Energy)
 (fresh : State) (row : StateRow Content Boundary Thermal Energy) :
 relation {d with states := fresh :: d.states} row ↔ d.observe fresh = row ∨ relation d row := by
 constructor
 · intro ⟨state,member,equal⟩
   cases member with
   | head => exact Or.inl equal
   | tail _ held => exact Or.inr ⟨state,held,equal⟩
 · intro h
   cases h with
   | inl equal => exact ⟨fresh,List.Mem.head _,equal⟩
   | inr old => obtain ⟨state,member,equal⟩ := old; exact ⟨state,List.Mem.tail _ member,equal⟩

theorem singletonRelation (observe : State → StateRow Content Boundary Thermal Energy)
 (state : State) (row : StateRow Content Boundary Thermal Energy) :
 relation ⟨[state],observe⟩ row ↔ observe state = row := by
 constructor
 · intro ⟨held,member,equal⟩
   cases member with
   | head => exact equal
   | tail _ impossible => cases impossible
 · intro equal; exact ⟨state,List.Mem.head _,equal⟩
end SFT.Physics.ThermoStateRelation
