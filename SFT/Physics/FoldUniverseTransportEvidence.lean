 ("coordinates",.array [.array [.text "orbit",.text (orbitName c.orbit)],.array [.text "dynamics",.text (dynamicsName c.dynamics)],.array [.text "topology",.text (topologyName c.topology)],.array [.text "mapping",.text (mappingName c.mapping)],.array [.text "period",.text (periodName c.period)],.array [.text "correlation",.text (correlationName c.correlation)],.array [.text "signal",.text (signalName c.signal)],.array [.text "travel",.text (travelName c.travel)],.array [.text "physical",.text (physicalName c.physical)],.array [.text "extension",.text (extensionName c.extension)]]),
 ("exact_form",.text (exactForm c))]

