.cgi?ID=C1333740&Mask=1000 :: complete-transition-record",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"],.array [.text "selection-H2-transition-state-046",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-H2-SELECTION-SURFACE",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1333740&Mask=1000 :: complete-transition-record",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"],.array [.text "selection-adverse-note-42",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-H2-SELECTION-SURFACE",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1333740&Mask=1000 :: adverse-observation-note",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"],.array [.text "selection-adverse-note-73",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-H2-SELECTION-SURFACE",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1333740&Mask=1000 :: adverse-observation-note",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"],.array [.text "selection-adverse-note-78",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-H2-SELECTION-SURFACE",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1333740&Mask=1000 :: adverse-observation-note",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"]]),("target_content_absent_from_prediction",.boolean true),("all_sixty_three_records_required",.boolean true),("exceptions_must_retain_mediation_or_channel",.boolean true),("falsification_condition",.text "The claim fails if a direct observation changes multiplicity, preserves a known g/u fibre, jumps more than one axis recurrence, or loses either endpoint; if an observed non-direct case is admitted without a retained mediation requirement; if channel absence is treated as numerical zero or universal nonexistence; or if any of 60 NIST transition rows, three adverse notes, 52 direct one-step records, two mediated two-step records, one unresolved endpoint, four couplings or one closed coordinate is omitted or changed.")]
def programFields : List (String × Value) := match predictionDocument with
 | .object fs => fs
 | .null | .text _ | .boolean _ | .integer _ | .array _ => []
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (targetIds.map Value.text)),("frozen_relation_hash",.text derivationSeal),
 ("experiment_registration_hash",.text registrationHash)]
def dimensions : List (String × List (String × Bool)) := [("carrier",[("answer-only-rule",false),("retained-endpoint-signatures",true)]),("observation",[("channel-independent-permission",false),("declared-observation-class",true)]),("multiplicity",[("untracked-spin-support",false),("direct-multiplicity-retention",true)]),("inversion",[("same-fibre-direct-image",false),("known-inversion-fibre-change",true)]),("axis",[("arbitrary-axis-jump",false),("same-or-neighbour-axis-support",true)]),("mediation",[("exception-erases-law",false),("non-direct-requires-retained-mediator",true)]),("absence",[("numerical-zero-or-universal-forbidden",false),("channel-closed-EmptyOne",true)]),("record",[("selected-success-only",false),("complete-adverse-inclusive-vector",true)])]
def distinct (xs : List String) : Bool := (xs.foldl (fun acc x => if acc.any (Text.equal x) then acc else x::acc) []).length == xs.length
def validateSpec : Except String Unit := do
 if !(Text.chars "SFT-CHEM-").isPrefixOf (Text.chars claimId) then throw "empirical Chemistry claim identity is invalid"
 if !(Text.chars "SFT-EXP-CHEM-").isPrefixOf (Text.chars experimentId) then throw "empirical Chemistry experiment identity is invalid"
 if SelectionRuleEvidence.dependencies.isEmpty || dimensions.length != 8 || targetIds.isEmpty then
  throw "empirical Chemistry law lacks dependencies, eight dimensions or targets"
 if !distinct (dimensions.map Prod.fst) then throw "empirical Chemistry law contains duplicate dimensions"
 let _ ← dimensions.mapM fun d => do
  if d.2.length != 2 then throw "each Chemistry dimension must exhaust two registered forms"
  if (d.2.filter Prod.snd).length != 1 then throw "dimension requires one preserving form"
 if (NuclideCarrierSurface.trimLine (Text.chars expectedLabel)).isEmpty || (NuclideCarrierSurface.trimLine (Text.chars falsification)).isEmpty then
  throw "Chemistry prediction or falsification condition is missing"
 if !distinct targetIds then throw "Chemistry target identities are duplicated"
 if !(snapshotHashes.all fun h => (Text.chars "sha256:").isPrefixOf (Text.chars h)) then throw "Chemistry target snapshot identity is invalid"
 if !([SelectionRule.directWitness,SelectionRule.mediatedWitness,SelectionRule.closedWitness,SelectionRule.adverseWitness].all id) then throw "Chemistry operational witness failed"
 return ()
#print axioms claimId
#print axioms experimentId
#print axioms expectedLabel
#print axioms falsification
#print axioms sourceIds
#print axioms targetIds
#print axioms snapshotHashes
#print axioms predictionDocument
#print axioms registration
#print axioms programFields
#print axioms labelValue
#print axioms envelope
#print axioms dimensions
#print axioms distinct
#print axioms validateSpec
end SFT.Chemistry.SelectionRuleExperiment
