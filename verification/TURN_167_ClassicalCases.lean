set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option synthInstance.maxSize 100000
abbrev View := String × List String × Nat × Nat
def pv (r : ProbabilityRow) : View := (r.observedLabel,r.microstates,r.exactSupportPart.numerator,r.exactSupportPart.denominator)
def fv (r : PushforwardRow) : View := (r.image,r.predecessors,r.exactSupportPart.numerator,r.exactSupportPart.denominator)
def pview : Except String (List ProbabilityRow) → Except String (List View)
 | .error e => .error e | .ok rows => .ok (rows.map pv)
def fview : Except String (List PushforwardRow) → Except String (List View)
 | .error e => .error e | .ok rows => .ok (rows.map fv)
def same {α : Type} [DecidableEq α] (a b : Except String α) : Bool := match a with
 | .error e => match b with | .error f => decide (e=f) | .ok _ => false
 | .ok x => match b with | .error _ => false | .ok y => decide (x=y)

def rview : Except String (List RealizationRow) → Except String (List (String × List (String × String) × Nat × Nat))
 | .error e => .error e | .ok rows => .ok (rows.map (fun row => (row.observedLabel,row.members,row.exactSupportPart.numerator,row.exactSupportPart.denominator)))
