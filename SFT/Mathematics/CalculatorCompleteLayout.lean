import SFT.Mathematics.CalculatorLayout
import SFT.Mathematics.CalculatorCompleteGUI
import SFT.Mathematics.CalculatorExpressionCensus
namespace SFT.Mathematics.CalculatorCompleteLayout
open SFT.Host SFT.Mathematics CalculatorLayout
set_option maxRecDepth 100000
set_option maxHeartbeats 100000000
def constructor (available : List String) : StateM Builder Unit := do
 let root := "root"
 let expression ← create "tk.StringVar" [] []
 let result ← create "tk.StringVar" [] [("value",.text "0")]
 let status ← create "tk.StringVar" [] [("value",.text "Ready")]
 let mode ← create "tk.StringVar" [] [("value",.text "RAD")]
 let memory ← create "tk.StringVar" [] [("value",.text "")]
 emit root "title" [.text "Smithian Fold Scientific Calculator"] []
 emit root "geometry" [.text "760x760"] []
 emit root "minsize" [.integer 720,.integer 660] []
 emit root "configure" [] [("background",.text "#f3f3f3")]
 emit "root.tk" "call" [.text "tk",.text "scaling",.object [("float",.text "1.12")]] []
 let style ← create "ttk.Style" [ref root] []
 emit style "theme_names" [] []
 if available.any (Text.equal "vista") then emit style "theme_use" [.text "vista"] []
 else if available.any (Text.equal "aqua") then emit style "theme_use" [.text "aqua"] []
 else if available.any (Text.equal "clam") then emit style "theme_use" [.text "clam"] []
 else pure ()
 emit style "configure" [.text "Display.TEntry"] [("font",.array [.text "Segoe UI",.integer 18]),("padding",.integer 10)]
 emit style "configure" [.text "Result.TLabel"] [("font",.array [.text "Segoe UI Semibold",.integer 28]),("anchor",.text "e")]
 emit style "configure" [.text "Calc.TButton"] [("font",.array [.text "Segoe UI",.integer 11]),("padding",.array [.integer 7,.integer 10])]
 emit style "configure" [.text "Equals.TButton"] [("font",.array [.text "Segoe UI Semibold",.integer 12]),("padding",.array [.integer 7,.integer 10])]
 emit style "configure" [.text "Title.TLabel"] [("font",.array [.text "Segoe UI Semibold",.integer 15])]
 emit style "configure" [.text "Status.TLabel"] [("font",.array [.text "Segoe UI",.integer 9]),("foreground",.text "#555555")]
 let outer ← create "ttk.Frame" [ref root] [("padding",.integer 14)]
 emit outer "pack" [] [("fill",.text "both"),("expand",.boolean true)]
 emit outer "columnconfigure" [.integer 0] [("weight",.integer 3)]
 emit outer "columnconfigure" [.integer 1] [("weight",.integer 2)]
 emit outer "rowconfigure" [.integer 0] [("weight",.integer 1)]
 let calculator ← create "ttk.Frame" [ref outer] []
 emit calculator "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "nsew")]
 let _ ← (List.range 8).mapM fun column => emit calculator "columnconfigure" [.integer (.ofNat column)] [("weight",.integer 1)]
 let header ← create "ttk.Frame" [ref calculator] []
 emit header "grid" [] [("row",.integer 0),("column",.integer 0),("columnspan",.integer 8),("sticky",.text "ew"),("pady",.array [.integer 0,.integer 8])]
 let title ← create "ttk.Label" [ref header] [("text",.text "Scientific"),("style",.text "Title.TLabel")]
 emit title "pack" [] [("side",.text "left")]
 let memoryLabel ← create "ttk.Label" [ref header] [("textvariable",ref memory)]
 emit memoryLabel "pack" [] [("side",.text "left"),("padx",.integer 10)]
 let detailsButton ← create "ttk.Button" [ref header] [("text",.text "Show SFT proof"),("command",callback "toggle_details")]
 emit detailsButton "pack" [] [("side",.text "right"),("padx",.array [.integer 8,.integer 0])]
 let learnButton ← create "ttk.Button" [ref header] [("text",.text "Learn SFT"),("command",callback "show_learn")]
 emit learnButton "pack" [] [("side",.text "right"),("padx",.array [.integer 8,.integer 0])]
 let modeBox ← create "ttk.Combobox" [ref header] [("textvariable",ref mode),("values",.array [.text "RAD",.text "DEG",.text "GRAD"]),("state",.text "readonly"),("width",.integer 6)]
 emit modeBox "pack" [] [("side",.text "right")]
 emit modeBox "bind" [.text "<<ComboboxSelected>>",callback "change_mode"] []
 let entry ← create "ttk.Entry" [ref calculator] [("textvariable",ref expression),("justify",.text "right"),("style",.text "Display.TEntry")]
 emit entry "grid" [] [("row",.integer 1),("column",.integer 0),("columnspan",.integer 8),("sticky",.text "ew"),("pady",.array [.integer 0,.integer 4])]
 emit entry "bind" [.text "<Return>",callback "evaluate"] []
 emit entry "bind" [.text "<KP_Enter>",callback "evaluate"] []
 emit entry "bind" [.text "<Escape>",Canonical.Value.object [("callback",.text "press"),("label",.text "C")]] []
 emit entry "bind" [.text "<Delete>",Canonical.Value.object [("callback",.text "press"),("label",.text "CE")]] []
 let resultFrame ← create "ttk.Frame" [ref calculator] []
 emit resultFrame "grid" [] [("row",.integer 2),("column",.integer 0),("columnspan",.integer 8),("sticky",.text "ew"),("pady",.array [.integer 0,.integer 8])]
 emit resultFrame "columnconfigure" [.integer 0] [("weight",.integer 1)]
 let resultLabel ← create "ttk.Label" [ref resultFrame] [("textvariable",ref result),("style",.text "Result.TLabel")]
 emit resultLabel "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "ew")]
 let copyButton ← create "ttk.Button" [ref resultFrame] [("text",.text "Copy"),("command",callback "copy_result")]
 emit copyButton "grid" [] [("row",.integer 0),("column",.integer 1),("padx",.array [.integer 8,.integer 0])]
 let statusLabel ← create "ttk.Label" [ref calculator] [("textvariable",ref status),("style",.text "Status.TLabel")]
 emit statusLabel "grid" [] [("row",.integer 3),("column",.integer 0),("columnspan",.integer 8),("sticky",.text "ew"),("pady",.array [.integer 0,.integer 6])]
 let _ ← CalculatorCompleteController.mainButtonRows.zipIdx.mapM fun (row,rowIndex) => do
  emit calculator "rowconfigure" [.integer (.ofNat (rowIndex+4))] [("weight",.integer 1)]
  let _ ← row.zipIdx.mapM fun (label,column) => do
   let button ← create "ttk.Button" [ref calculator] [("text",.text label),("command",.object [("callback",.text "press"),("label",.text label)]),("style",.text (if Text.equal label "=" then "Equals.TButton" else "Calc.TButton"))]
   emit button "grid" [] [("row",.integer (.ofNat (rowIndex+4))),("column",.integer (.ofNat column)),("sticky",.text "nsew"),("padx",.integer 2),("pady",.integer 2)]
  pure ()
 let details ← create "ttk.Notebook" [ref outer] []
 emit details "grid" [] [("row",.integer 0),("column",.integer 1),("sticky",.text "nsew"),("padx",.array [.integer 12,.integer 0])]
 let history ← create "ttk.Frame" [ref details] [("padding",.integer 10)]
 emit history "rowconfigure" [.integer 0] [("weight",.integer 1)]
 emit history "columnconfigure" [.integer 0] [("weight",.integer 1)]
 let historyList ← create "tk.Listbox" [ref history] [("font",.array [.text "Segoe UI",.integer 10]),("activestyle",.text "none")]
 emit historyList "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "nsew")]
 emit historyList "bind" [.text "<Double-Button-1>",callback "restore_history"] []
 let clearButton ← create "ttk.Button" [ref history] [("text",.text "Clear history"),("command",callback "clear_history")]
 emit clearButton "grid" [] [("row",.integer 1),("column",.integer 0),("sticky",.text "ew"),("pady",.array [.integer 8,.integer 0])]
 emit details "add" [ref history] [("text",.text "History")]
 let proofFrame ← create "ttk.Frame" [ref details] [("padding",.integer 10)]
 emit proofFrame "rowconfigure" [.integer 0] [("weight",.integer 1)]
 emit proofFrame "columnconfigure" [.integer 0] [("weight",.integer 1)]
 let proof ← create "tk.Text" [ref proofFrame] [("wrap",.text "word"),("font",.array [.text "Segoe UI",.integer 10]),("relief",.text "flat"),("background",.text "#ffffff")]
 let proofScroll ← create "ttk.Scrollbar" [ref proofFrame] [("orient",.text "vertical"),("command",Canonical.Value.object [("method_ref",.array [ref proof,.text "yview"]) ])]
 emit proof "configure" [] [("yscrollcommand",Canonical.Value.object [("method_ref",.array [ref proofScroll,.text "set"]) ])]
 emit proof "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "nsew")]
 emit proofScroll "grid" [] [("row",.integer 0),("column",.integer 1),("sticky",.text "ns")]
 emit details "add" [ref proofFrame] [("text",.text "Exact proof")]
 let functions ← create "ttk.Frame" [ref details] [("padding",.integer 10)]
 emit functions "columnconfigure" [.integer 0] [("weight",.integer 1)]
 emit functions "columnconfigure" [.integer 1] [("weight",.integer 3)]
 let functionsTitle ← create "ttk.Label" [ref functions] [("text",.text "All functions"),("style",.text "Title.TLabel")]
 emit functionsTitle "grid" [] [("row",.integer 0),("column",.integer 0),("columnspan",.integer 2),("sticky",.text "w"),("pady",.array [.integer 0,.integer 8])]
 let _ ← CalculatorCompleteController.functionCatalog.zipIdx.mapM fun ((name,template,description),index) => do
  let button ← create "ttk.Button" [ref functions] [("text",.text name),("command",.object [("callback",.text "insert_catalog"),("label",.text name)])]
  emit button "grid" [] [("row",.integer (.ofNat (index+1))),("column",.integer 0),("sticky",.text "ew"),("padx",.array [.integer 0,.integer 8]),("pady",.integer 2)]
  let label ← create "ttk.Label" [ref functions] [("text",.text (Text.join [template,"\n",description]))]
  emit label "grid" [] [("row",.integer (.ofNat (index+1))),("column",.integer 1),("sticky",.text "w"),("pady",.integer 2)]
 emit details "add" [ref functions] [("text",.text "Functions")]
 let laws ← create "ttk.Frame" [ref details] [("padding",.integer 10)]
 emit laws "rowconfigure" [.integer 2] [("weight",.integer 1)]
 emit laws "columnconfigure" [.integer 0] [("weight",.integer 1)]
 let lawChoice ← create "tk.StringVar" [] [("value",Canonical.Value.text (CalculatorExpressionCensus.currentClaimIds.headD ""))]
 let lawBox ← create "ttk.Combobox" [ref laws] [("textvariable",ref lawChoice),("values",Canonical.Value.array (CalculatorExpressionCensus.currentClaimIds.map Canonical.Value.text)),("state",.text "readonly")]
 emit lawBox "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "ew")]
 let lawActions ← create "ttk.Frame" [ref laws] []
 emit lawActions "grid" [] [("row",.integer 1),("column",.integer 0),("sticky",.text "ew"),("pady",.integer 6)]
 let explain ← create "ttk.Button" [ref lawActions] [("text",.text "Explain law"),("command",callback "show_law")]
 emit explain "pack" [] [("side",.text "left")]
 let replay ← create "ttk.Button" [ref lawActions] [("text",.text "Replay enumeration"),("command",callback "replay_law")]
 emit replay "pack" [] [("side",.text "left"),("padx",.integer 6)]
 let lawText ← create "tk.Text" [ref laws] [("wrap",.text "word"),("font",.array [.text "Consolas",.integer 9]),("relief",.text "flat"),("background",.text "#ffffff")]
 emit lawText "grid" [] [("row",.integer 2),("column",.integer 0),("sticky",.text "nsew")]
 emit details "add" [ref laws] [("text",.text "Mathematics")]
 let learnFrame ← create "ttk.Frame" [ref details] [("padding",.integer 10)]
 emit learnFrame "rowconfigure" [.integer 0] [("weight",.integer 1)]
 emit learnFrame "columnconfigure" [.integer 0] [("weight",.integer 1)]
 let learn ← create "tk.Text" [ref learnFrame] [("wrap",.text "word"),("font",.array [.text "Segoe UI",.integer 10]),("relief",.text "flat"),("background",.text "#ffffff")]
 let learnScroll ← create "ttk.Scrollbar" [ref learnFrame] [("orient",.text "vertical"),("command",Canonical.Value.object [("method_ref",.array [ref learn,.text "yview"]) ])]
 emit learn "configure" [] [("yscrollcommand",Canonical.Value.object [("method_ref",.array [ref learnScroll,.text "set"]) ])]
 emit learn "grid" [] [("row",.integer 0),("column",.integer 0),("sticky",.text "nsew")]
 emit learnScroll "grid" [] [("row",.integer 0),("column",.integer 1),("sticky",.text "ns")]
 emit details "add" [ref learnFrame] [("text",.text "Learn")]
 emit learn "insert" [.text "1.0",Canonical.Value.text CalculatorCompleteGUI.guideText] []
 emit learn "configure" [] [("state",.text "disabled")]
 emit details "grid_remove" [] []
 emit entry "focus_set" [] []
def constructorCalls (available : List String) : List Canonical.Value := ((constructor available).run {}).2.calls
def launchCalls (tkAvailable : Bool) (available : List String) : Except String (List Canonical.Value) :=
 if !tkAvailable then .error "This Python installation does not include the standard graphical library. The terminal calculator remains available."
 else .ok ([.object [("target",.text "root"),("method",.text "new:tk.Tk"),("args",.array []),("kwargs",.object [])]] ++ constructorCalls available ++ [.object [("target",.text "root"),("method",.text "mainloop"),("args",.array []),("kwargs",.object [])]])
def setText (widget content : String) : StateM Builder Unit := do
 emit widget "configure" [] [("state",.text "normal")]
 emit widget "delete" [.text "1.0",.text "end"] []
 emit widget "insert" [.text "1.0",.text content] []
 emit widget "configure" [] [("state",.text "disabled")]
def sync (view : CalculatorCompleteController.View) (currentHistory : List String) : StateM Builder Unit := do
 emit "expression" "set" [.text view.expression] []
 emit "result" "set" [.text view.result] []
 emit "mode" "set" [.text view.angleMode] []
 emit "memory_indicator" "set" [.text (if view.memoryActive then "M" else "")] []
 emit "status" "set" [.text (if (Text.chars view.error).isEmpty then "Ready" else Text.append "Cannot calculate: " view.error)] []
 setText "proof_text" view.exactDetails
 emit "history_list" "get" [.integer 0,.text "end"] []
 if !(currentHistory.length == view.history.length && (currentHistory.zip view.history).all (fun (a,b) => Text.equal a b)) then
  emit "history_list" "delete" [.integer 0,.text "end"] []
  let _ ← view.history.mapM fun entry => emit "history_list" "insert" [.text "end",.text entry] []
  pure ()
 else pure ()
def syncCalls (view : CalculatorCompleteController.View) (currentHistory : List String) : List Canonical.Value := ((sync view currentHistory).run {}).2.calls
end SFT.Mathematics.CalculatorCompleteLayout
