import SFT.AstronomyCosmology.StructuralModel
namespace SFT.AstronomyCosmology.AstronomicalSpectrum
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 relation : String
 retained_record : String
 evidence_boundary : String
 statement : String
 falsification_condition : String
def original : Obligation := ⟨"SFT-ASTRO-SPECTRUM-001","Astronomical spectrum","radiation_motion_time","ordered-band-signal-carrier","wavelength-frequency-energy-feature-relation","resolution-response-calibration-lines-and-continuum-held","spectral-method-bounded","A spectrum is an ordered calibrated signal with resolution, response, features and continuum retained.","Reject an uncalibrated or selectively cropped feature set."⟩
def carrierWitness : Bool := !original.carrier.isEmpty
def relationWitness : Bool := !(SFT.Host.Text.equal original.carrier original.relation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier)
def exactFoldWitness : Bool :=
 match StructuralModel.structuralWitnesses.find? (fun row => SFT.Host.Text.equal row.1 "period_two_recurs") with
 | none => false
 | some row => row.2
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem relationWitnessPassed : relationWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by rfl
end SFT.AstronomyCosmology.AstronomicalSpectrum
