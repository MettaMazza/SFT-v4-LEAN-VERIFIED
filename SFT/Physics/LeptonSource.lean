import SFT.Physics.LeptonDecimal
namespace SFT.Physics.LeptonSource
open LeptonIntervals LeptonDecimal LeptonIsolation LeptonRefinement SFT.Host
set_option maxRecDepth 1000000
set_option maxHeartbeats 50000000

def lineBreaks : List Nat := [10,11,12,13,28,29,30,133,8232,8233]

def linesFrom : List Char → List Char → List (List Char) → List (List Char)
 | [],current,prior => (current.reverse :: prior).reverse
 | c::cs,current,prior => if lineBreaks.contains c.toNat then
   linesFrom cs [] (current.reverse :: prior)
   else linesFrom cs (c::current) prior

def lines (cs : List Char) : List (List Char) := linesFrom cs [] []

def matchingRows (rows : List (List Char)) (quantity : String) : List (List Char) :=
 rows.filter fun row =>
  110 ≤ row.length && (strip (row.take 60)) == Text.chars quantity

def sourceIntervalRows (rows : List (List Char)) (quantity : String) : Except String (Rat × Rat × Rat) :=
 match matchingRows rows quantity with
 | [] => .error (Text.append "ValueError: CODATA row must occur exactly once: " quantity)
 | row::rest => match rest with
   | _::_ => .error (Text.append "ValueError: CODATA row must occur exactly once: " quantity)
   | [] => do
     let central ← exactDecimal (String.ofList (strip ((row.drop 60).take 25)))
     let uncertainty ← exactDecimal (String.ofList (strip ((row.drop 85).take 25)))
     if !zero.blt uncertainty || !uncertainty.blt central then
       .error "ValueError: CODATA uncertainty must form a positive interval"
     else .ok (subtract central uncertainty,central,add central uncertainty)

def sourceInterval (text quantity : String) : Except String (Rat × Rat × Rat) :=
 sourceIntervalRows (lines (Text.chars text)) quantity

