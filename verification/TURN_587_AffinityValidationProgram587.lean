def document : Value := .object [("term",.object [("code",.text "E01990"),("status",.text "current"),("definitions",.array [.object [("text",.text "Concept introduced by L. Pauling as the power of an atom to attract electrons to itself. There are several definitions of this quantity. According to Mulliken it is the average of the ionization energy and electron affinity of an atom, but more frequently a relative scale due to Pauling is used where dimensionless relative electronegativity differences are defined on the basis of bond dissociation energies. The scale is chosen so as to make the relative electronegativity of hydrogen 2.1. The sign was chosen intuitively by Pauling.")]])]),("source_uri",.text "https://goldbook.iupac.org/terms/view/E01990/json"),("retrieved",.text "2026-07-24")]
