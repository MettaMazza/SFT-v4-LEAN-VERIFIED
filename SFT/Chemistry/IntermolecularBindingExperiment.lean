def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-011 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["value_inscription_kJ_per_mol","value_inscription_cm_inverse","uncertainty_inscription_cm_inverse",
  "central_cm_inverse","uncertainty_cm_inverse","lower_cm_inverse","upper_cm_inverse",
  "external_orientation","absolute_inscribed_magnitude_kJ_per_mol"]
 if !sameValue (get document "schema") (.text "sft-v3-intermolecular-binding-identities/1") ||
  !sameValue (get document "all_binding_values_absent") (.boolean true) || rows.length != 1299 ||
  !(rows.all fun row => sameValue (get row "target_value_absent") (.boolean true) && !(forbidden.any (hasKey row))) then
  throw "PROP-011 value-free identity boundary changed"
 pure rows
def identityFields : List (String × String) := [("dimer_formula","bound-composite-formula"),("dimer_name","bound-composite-name"),("donor_formula","molecular-constituent"),("acceptor_formula","molecular-constituent"),("source_class","external-evidence-class"),("source_id","external-source-identity")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "binding-row-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= text
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let optional ← [("method_id","calculation-method-id"),("basis_id","calculation-basis-id")].mapM fun (key,family) => do
  let destination := Text.intercalate "" [rowPrefix,"-",key]
  let value ← if hasKey row key then do
    let value ← field row key >>= text
    pure (instruction "label" destination [family,value])
   else pure (instruction "empty_one" destination ["structural-empty-One"])
  pure (value,destination)
 let laws := [("constituent-composition-law","exact-positive-named-constituent-state-composition"),
 ("separation-organization","finite-held-separated-constituent-endpoint"),
 ("binding-law","ordered-positive-separated-Take-bound"),
 ("absence-law","strict-bound-order-or-structural-EmptyOne"),
 ("extension-law","shared-constituent-extension-preserves-exact-Take")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (9+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ optional.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  optional.map Prod.fst ++ lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "complete-intermolecular-binding-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["complete-intermolecular-binding-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_target_registry",.array [.text targetPath,.text targetHash]),
 ("normalized_primary_records",.array [.text primaryPath,.text primaryHash]),
 ("water_cluster_source",.array [.text waterClusterPath,.text waterClusterHash]),
 ("ion_cluster_scope_source",.array [.text ionClusterPath,.text ionClusterHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_1299_binding_values_and_orientations_absent_from_prediction",.boolean true),
 ("computed_measured_adverse_and_scope_classes_separate",.boolean true),("falsification_condition",.text falsification)])
