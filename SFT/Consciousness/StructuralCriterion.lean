import SFT.Consciousness.StructuralModel
namespace SFT.Consciousness.StructuralCriterion
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 distinction : String
 operation : String
 retained_record : String
 evidence_boundary : String
 statement : String
def original : Obligation := ⟨"SFT-CONSC-STRUCTURAL-CRITERION-001","Consciousness structural criterion","substrate_realization","dual-self-relation-and-closure","report-generator/interior-loop","distinct-preimages-bind-and-complete","complete-self-observation-trace","multi-evidence-realization","The foundational structural criterion requires dual self-relation, image re-entry, complete integration and interior closure; output resemblance is insufficient."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def distinctionWitness : Bool := !(SFT.Host.Text.equal original.distinction original.operation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier) && !(SFT.Host.Text.equal original.evidence_boundary original.distinction)
def exactFoldWitness : Bool := ((match StructuralModel.structuralWitnesses.find? (fun row => SFT.Host.Text.equal row.1 "observer_observed_partition_the_one") with | some (_, passed) => passed | none => false))
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem distinctionWitnessPassed : distinctionWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by decide
end SFT.Consciousness.StructuralCriterion
