import SFT.Mathematics.DynamicsTraces
open SFT.Mathematics.DynamicsTraces
set_option maxRecDepth 30000
set_option maxHeartbeats 12000000
def sameTime (a b : Except String Time) : Bool :=
  match a with
  | .error e => match b with | .error f => decide (e = f) | .ok _ => false
  | .ok av => match b with
    | .error _ => false
    | .ok bv => match av,bv with
      | .inl x,.inl y => decide (x = y)
      | .inr x,.inr y => decide (x = y)
      | _,_ => false
