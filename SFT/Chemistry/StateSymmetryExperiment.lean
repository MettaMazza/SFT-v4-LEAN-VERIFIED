xt "C14967783-symmetry-002-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 2 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-symmetry-003-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 3 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-symmetry-004-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 4 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-symmetry-005-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 5 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-symmetry-006-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 6 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-symmetry-007-01",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state 7 term 1",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"]]),
 ("target_content_absent_from_prediction",.boolean true),
 ("target_inaccessible_to_capability_closed_execution",.boolean true),
 ("all_362_assignments_required",.boolean true),
 ("absence_glyph_policy",.text "source glyph 0 denotes absence only and is never an SFT number"),
 ("falsification_condition",.text "The claim fails if equivalence merges different carriers or retained symmetry signatures; if axis-invariant support has more than one orientation; if a positive axis recurrence lacks the complementary pair; if the component census differs from positive spin multiplicity times positive orientation count; if any source absence glyph is treated as a number rather than EmptyOne; if any of 362 NIST term assignments, 170 inversion labels, 167 reflection labels, 32 positive axis-component labels, 330 absent axis-component coordinates, 11 source component-absence glyphs or their exact state inscriptions is omitted or mismapped; or if a changed label, free degeneracy, incomplete class, omitted row or tampered source is accepted.")]
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (references.map fun row => .text row.targetId)),
 ("frozen_relation_hash",.text derivationSeal),("experiment_registration_hash",.text registrationHash)]
def specDimensions : List (String × List Bool) := [("carrier",[false,true]),("identity",[false,true]),("spin",[false,true]),("axis",[false,true]),("orientation",[false,true]),("symmetry",[false,true]),("class",[false,true]),("extension",[false,true])]
def specWitnesses : List Bool := [StateSymmetryWitnesses.sigmaClass,StateSymmetryWitnesses.piClass,StateSymmetryWitnesses.distinctSignatures,StateSymmetryWitnesses.badOrientation,StateSymmetryWitnesses.incompleteClass]
def validateSpec : Except String Unit := do
 if !(Text.chars "SFT-CHEM-").isPrefixOf (Text.chars claimId) then
  .error "empirical Chemistry claim identity is invalid"
 else if !(Text.chars "SFT-EXP-CHEM-").isPrefixOf (Text.chars experimentId) then
  .error "empirical Chemistry experiment identity is invalid"
 else if StateSymmetryEvidence.dependencies.isEmpty || specDimensions.length != 8 || references.isEmpty then
  .error "empirical Chemistry law lacks dependencies, eight dimensions or targets"
 else if !SourceExtraction.unique (specDimensions.map Prod.fst) then
  .error "empirical Chemistry law contains duplicate dimensions"
 else if !(specDimensions.all (fun d => d.2.length == 2)) then
  .error "each Chemistry dimension must exhaust two registered forms"
 else if !(specDimensions.all (fun d => (d.2.filter id).length == 1)) then
  .error "dimension requires one preserving form"
 else if !SourceText.nonblank expectedLabel || !SourceText.nonblank falsification then
  .error "Chemistry prediction or falsification condition is missing"
 else if !SourceExtraction.unique (references.map Reference.targetId) then
  .error "Chemistry target identities are duplicated"
 else if references.any (fun row => !(Text.chars "sha256:").isPrefixOf (Text.chars row.snapshotHash)) then
  .error "Chemistry target snapshot identity is invalid"
 else if !(specWitnesses.all id) then
  .error "Chemistry operational witness failed"
 else .ok ()

#print axioms claimId
#print axioms experimentId
#print axioms frozenRelation
#print axioms falsification
#print axioms expectedLabel
#print axioms sourceId
#print axioms identityRegistryPath
#print axioms identityRegistryHash
#print axioms targetRegistryPath
#print axioms targetRegistryHash
#print axioms references
#print axioms registration
#print axioms labelValue
#print axioms envelope
#print axioms specDimensions
#print axioms specWitnesses
#print axioms validateSpec
end SFT.Chemistry.StateSymmetryExperiment
