import SFT.Host.Text
namespace SFT.Medicine.Effectiveness
structure Obligation where
 claimId : String
 title : String
 family : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-MED-EFFECTIVENESS-001","Effectiveness","efficacy_effectiveness_safety_benefit_harm","practice-intervention-comparison","outcome-contrast-under-usual-care","delivery-adherence-context-variation","practice-population-and-horizon","Effectiveness is the corresponding contrast under retained real-care delivery, adherence, population and setting variation."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Medicine.Effectiveness
