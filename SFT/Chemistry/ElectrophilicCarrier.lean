import SFT.Chemistry.NucleophilicPath
namespace SFT.Chemistry.ElectrophilicCarrier
open SFT.Host SFT.Physics.CapabilityValues
open NucleophilicCarrier (Pair Bond State samePair sameEdge edge bondAt matchesPair contains sameSet electrons)
open DihedralTorsion (equalLabel equalLabels distinctAtoms)
inductive AcceptorSlot where
 | emptyOne
 | otherEmptyOne (identity : String)
 | occupied
structure Carrier where
 identity : HeldLabel
 left : HeldLabel
 centre : HeldLabel
 right : HeldLabel
 entering : HeldLabel
 leaving : HeldLabel
 donorPair : Pair
 recurrencePair : Pair
 leavingPair : Pair
 slot : AcceptorSlot
 source : State
structure Transition where
 occurrence : PositiveCount
 entry : State
 exit : State
 action : HeldLabel

def singletonEmpty : AcceptorSlot → Bool
 | .emptyOne => true
 | .otherEmptyOne _ | .occupied => false

def touches (roles : List HeldLabel) (e : HeldLabel × HeldLabel) : Bool :=
 roles.any (fun a => equalLabel a e.1 || equalLabel a e.2)
def carrier (identity left centre right entering leaving : HeldLabel) (donor recurrence displaced : Pair)
 (slot : AcceptorSlot) (source : State) : Except String Carrier := do
 if !Text.equal identity.family "registered-reaction" then throw "acceptor-driven substitution requires one registered reaction"
 let roles := [left,centre,right,entering,leaving]
 if !distinctAtoms roles || roles.any (fun a => !contains source.atoms a) then throw "aromatic exchange roles require five distinct retained occurrences"
 if !singletonEmpty slot then throw "the unoccupied entering acceptor slot is structural EmptyOne"
 let required := [((left,centre),donor),((centre,right),recurrence),((centre,leaving),displaced)]
 if required.any (fun (e,p) => !matchesPair (bondAt source e) p) || !source.freePairs.isEmpty then
  throw "source must retain the complete aromatic donor, recurrence and leaving supports"
 let extras := source.bonds.filter (fun b => !(required.any (fun p => sameEdge (edge b) p.1)))
 if extras.any (fun b => touches [centre,entering,leaving] (edge b)) then
  throw "source extensions cannot alter the local aromatic exchange support"
 if source.bonds.any (fun b => touches [entering] (edge b)) then
  throw "the source acceptor cannot already carry the entering bond"
 return ⟨identity,left,centre,right,entering,leaving,donor,recurrence,displaced,slot,source⟩
def transition (n : PositiveCount) (entry exit : State) (action : HeldLabel) : Except String Transition := do
 if !Text.equal action.family "acceptor-substitution-action" || !(["exchange-and-restore-in-one-transition","transfer-aromatic-pair-to-entering-support","relinquish-leaving-pair-to-restore-recurrence"].any (Text.equal action.label)) then
  throw "transition action is outside the generated acceptor-exchange alphabet"
 if !equalLabels entry.atoms exit.atoms then throw "every atom occurrence must survive the transition"
 if !sameSet (electrons entry) (electrons exit) then throw "every held electron occurrence must survive the transition"
 return ⟨n,entry,exit,action⟩
-- Dictionary equality checks all keys and the original last-value pair lookup.
def localMatches (s : State) (allowed : List (HeldLabel × HeldLabel))
 (expected : List ((HeldLabel × HeldLabel) × Pair)) : Bool :=
 (s.bonds.filter (fun b => allowed.any (sameEdge (edge b)))).all
  (fun b => expected.any (fun p => sameEdge (edge b) p.1)) &&
 expected.all (fun (e,p) => matchesPair (bondAt s e) p)
def stateRole (c : Carrier) (s : State) : Except String String := do
 let donor := (c.left,c.centre)
 let recurrence := (c.centre,c.right)
 let leaving := (c.centre,c.leaving)
 let entering := (c.centre,c.entering)
 let allowed := [donor,recurrence,leaving,entering]
 let background := s.bonds.filter (fun b => !(allowed.any (sameEdge (edge b))))
 if background.any (fun b => touches [c.centre,c.entering,c.leaving] (edge b)) then
  throw "an extension cannot alter the local exchange support"
 if !matchesPair (bondAt s recurrence) c.recurrencePair || !s.freePairs.isEmpty then
  throw "the retained aromatic recurrence support changed"
 if localMatches s allowed [(donor,c.donorPair),(recurrence,c.recurrencePair),(leaving,c.leavingPair)] then return "source"
 if localMatches s allowed [(recurrence,c.recurrencePair),(leaving,c.leavingPair),(entering,c.donorPair)] then return "addition-intermediate"
 if localMatches s allowed [(donor,c.leavingPair),(recurrence,c.recurrencePair),(entering,c.donorPair)] then return "restored-terminal"
 throw "state is not generated by the complete acceptor-driven aromatic exchange"
end SFT.Chemistry.ElectrophilicCarrier
