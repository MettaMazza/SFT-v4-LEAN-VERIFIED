def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-014 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["source_target_payload","source_target_payload_hash","withheld_target_hash","source_value_inscription","native_value","measurement_present","external_measurement_absence"]
 if !sameValue (get document "schema") (.text "sft-v3-cross-property-identities/1") ||
  !sameValue (get document "complete_property_family_count") (.integer 13) ||
  !sameValue (get document "complete_source_identity_row_count") (.integer 9025) ||
  !sameValue (get document "complete_structural_carrier_count") (.integer 1104) ||
  !sameValue (get document "multi_property_structural_carrier_count") (.integer 676) ||
  !sameValue (get document "all_target_values_presence_flags_and_source_orientations_absent") (.boolean true) || rows.length != 9025 ||
  !(rows.all fun row => sameValue (get row "target_value_presence_and_orientation_absent") (.boolean true) && !(forbidden.any (hasKey row))) then
  throw "PROP-014 value-free identity boundary changed"
 pure rows
-- These are precisely the scalar kinds of the registered identity fields.
def identityString (value : Value) : Except String String := match value with
 | .text s => pure s
 | .integer (.ofNat n) => pure (toString n)
 | .integer (.negSucc n) => pure (Text.append "-" (toString (n+1)))
 | .boolean b => pure (if b then "True" else "False")
 | .null => pure "None"
 | .array _ | .object _ => throw "registered cross-property identity field is not scalar"
def identityFields : List (String × String) := [("structural_carrier_id","structural-molecular-carrier"),
 ("property_family","molecular-property-family"),("property_label","molecular-property-label"),
 ("source_target_id","source-target-identity"),("source_identity_hash","source-identity-hash"),
 ("carrier_derivation_rule","carrier-derivation-rule"),("registered_property_family_count_for_carrier","positive-property-family-count"),
 ("complete_registered_row_count_for_carrier","positive-carrier-row-count"),("cross_property_overlap","cross-property-overlap-class")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "cross-property-row-" (toString ordinal)
 let target ← field row "cross_property_target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= identityString
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let laws := [("projection-law","named-admitted-relation-projection"),("parameter-law","zero-parameter-shared-carrier-projection"),
  ("extension-law","append-only-extension-preserves-existing-projections")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (10+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "complete-cross-property-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["complete-cross-property-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_target_registry",.array [.text targetPath,.text targetHash]),
 ("identity_only_source_manifest",.array [.text manifestPath,.text manifestHash]),
 ("overlap_summary",.array [.text summaryPath,.text summaryHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_9025_target_payloads_hashes_presence_flags_and_orientations_absent_from_prediction",.boolean true),
 ("falsification_condition",.text falsification)])
