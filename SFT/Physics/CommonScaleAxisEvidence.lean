def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
  claimId := "SFT-PHYS-SCALE-COMMON-AXIS-TERMINAL-030"
  title := "Common Fold scale axis and terminal electroweak transport"
  branch := "physics"
  statement := "The One-based Fold scale support is generated uniquely by binary succession R_next=2R, with exact relative spacing One/R and one local carrier act per support cell. The complete prime sectors share this one axis. In the binary electroweak sector, charged holding support (R+1)/(R+2) and neutral half-One force the squared share (R+2)^2/[4(R+1)^2+(R+2)^2], which strictly descends at every binary successor. Complete terminal promotion has support sixteen; holding the three generator directions forces active level thirteen, base 225/1009 and the single terminal alpha return over seventeen already admitted as the exact on-shell result. The source 2+R is a binary Fold power only at support two. Every common exact rational unit rescaling preserves like-dimension ratios, while the admitted proton-Planck relation fixes the physical scale ratio before any dimensional unit name or measured reference is applied post-seal."
  evidenceMode := .empirical
  rootTheorems := [SFT.Engine.rootTheoremId]
  dependencies := ["SFT-FOUNDATION-COUNT-001", "SFT-FOUNDATION-FOLD-DYNAMICS-001", "SFT-MATH-EXACT-ARITHMETIC-001", "SFT-MATH-COMBINATORICS-001", "SFT-PHYS-MEAS-UNIT-COMPARISON-001", "SFT-PHYS-MEAS-DIMENSION-COMPOSITION-001", "SFT-PHYS-SPACETIME-LIMIT-SPEED-001", "SFT-PHYS-FORCE-COMPLETE-SECTOR-INVENTORY-003", "SFT-PHYS-COUPLING-RUNNING-CONVERGENCE-TERMINAL-006", "SFT-PHYS-ELECTROWEAK-FOLD-MIXING-002", "SFT-PHYS-ELECTROWEAK-TERMINAL-ON-SHELL-003", "SFT-PHYS-SCALE-PROTON-PLANCK-TERMINAL-003", "SFT-PHYS-MATTER-QUARK-INVARIANTS-003", "SFT-PHYS-SPACE-DIMENSION-THREE-001", "SFT-PHYS-MEAS-TARGET-CUSTODY-001", "SFT-FOUNDATION-MEASURED-VALUE-BOUNDARY-001"]
  axioms := []
  freeParameters := []
  provenance := [.forwardForcing,.observationalDerivation]
  sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)

def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
  candidateId := candidateId c
  exactForm := exactForm c
  traceHash := exactIdentity (.array [.text "SFT-PHYS-SCALE-COMMON-AXIS-TERMINAL-030",.text generationRule,candidateRecord c])

def censusData : SFT.Engine.CandidateCensus where
  generationRule := generationRule
  grammarBoundary := grammarBoundary
  expectedCardinality := .ofNat candidates.length
  completenessCertificateHash := exactIdentity completenessRecord
  candidates := candidates.map generatedCandidateData

def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
  candidateId := candidateId c
  survives := survives c
  reason := decisionReason c
  proofHash := exactIdentity (.array [.text "SFT-PHYS-SCALE-COMMON-AXIS-TERMINAL-030",.array ((registrationData "").dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])

def decision (c : Candidate) : Value := SFT.Engine.decisionValue (decisionData c)

-- The source CommonScaleAxisProgram indexes the unchanged full product once.
-- Bucket capacity is storage derived from census length, not a model input.
def indexBucketCount : Nat := candidates.length*2+1
def rowIndex : Array (List (String × Candidate)) := candidates.foldl (fun index c =>
 let key := candidateId c
 let bucket := key.hash.toNat % indexBucketCount
 index.set! bucket ((key,c)::index[bucket]!)) (Array.replicate indexBucketCount [])
@[irreducible] def decideIdentifier (id : String) : Except String SFT.Engine.CandidateDecision :=
 match (rowIndex[id.hash.toNat % indexBucketCount]!).find?
   (fun row => SFT.Host.Text.equal row.1 id) with
 | some row => .ok (decisionData row.2)
 | none => .error "KeyError"
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 decideIdentifier candidate.candidateId

def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
  scope := .depthIndependent
  exactBoundary := grammarBoundary
  minimalityPassed := true
  namedShapeUniquenessPassed := true
  proofHash := exactIdentity (.array [CommonScaleAxisControls.closureValue,.array (decisions.map SFT.Engine.decisionValue)])
  generalityCertificateHash := some (exactIdentity CommonScaleAxisControls.closureValue)

def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

theorem nativeDecisionPreservesSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl

theorem nativeDecisionPreservesReason (c : Candidate) : (decisionData c).reason = decisionReason c := rfl

theorem registrationHasNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl

theorem registrationHasNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl

set_option maxRecDepth 20000 in
theorem lookupDependsOnlyOnIdentifier (id formA formB hashA hashB : String) :
    decideCandidate ⟨id,formA,hashA⟩ = decideCandidate ⟨id,formB,hashB⟩ := rfl

end SFT.Physics.CommonScaleAxisEvidence
