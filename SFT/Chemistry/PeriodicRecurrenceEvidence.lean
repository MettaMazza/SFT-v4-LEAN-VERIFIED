import SFT.Chemistry.PeriodicRecurrenceGrammar
import SFT.Engine.RegistrationGate
namespace SFT.Chemistry.PeriodicRecurrenceEvidence
open SFT.Host.Canonical PeriodicRecurrenceGrammar
set_option maxRecDepth 20000

def witnesses : Value := .array [.array [.text "return-equivalence",.text "recurrence requires equality of complete outer traces",.boolean true],.array [.text "successor-path",.text "every return retains its atomic-number path",.boolean true],.array [.text "fixed-period-control",.text "an assumed universal period is rejected",.boolean true]]
def claimId : String := "SFT-CHEM-ELEM-PERIODIC-RECURRENCE-001"
def dependencies : List String := ["SFT-FOUNDATION-FORM-ENFORCEMENT-001","SFT-MATH-EXACT-ARITHMETIC-001","SFT-MATH-ORDER-LATTICE-001","SFT-MATH-DISCRETE-001","SFT-MATH-COMBINATORICS-001","SFT-MATH-LOGIC-PROOF-001","SFT-INFO-SYMBOL-DISTINCTION-001","SFT-INFO-ENCODING-DECODING-001","SFT-INFO-CONSERVATION-LOSS-001","SFT-PHYS-MEAS-OBSERVATION-CARRIER-001","SFT-PHYS-MEAS-VALUE-RECORD-001","SFT-PHYS-FIELD-ELECTRIC-DISTINCTION-001","SFT-PHYS-QUANTUM-DISCRETE-SPECTRA-001","SFT-PHYS-QUANTUM-INDISTINGUISHABILITY-001","SFT-PHYS-QUANTUM-EXCLUSION-001","SFT-PHYS-MATTER-CONSERVED-LABELS-001","SFT-CHEM-MEAS-CHEMICAL-ENTITY-001","SFT-CHEM-ELEM-ELEMENT-001","SFT-CHEM-ELEM-ATOMIC-NUMBER-001","SFT-CHEM-ELEM-PERIODIC-ORDER-001"]
def candidateRecord (c : Candidate) : Value := .object [("candidate_id",.text (candidateId c)),("coordinates",.array [.array [.text "carrier",.text (carrierName c.carrier)],.array [.text "progression",.text (progressionName c.progression)],.array [.text "equivalence",.text (equivalenceName c.equivalence)],.array [.text "closure",.text (closureName c.closure)],.array [.text "occupation",.text (occupationName c.occupation)],.array [.text "periodicity",.text (periodicityName c.periodicity)],.array [.text "record",.text (recordName c.record)],.array [.text "extension",.text (extensionName c.extension)]]),("exact_form",.text (exactForm c))]
def completenessRecord : Value := .object [("claim_id",.text claimId),("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),("dimensions",.array [.array [.text "carrier",.array [.array [.text "property-name-series",.text "A list of property names contains no physical recurrence carrier."],.array [.text "boundary-closed-outer-support",.text "Each class retains its outer accessible support and closure record."]]],.array [.text "progression",.array [.array [.text "mass-selected-progression",.text "Isotope mass does not determine element succession."],.array [.text "atomic-number-successor-progression",.text "The admitted proton-count successor fixes progression."]]],.array [.text "equivalence",.array [.array [.text "visual-column-equivalence",.text "A drawing cannot establish common chemical behavior."],.array [.text "complete-chemical-trace-equivalence",.text "Classes recur only when all registered outer chemical traces agree."]]],.array [.text "closure",.array [.array [.text "unbounded-orbital-continuum",.text "An ungenerated continuum violates the finite exact domain."],.array [.text "finite-bound-state-recurrence",.text "Admitted discrete boundary recurrence supplies finite observable classes."]]],.array [.text "occupation",.array [.array [.text "duplicate-state-without-trace",.text "Unrecorded duplicate occupation violates exclusion."],.array [.text "exclusion-preserving-occupation",.text "Each accessible constituent word preserves its exchange trace."]]],.array [.text "periodicity",.array [.array [.text "assumed-fixed-period",.text "A fixed imported period can manufacture recurrence."],.array [.text "return-of-observation-class",.text "A period closes only when an earlier outer trace class recurs."]]],.array [.text "record",.array [.array [.text "recurrence-label-only",.text "A repeated label does not reproduce the equivalence test."],.array [.text "support-transition-recurrence-trace",.text "Support, transitions and return witness remain held."]]],.array [.text "extension",.array [.array [.text "free-shell-rule",.text "A discretionary shell equation would import the desired organization."],.array [.text "no-extra-rule",.text "Only admitted recurrence, exclusion and trace equivalence select classes."]]]]),("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),("exhaustion",.text "The literal product contains each registered form combination exactly once.")]
def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
 claimId := claimId
 title := "Periodic recurrence of outer chemical organization"
 branch := "chemistry"
 statement := "Periodicity is the return, along atomic-number succession, of an earlier complete outer chemical observation class generated by finite bound-state recurrence and exclusion-preserving occupation."
 evidenceMode := .empirical
 rootTheorems := [SFT.Engine.rootTheoremId]
 dependencies := dependencies
 axioms := []
 freeParameters := []
 provenance := [.forwardForcing]
 sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)
def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
 candidateId := candidateId c
 exactForm := exactForm c
 traceHash := identity (.array [.text claimId,candidateRecord c])
def censusData : SFT.Engine.CandidateCensus where
 generationRule := generationRule
 grammarBoundary := grammarBoundary
 expectedCardinality := .ofNat candidates.length
 completenessCertificateHash := identity completenessRecord
 candidates := candidates.map generatedCandidateData
def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
 candidateId := candidateId c
 survives := survives c
 reason := decisionReason c
 proofHash := identity (.array [.text claimId,.array (dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
 | some c => .ok (decisionData c)
 | none => .error "StopIteration"
def closureValue : Value := .object [("claim_id",.text claimId),("result",.text "boundary-closed-outer-support__atomic-number-successor-progression__complete-chemical-trace-equivalence__return-of-observation-class"),("base",.text "The first repeated complete outer chemical trace at two ordered element coordinates supplies one recurrence class and one finite period witness."),("successor",.text "Appending one ordered element either extends the current nonreturning trace or closes a return to an existing complete class while preserving all prior witnesses."),("exclusions",.array [.text "no IUPAC table arrangement, term definition, measured value, electron-shell equation or V2 answer may select a candidate",.text "no numerical zero, negative, irrational, imaginary or floating proof quantity",.text "no free, fitted, learned or target-derived parameter",.text "no application result or opaque predictor",.text "official target content opens only through post-seal custody",.text "Every generated positive-finite atomic-number successor family whose boundary-closed outer observation support is quotiented only by complete chemical transition equivalence."]),("witnesses",witnesses),("survivor",.text survivorId)]
def exclusions : List String := ["no IUPAC table arrangement, term definition, measured value, electron-shell equation or V2 answer may select a candidate","no numerical zero, negative, irrational, imaginary or floating proof quantity","no free, fitted, learned or target-derived parameter","no application result or opaque predictor","official target content opens only through post-seal custody","Every generated positive-finite atomic-number successor family whose boundary-closed outer observation support is quotiented only by complete chemical transition equivalence."]
def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
 scope := .depthIndependent
 exactBoundary := grammarBoundary
 minimalityPassed := true
 namedShapeUniquenessPassed := true
 proofHash := identity (.array [closureValue,.array (decisions.map SFT.Engine.decisionValue)])
 generalityCertificateHash := some (identity closureValue)
def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

def control (kind : SFT.Engine.ControlKind) (passed : Bool) (observation : String) : SFT.Engine.ControlResult where
 kind := kind
 passed := passed
 expectedBehavior := observation
 observedBehavior := if passed then observation else "control failed"
 receiptHash := identity (.array [.text claimId,.text (SFT.Engine.kindName kind),.boolean passed,.text observation])
def runControls (sourceHash : String) : Value := .array ([
 control .falsePremise (!(SFT.Host.Text.equal (candidateId {survivor with carrier := .rejected}) survivorId)) "reject the generated form lacking the complete physical carrier",
 control .tamperedSource (!(SFT.Host.Text.equal (identity (.object [("changed",.text sourceHash)])) sourceHash)) "reject a changed registered source identity",
 control .tamperedArtifact ((candidates.filter survives).length == 1) "reject a missing, duplicate or additional survivor",
 control .boundary (!exclusions.isEmpty) "reject target access, forbidden proof values, imported laws and free parameters"].map SFT.Engine.controlResultValue)

theorem registrationNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl
theorem registrationNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl
theorem decisionSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl
end SFT.Chemistry.PeriodicRecurrenceEvidence
