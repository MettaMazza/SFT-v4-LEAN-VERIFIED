def sameList (a b : Except String (List String)) : Bool :=
  match a,b with
  | .ok x,.ok y => decide (x = y)
  | .error x,.error y => decide (x = y)
  | _,_ => false
def sameOptimum (result : Except String Optimum) (expected : Except String (List String)) : Bool :=
  match result with
  | .error e => match expected with | .error x => decide (e = x) | .ok _ => false
  | .ok value => match expected with
    | .error _ => false
    | .ok held => match value with
      | .unique label => decide (held = [label])
      | .retainedClass tag items => decide (tag = "retained-equivalence-class") && decide (items = held) && !(held.length == 1)
