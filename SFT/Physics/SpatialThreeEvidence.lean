import SFT.Physics.SpatialThreeControls
import SFT.Engine.RegistrationGate
namespace SFT.Physics.SpatialThreeEvidence
open SFT.Host.Canonical SpatialThreeGrammar

def candidateRecord (c : Candidate) : SFT.Host.Canonical.Value := .object [
 ("candidate_id",.text (candidateId c)),
 ("coordinates",.array [.array [.text "carrier",.text (carrierName c.carrier)],.array [.text "lower",.text (lowerName c.lower)],.array [.text "upper",.text (upperName c.upper)],.array [.text "interval",.text (intervalName c.interval)],.array [.text "census",.text (censusName c.census)],.array [.text "value",.text (valueName c.value)],.array [.text "crosslock",.text (crosslockName c.crosslock)],.array [.text "measurement",.text (measurementName c.measurement)],.array [.text "extension",.text (extensionName c.extension)]]),
 ("exact_form",.text (exactForm c))]

