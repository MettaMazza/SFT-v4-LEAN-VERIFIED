import SFT.Chemistry.MolecularMeasurement
open SFT.Chemistry.MolecularMeasurement SFT.Host.Canonical
def m : Observation := ⟨⟨"prepared-molecular-state","v",by rfl,by rfl⟩,⟨"molecular-observation-class","v",by rfl,by rfl⟩,[⟨"retained-molecular-coordinate","r",by rfl,by rfl⟩],[⟨"closed-molecular-coordinate","c",by rfl,by rfl⟩],⟨"molecular-readout-record","v",by rfl,by rfl⟩,⟨"post-observation-molecular-state","v",by rfl,by rfl⟩,⟨"measurement-instrument","v",by rfl,by rfl⟩,⟨"measurement-condition","v",by rfl,by rfl⟩⟩
def outcome (name : String) (o : Observation) : Value := match validate o with
 | .error e => .object [("name",.text name),("accepted",.boolean false),("error",.text e)]
 | .ok r => .object [("name",.text name),("accepted",.boolean true),("reconstructs",.array (["r","c","missing"].map (fun k => .boolean (reconstructs r k))))]
def main : IO Unit := IO.println (render (.array [outcome "valid" (m),outcome "prepared_state" ({m with preparedState:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "probe_class" ({m with probeClass:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "outcome_record" ({m with outcomeRecord:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "post_observation_state" ({m with postObservationState:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "instrument" ({m with instrument:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "condition" ({m with condition:=⟨"wrong","v",by rfl,by rfl⟩}),outcome "empty-retained" ({m with retainedCoordinates:=[]}),outcome "empty-closed" ({m with closedCoordinates:=[]}),outcome "overlap" ({m with closedCoordinates:=[⟨"closed-molecular-coordinate","r",by rfl,by rfl⟩]}),outcome "duplicate-retained" ({m with retainedCoordinates:=m.retainedCoordinates++m.retainedCoordinates}),outcome "duplicate-closed" ({m with closedCoordinates:=m.closedCoordinates++m.closedCoordinates}),outcome "wrong-retained-family" ({m with retainedCoordinates:=[⟨"closed-molecular-coordinate","r",by rfl,by rfl⟩]}),outcome "wrong-closed-family" ({m with closedCoordinates:=[⟨"retained-molecular-coordinate","c",by rfl,by rfl⟩]})]))
