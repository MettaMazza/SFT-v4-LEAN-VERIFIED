 | row::rest => {row with observed := VacuumLedgerProofs.wholeRatio 1000}::rest
def tamperedRun : Except String (Option Certificate) := do
 let rows ← prepareRows tamperedObservations 1
 runWithin h0 h0Uncertainty 4 0 rows
def tamperedCertificate : Certificate := ⟨32,0,(normalize (186917875600000) 3074790443963 (by decide)),(normalize ()  (by decide)),false,true,true⟩
