def numberView : Number → String × Nat × Nat | .zero => ("zero",0,1) | .positive p => ("positive",p.numerator,p.denominator) | .negative p => ("negative",p.numerator,p.denominator)
def normalView (result : Except String Expr) : Except String (Option (String × Nat × Nat)) := result.map fun e => match e with | .value (some n) => some (numberView n) | .value none => none | .name _ => none | .join _ _ => none | .outside _ => none
