def renderBool : Except String Bool → String
  | .ok true => "true"
  | .ok false => "false"
  | .error e => e
def renderMates : Except String (Option (List (String × String))) → String
  | .ok none => "none"
  | .ok (some rows) => "some:" ++ String.intercalate ";" (rows.map (fun p => p.1 ++ "=" ++ p.2))
  | .error e => e
