import SFT.Host.Text
namespace SFT.Biology.Compartment
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-COMPARTMENT-001","Biological compartment","compartment_identity","boundary-and-content-carrier","boundary-separates-content-classes","inside-outside-distinction-held","resolution-declared","A biological compartment is a connected boundary that retains distinguishable internal and external content classes together with every permitted transfer path."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.Compartment
