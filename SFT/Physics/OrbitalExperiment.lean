import SFT.Physics.OrbitalPrediction
import SFT.Physics.OrbitalRecords
namespace SFT.Physics.OrbitalExperiment
open SFT.Host SFT.Host.Canonical OrbitalPrediction OrbitalRecords RunningConvergenceMeasurement
open SFT.Foundation.AdmissionControls (admissionIdentity)
set_option maxRecDepth 100000
def targetIds : List String := ["D9F-WITHHELD-ORBITAL-STABILITY-RECORD"]
def frozenRelation : String := "Positive denominator ordering between q^(d-1) gravity and q^3 centrifugal response uniquely partitions all orbital dimensions."
def falsification : String := "Reject if either Cambridge source or the source record changes; if any force-power, balance, perturbation, stability, dimension, marginal, unstable-family, potential or effective-potential row is omitted; if the exact positive-magnitude census differs; if dimension one is silently admitted; if a signed force, negative exponent, measured fit or free correction enters proof; or if targets enter before sealing."
