1e8206d509654ff838f"],.array [.text "C14967783-energy-004",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state row 4 :: Te",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-energy-005",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state row 5 :: Te",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-energy-006",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state row 6 :: Te",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"],.array [.text "C14967783-energy-007",.text "NIST-CHEMISTRY-WEBBOOK-SRD69-DIATOMIC-CONSTANTS-2025",.text "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14967783&Mask=1000 :: state row 7 :: Te",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C14967783.html",.text "sha256:0cba4791e76291360b020efca7e6333e8fbda6681bebb1e8206d509654ff838f"]]),
 ("target_content_absent_from_prediction",.boolean true),
 ("all_306_values_required",.boolean true),
 ("falsification_condition",.text "The claim fails if any declared finite molecular state support lacks one unique least state; if an excited state lacks a positive successor or retained positive gap; if any pair is incomparable or contradictory; if the source-designated X state is not the unique least orderable NIST state for any registered species; if any of the 284 excited-state values does not lie above its species ground record; if any of the 306 exact measured energy inscriptions, uncertainty-status labels or source identities is omitted; or if a tied ground, negative gap, omitted row, unit-confounded row or tampered source is accepted.")]
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (references.map fun row => .text row.targetId)),
 ("frozen_relation_hash",.text derivationSeal),("experiment_registration_hash",.text registrationHash)]
def specDimensions : List (String × List Bool) := [("carrier",[false,true]),("identity",[false,true]),("least",[false,true]),("excitation",[false,true]),("order",[false,true]),("gap",[false,true]),("record",[false,true]),("extension",[false,true])]
def specWitnesses : List Bool := [StateEnergyOrder.groundWitness,StateEnergyOrder.excitationWitness,StateEnergyOrder.duplicateGroundWitness,StateEnergyOrder.missingSuccessorWitness]
def validateSpec : Except String Unit := do
 if !(Text.chars "SFT-CHEM-").isPrefixOf (Text.chars claimId) then
  .error "empirical Chemistry claim identity is invalid"
 else if !(Text.chars "SFT-EXP-CHEM-").isPrefixOf (Text.chars experimentId) then
  .error "empirical Chemistry experiment identity is invalid"
 else if StateEnergyOrderEvidence.dependencies.isEmpty || specDimensions.length != 8 || references.isEmpty then
  .error "empirical Chemistry law lacks dependencies, eight dimensions or targets"
 else if !SourceExtraction.unique (specDimensions.map Prod.fst) then
  .error "empirical Chemistry law contains duplicate dimensions"
 else if !(specDimensions.all (fun d => d.2.length == 2)) then
  .error "each Chemistry dimension must exhaust two registered forms"
 else if !(specDimensions.all (fun d => (d.2.filter id).length == 1)) then
  .error "dimension requires one preserving form"
 else if !SourceText.nonblank expectedLabel || !SourceText.nonblank falsification then
  .error "Chemistry prediction or falsification condition is missing"
 else if !SourceExtraction.unique (references.map Reference.targetId) then
  .error "Chemistry target identities are duplicated"
 else if references.any (fun row => !(Text.chars "sha256:").isPrefixOf (Text.chars row.snapshotHash)) then
  .error "Chemistry target snapshot identity is invalid"
 else if !(specWitnesses.all id) then
  .error "Chemistry operational witness failed"
 else .ok ()

#print axioms claimId
#print axioms experimentId
#print axioms frozenRelation
#print axioms falsification
#print axioms expectedLabel
#print axioms identityRegistryPath
#print axioms identityRegistryHash
#print axioms targetRegistryPath
#print axioms targetRegistryHash
#print axioms references
#print axioms registration
#print axioms labelValue
#print axioms envelope
#print axioms specDimensions
#print axioms specWitnesses
#print axioms validateSpec
end SFT.Chemistry.StateEnergyOrderExperiment
