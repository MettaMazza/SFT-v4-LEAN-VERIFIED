def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "THERMO-013 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["component_orgnums","complete_component_records","phase_ids","temperature_K_external_inscription","pressure_kPa_external_inscription","liquid_reported_mole_fraction_external_inscription","gas_reported_mole_fraction_external_inscription","liquid_component_1_mole_fraction_external_inscription","liquid_component_2_mole_fraction_external_inscription","gas_component_1_mole_fraction_external_inscription","gas_component_2_mole_fraction_external_inscription","complete_point_record","target_payload","target_payload_hash"]
 if !sameValue (get document "complete_target_count") (.integer 116) ||
  !sameValue (get document "binary_target_count") (.integer 65) ||
  !sameValue (get document "ternary_target_count") (.integer 51) ||
  !sameValue (get document "all_compound_phase_temperature_pressure_composition_uncertainty_and_target_hash_values_absent") (.boolean true) ||
  rows.length != 116 || rows.any (fun row => forbidden.any (hasKey row)) then
  throw "THERMO-013 value-free identity boundary changed"
 pure rows
def identityString (value : Value) : Except String String := match value with
 | .text s => pure s
 | .integer (.ofNat n) => pure (toString n)
 | .integer (.negSucc n) => pure (Text.append "-" (toString (n+1)))
 | .boolean b => pure (if b then "True" else "False")
 | .null => pure "None"
 | .array _ | .object _ => throw "registered finite-microstate identity field is not scalar"
def identityFields : List (String × String) := [("doi","source-doi"),("source_id","complete-source-identity"),("dataset_class","dataset-class"),("dataset_ordinals","dataset-ordinals"),("source_point_ordinal","positive-source-point-ordinal")]
def identityValue (row : Value) (key : String) : Except String String := do
 if Text.equal key "dataset_ordinals" then
  let values ← field row key >>= RunningConvergenceMeasurement.array
  pure (Text.intercalate "," (← values.mapM identityString))
 else field row key >>= identityString
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "multicomponent-phase-row-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← identityValue row key
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let laws := [("composition-law","complete-exact-phase-composition-pair"),("exchange-law","componentwise-exchange-support-balance"),("degree-law","exact-phase-rule-component-count-support"),("record-law","finite-source-ordered-record-with-EmptyOne-boundary")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (6+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "complete-multicomponent-phase-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["complete-multicomponent-phase-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation_with_prefetch_value_free_identity_seal"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_target_registry",.array [.text targetPath,.text targetHash]),
 ("primary_source_record",.array [.text primaryPath,.text primaryHash]),
 ("complete_raw_source",.array [.text rawPath,.text rawHash]),("source_landing_record",.array [.text landingPath,.text landingHash]),("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_compound_phase_temperature_pressure_composition_uncertainty_and_target_hash_values_absent",.boolean true),
 ("falsification_condition",.text falsification)])
