k.nist.gov/cgi/cbook.cgi?ID=C1333740&Mask=1000 :: primary-state 46",.text "experiments/external_sources/chemistry/snapshots/electron-spin-v1/C1333740.html",.text "sha256:410fae804b1fa35ab72d829d95bd3b26c831dde2f0ec0078b614fea2c87d795e"]]),("target_content_absent_from_prediction",.boolean true),("all_sixty_records_required",.boolean true),("selection_rules_explicitly_not_imported",.boolean true),("falsification_condition",.text "The claim fails if a transition loses its carrier, either endpoint, orientation or record; if unequal endpoints compose; if absence is treated numerically; if a selection rule is imported to define transformation before ELEC-010; if any of 46 primary rows, 14 continuation rows, 55 directional records, four coupled-state records, one absent transition coordinate, 55 positive band inscriptions or five absent band coordinates is omitted, changed or reclassified.")]
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (references.map fun row => .text row.targetId)),
 ("frozen_relation_hash",.text derivationSeal),("experiment_registration_hash",.text registrationHash)]
def specDimensions : List (String × List Bool) := [("carrier",[false,true]),("endpoints",[false,true]),("orientation",[false,true]),("absence",[false,true]),("trace",[false,true]),("composition",[false,true]),("record",[false,true]),("extension",[false,true])]
def specWitnesses : List Bool := [MolecularStateTransition.observedWitness,MolecularStateTransition.composedWitness,MolecularStateTransition.absentWitness,MolecularStateTransition.mismatchWitness,MolecularStateTransition.selfWitness]
def validateSpec : Except String Unit := do
 if !(Text.chars "SFT-CHEM-").isPrefixOf (Text.chars claimId) then
  .error "empirical Chemistry claim identity is invalid"
 else if !(Text.chars "SFT-EXP-CHEM-").isPrefixOf (Text.chars experimentId) then
  .error "empirical Chemistry experiment identity is invalid"
 else if MolecularStateTransitionEvidence.dependencies.isEmpty || specDimensions.length != 8 || references.isEmpty then
  .error "empirical Chemistry law lacks dependencies, eight dimensions or targets"
 else if !SourceExtraction.unique (specDimensions.map Prod.fst) then
  .error "empirical Chemistry law contains duplicate dimensions"
 else if !(specDimensions.all (fun d => d.2.length == 2)) then
  .error "each Chemistry dimension must exhaust two registered forms"
 else if !(specDimensions.all (fun d => (d.2.filter id).length == 1)) then
  .error "dimension requires one preserving form"
 else if !SourceText.nonblank expectedLabel || !SourceText.nonblank falsification then
  .error "Chemistry prediction or falsification condition is missing"
 else if !SourceExtraction.unique (references.map SourceExtraction.Reference.targetId) then
  .error "Chemistry target identities are duplicated"
 else if references.any (fun row => !(Text.chars "sha256:").isPrefixOf (Text.chars row.snapshotHash)) then
  .error "Chemistry target snapshot identity is invalid"
 else if !(specWitnesses.all id) then
  .error "Chemistry operational witness failed"
 else .ok ()

end SFT.Chemistry.StateTransitionExperiment
