import SFT.Physics.SpacetimeAdmissibility
open SFT.Physics SFT.Host.Canonical
def main : IO Unit := do
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨1,4,by decide,by decide⟩) true true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨1,4,by decide,by decide⟩) false true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨1,4,by decide,by decide⟩) true false)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨1,4,by decide,by decide⟩) false false)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨0,1,by decide,by decide⟩) true true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨-1,1,by decide,by decide⟩) true true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible .nonFraction true true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.wormholeAdmissible (.fraction ⟨3,1,by decide,by decide⟩) true true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨1,4,by decide,by decide⟩) (.fraction ⟨1,4,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨1,4,by decide,by decide⟩) (.fraction ⟨1,2,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨1,4,by decide,by decide⟩) (.fraction ⟨1,4,by decide,by decide⟩) false)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨0,1,by decide,by decide⟩) (.fraction ⟨0,1,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨-1,1,by decide,by decide⟩) (.fraction ⟨-1,1,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible .nonFraction (.fraction ⟨1,4,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨1,4,by decide,by decide⟩) .nonFraction true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.warpAdmissible (.fraction ⟨3,1,by decide,by decide⟩) (.fraction ⟨3,1,by decide,by decide⟩) true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible ["state", "proof"] ["state", "proof"] true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible ["state", "proof"] ["changed-state", "proof"] true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible ["state", "proof"] ["state", "proof"] false)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible [] [] true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible ["state"] ["state", "proof"] true)))
 IO.println (render (.boolean (SpacetimeAdmissibility.closedTimelikeAdmissible ["state", "proof"] ["state", "changed-proof"] true)))
