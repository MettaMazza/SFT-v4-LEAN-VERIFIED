import SFT.Host.Text
namespace SFT.Biology.Selection
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-SELECTION-001","Selection","variation_evolution","heritable-variant-population","variant-linked-differential-continuation","competing-lineages-and-environment-held","finite-generation-test","Selection is the recurrence of a heritable variant together with reproducible differential continuation relative to registered alternatives under a declared environment."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.Selection
