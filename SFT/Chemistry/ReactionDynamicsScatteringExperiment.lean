def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "KIN-013 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["target_payload", "target_payload_hash", "angle", "speed", "energy", "branching", "experimental", "theoretical", "fit", "normalization", "estimate", "tentative", "background", "control", "limitation", "adverse", "reviewer", "status", "value"]
 if !sameValue (get document "complete_registered_target_count") (.integer 51) ||
  !sameValue (get document "complete_pdf_page_count") (.integer 36) ||
  !sameValue (get document "complete_article_pdf_page_count") (.integer 9) ||
  !sameValue (get document "complete_supplementary_information_page_count") (.integer 11) ||
  !sameValue (get document "complete_transparent_peer_review_page_count") (.integer 16) ||
  !sameValue (get document "complete_source_data_worksheet_count") (.integer 14) ||
  !sameValue (get document "target_values_or_hashes_present") (.boolean false) ||
  !sameValue (get document "all_incoming_outgoing_channel_product_state_angle_speed_energy_branching_experimental_theoretical_fit_normalization_estimate_tentative_background_control_limitation_adverse_reviewer_status_value_and_target_hash_values_absent") (.boolean true) ||
  rows.length != 51 || rows.any (fun row=>forbidden.any (hasKey row)) then
  throw "KIN-013 value-free identity boundary changed"
 let ordinals ← rows.mapM fun row=>field row "source_record_ordinal"
 let ids ← rows.mapM fun row=>field row "target_id"
 if !(ordinals.zipIdx.all fun (v,i)=>sameValue v (.integer (i+1))) ||
  (ids.foldl (fun found x=>if found.any (sameValue x) then found else found++[x]) []).length != 51 then
  throw "KIN-013 value-free identity boundary changed"
 pure rows
def identityString (value : Value) : Except String String := match value with
 | .text s => pure s
 | .integer (.ofNat n) => pure (toString n)
 | .integer (.negSucc n) => pure (Text.append "-" (toString (n+1)))
 | .boolean b => pure (if b then "True" else "False")
 | .null => pure "None"
 | .array _ | .object _ => throw "registered finite-microstate identity field is not scalar"
