 ("target_content_absent_from_prediction",.boolean true),
 ("target_inaccessible_to_capability_closed_execution",.boolean true),
 ("all_46_states_and_14_pairs_required",.boolean true),
 ("energy_order_not_used_to_select_or_define_law",.boolean true),
 ("absence_glyph_policy",.text "source glyph 0 denotes an absence baseline only and is never an SFT number"),
 ("falsification_condition",.text "The claim fails if a molecular electron pair is not exchange-equivalent; if its total exchange is not alternating; if a positive One-width spin sector is not paired with preserving spatial exchange; if a positive three-width spin sector is not paired with alternating spatial exchange; if a same-cell pair is accepted in the alternating spatial sector; if any of 46 NIST H2 states, 25 singlets, 21 triplets, two explicit same-cell singlet records, 14 same-configuration exchange pairs, 13 triplet-below-singlet records or the one retained opposite-order record is omitted or altered; if any positive measured separation is replaced by a fitted value; or if source glyph 0 is treated as a number rather than absence.")]
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (references.map fun row => .text row.targetId)),
 ("frozen_relation_hash",.text derivationSeal),("experiment_registration_hash",.text registrationHash)]
def specDimensions : List (String × List Bool) := [("carrier",[false,true]),("identity",[false,true]),("total",[false,true]),("spin",[false,true]),("composition",[false,true]),("same_cell",[false,true]),("record",[false,true]),("extension",[false,true])]
def specWitnesses : List Bool := [PairExchangeWitnesses.singletSector,PairExchangeWitnesses.tripletSector,PairExchangeWitnesses.alternatingTotal,PairExchangeWitnesses.sameSupportPair,PairExchangeWitnesses.sameCellControl,PairExchangeWitnesses.thirdOccurrenceControl]
def validateSpec : Except String Unit := do
 if !(Text.chars "SFT-CHEM-").isPrefixOf (Text.chars claimId) then
  .error "empirical Chemistry claim identity is invalid"
 else if !(Text.chars "SFT-EXP-CHEM-").isPrefixOf (Text.chars experimentId) then
  .error "empirical Chemistry experiment identity is invalid"
 else if PairExchangeEvidence.dependencies.isEmpty || specDimensions.length != 8 || references.isEmpty then
  .error "empirical Chemistry law lacks dependencies, eight dimensions or targets"
 else if !SourceExtraction.unique (specDimensions.map Prod.fst) then
  .error "empirical Chemistry law contains duplicate dimensions"
 else if !(specDimensions.all (fun d => d.2.length == 2)) then
  .error "each Chemistry dimension must exhaust two registered forms"
 else if !(specDimensions.all (fun d => (d.2.filter id).length == 1)) then
  .error "dimension requires one preserving form"
 else if !SourceText.nonblank expectedLabel || !SourceText.nonblank falsification then
  .error "Chemistry prediction or falsification condition is missing"
 else if !SourceExtraction.unique (references.map Reference.targetId) then
  .error "Chemistry target identities are duplicated"
 else if references.any (fun row => !(Text.chars "sha256:").isPrefixOf (Text.chars row.snapshotHash)) then
  .error "Chemistry target snapshot identity is invalid"
 else if !(specWitnesses.all id) then
  .error "Chemistry operational witness failed"
 else .ok ()

#print axioms claimId
#print axioms experimentId
#print axioms frozenRelation
#print axioms falsification
#print axioms expectedLabel
#print axioms sourceId
#print axioms identityRegistryPath
#print axioms identityRegistryHash
#print axioms targetRegistryPath
#print axioms targetRegistryHash
#print axioms references
#print axioms registration
#print axioms labelValue
#print axioms envelope
#print axioms specDimensions
#print axioms specWitnesses
#print axioms validateSpec
end SFT.Chemistry.PairExchangeExperiment
