def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "KIN-009 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["target_payload", "target_payload_hash", "complete_extracted_page_text", "complete_frame_hashes", "complete_member_hash", "state_pair", "direction", "time", "composition", "rate", "energy", "uncertainty"]
 if !sameValue (get document "complete_registered_target_count") (.integer 164) ||
  !sameValue (get document "complete_primary_article_page_count") (.integer 10) ||
  !sameValue (get document "complete_supplementary_information_page_count") (.integer 144) ||
  !sameValue (get document "complete_additional_description_page_count") (.integer 1) ||
  !sameValue (get document "complete_supplementary_movie_count") (.integer 1) ||
  !sameValue (get document "complete_source_data_archive_member_count") (.integer 8) ||
  !sameValue (get document "target_values_or_hashes_present") (.boolean false) ||
  !sameValue (get document "all_state_pair_direction_time_equilibrium_composition_rate_quantum_yield_condition_uncertainty_fit_calculation_status_value_and_target_hash_values_absent") (.boolean true) ||
  rows.length != 164 || rows.any (fun row=>forbidden.any (hasKey row)) then
  throw "KIN-009 value-free identity boundary changed"
 let ordinals ← rows.mapM fun row=>field row "source_record_ordinal"
 let ids ← rows.mapM fun row=>field row "target_id"
 if !(ordinals.zipIdx.all fun (v,i)=>sameValue v (.integer (i+1))) ||
  (ids.foldl (fun found x=>if found.any (sameValue x) then found else found++[x]) []).length != 164 then
  throw "KIN-009 value-free identity boundary changed"
 pure rows
def identityString (value : Value) : Except String String := match value with
 | .text s => pure s
 | .integer (.ofNat n) => pure (toString n)
 | .integer (.negSucc n) => pure (Text.append "-" (toString (n+1)))
 | .boolean b => pure (if b then "True" else "False")
 | .null => pure "None"
 | .array _ | .object _ => throw "registered finite-microstate identity field is not scalar"
def identityFields : List (String × String) := [("source_id","registered-source-identity"),("article_doi","registered-source-identity"),("reversible_system_identity","registered-source-identity"),("source_document_identity","registered-source-identity"),("source_page_ordinal","registered-source-identity"),("source_record_class","registered-source-identity"),("source_record_identity","registered-source-identity"),("source_record_ordinal","registered-source-identity")]
def identityValue (row : Value) (key : String) : Except String String := field row key >>= identityString
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "reversible-kinetic-equilibrium-record-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← identityValue row key
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let laws := [("same-graph-law","forward-and-reverse-edges-close-one-exact-retained-state-pair"),("kinetic-equilibrium-law","directed-edge-word-and-recurrence-support-are-two-views-of-the-same-graph"),("complete-status-law","all-direction-composition-condition-adverse-and-disagreement-records-retained"),("complete-custody-law","all-164-article-supplement-movie-and-archive-records-retained")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (9+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "complete-reversible-kinetic-equilibrium-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["complete-reversible-kinetic-equilibrium-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
