def registration (program : Value) : Value := .object [
 ("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("input_registry_path",.text inputRegistryPath),("input_registry_hash",.text inputRegistryHash),
 ("withheld_target_registry_path",.text targetRegistryPath),("withheld_target_registry_hash",.text targetRegistryHash),
 ("prediction_program",program),
 ("target_references",.array (references.map fun row => .array [.text row.targetId,.text row.sourceId,.text row.sourceLocator,.text row.snapshotPath,.text row.snapshotHash])),
 ("target_content_absent_from_prediction_program",.boolean true),
 ("target_inaccessible_to_capability_closed_execution",.boolean true),
 ("all_neutral_cation_anion_rows_required",.boolean true),
 ("falsification_condition",.text falsification)]
def labelValue (family label : String) : Value := .object [("family",.text family),("label",.text label)]
def envelope (registrationHash derivationSeal : String) : Value := .object [
 ("experiment_id",.text experimentId),
 ("registered_inputs",.object [("registered-premise",.text (identity (labelValue "sealed-derivation" derivationSeal)))]),
 ("withheld_target_ids",.array (references.map fun row => .text row.targetId)),
 ("frozen_relation_hash",.text derivationSeal),("experiment_registration_hash",.text registrationHash)]
