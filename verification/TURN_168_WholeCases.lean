def wholeResult : Except String (List ProbabilityRow) → Except String Bool
 | .error e => .error e | .ok rows => .ok (probabilityWhole rows)
def same (a b : Except String Bool) : Bool := match a with
 | .error e => match b with | .error f => decide (e=f) | .ok _ => false
 | .ok x => match b with | .error _ => false | .ok y => decide (x=y)
