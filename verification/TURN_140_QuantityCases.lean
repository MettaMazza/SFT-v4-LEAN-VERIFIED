def pairEq (a b : Except String (List Pair)) : Bool := match a,b with
 | .ok x,.ok y => decide (x = y)
 | .error x,.error y => decide (x = y)
 | _,_ => false
def profileEq (a b : Except String Profile) : Bool := match a,b with
 | .ok x,.ok y => decide (x.supportTrace = y.supportTrace) && decide (x.observationClasses = y.observationClasses) && decide (x.retainedDistinctions = y.retainedDistinctions) && decide (x.closedDistinctions = y.closedDistinctions)
 | .error x,.error y => decide (x = y)
 | _,_ => false
