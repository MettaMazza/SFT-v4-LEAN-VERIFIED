theorem completeOriginalCertificate : originalRun = .ok (some originalCertificate) := rfl
theorem completeOriginalSourceRun :
 ∃ rows, prepareRows observations 1 = .ok rows ∧ SourceRun h0 h0Uncertainty 0 rows originalCertificate := by
 have h := completeOriginalCertificate
 unfold originalRun at h
 generalize he : prepareRows observations 1 = prepared at h
 cases prepared with
 | error e => cases h
 | ok rows =>
  exact ⟨rows,rfl,sourceRunCorrespondence h0 h0Uncertainty 4 0 rows originalCertificate h⟩

def tamperedObservations : List Observation := match observations with
