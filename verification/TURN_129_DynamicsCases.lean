  for (states,edges,expected) in validCases do
    unless validDynamics states edges == expected do throw (IO.userError "dynamics admission mismatch")
  for (edges,trace,expected) in trajectoryCases do
    unless trajectoryValid edges trace == expected do throw (IO.userError "trajectory mismatch")
  for (edges,target,fixed,predecessors) in recordCases do
    unless decide (fixedForms edges = fixed) do throw (IO.userError "fixed forms mismatch")
    unless decide (predecessorRecords edges target = predecessors) do throw (IO.userError "predecessor mismatch")
  for (edges,retained,expected) in reversalCases do
    unless reversibleWithRecord edges retained == expected do throw (IO.userError "record reversal mismatch")
  for (trace,expected) in timeCases do
    unless sameTime (transitionTime trace) expected do throw (IO.userError "time mismatch")
  IO.println s!"PASS: {validCases.length} admission; {trajectoryCases.length} trajectory; {recordCases.length} fixed/predecessor; {reversalCases.length} reversal; {timeCases.length} time cases"
