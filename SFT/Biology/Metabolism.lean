import SFT.Host.Text
namespace SFT.Biology.Metabolism
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-METABOLISM-001","Metabolic network","metabolism_resource","complete-transformation-network","resource-to-product-transition","catalyst-content-and-boundary-ledger","condition-and-time-bounded","Metabolism is a compartment-bound transformation network that records every resource, product, catalyst, transfer and retained constituent relation required for maintenance."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.Metabolism
