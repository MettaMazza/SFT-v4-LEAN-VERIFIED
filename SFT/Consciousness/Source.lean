def claimCount : Nat := 72
private def objectEntries : Value → Except String (List (String × Value))
 | .object xs => .ok xs
 | .null | .text _ | .boolean _ | .integer _ | .array _ => .error "source object expected"
private def arrayEntries : Value → Except String (List Value)
 | .array xs => .ok xs
 | .null | .text _ | .boolean _ | .integer _ | .object _ => .error "source array expected"
private def required (payload : Value) (key : String) : Except String Value :=
 if hasField payload key then .ok (field payload key)
 else .error (Text.append "KeyError: " key)
private def number : Value → Except String Int
 | .integer n => .ok n
 | .boolean b => .ok (if b then 1 else 0)
 | .null | .text _ | .array _ | .object _ => .error "source count expected"
private def isTrue : Value → Bool
 | .boolean b => b
 | .null | .text _ | .integer _ | .array _ | .object _ => false
private def truthy : Value → Bool
 | .null => false
 | .boolean b => b
 | .integer n => !(Text.equal (render (.integer n)) "0")
 | .text s => !(Text.equal s "")
 | .array xs => !xs.isEmpty
 | .object xs => !xs.isEmpty

def verifyIdentityPayload (payload : Value) (key path : String) : Except String Value := do
 let claimed ← required payload key
 let entries ← objectEntries payload
 let content := Value.object (entries.filter (fun x => !Text.equal x.1 key))
 if !Text.equal (identity content) (string claimed) then
  throw (Text.append "identity mismatch: " path)
 return payload

def validatePreSourceSeal (payload : Value) (files : List Snapshot) : Except String String := do
 let claimed ← required payload "complete_branch_pre_source_seal_hash"
 let entries ← objectEntries payload
 let content := Value.object (entries.filter (fun x => !Text.equal x.1 "complete_branch_pre_source_seal_hash"))
 if !Text.equal (identity content) (string claimed) then throw "Consciousness pre-source seal payload changed"
 if !(isFalse (field payload "external_source_identities_selected")) || !(isFalse (field payload "external_outcomes_opened")) then
  throw "Consciousness derivation was not sealed before source selection"
 if !(integerEqual (field payload "required_claim_count") claimCount) then throw "Consciousness pre-source claim count changed"
 if !(integerEqual (field payload "candidate_count") (claimCount*256)) then throw "Consciousness pre-source candidate count changed"
 if !Text.equal (string (field payload "claim_prediction_set_hash")) (identity predictionSet) then throw "Consciousness sealed prediction set changed"
 let sealed ← required payload "sealed_files" >>= objectEntries
 let _ ← sealed.mapM fun (path,wanted) => do
  let bytes ← readSnapshot files path
  if !Text.equal (bytesHash bytes) (string wanted) then throw (Text.append "Consciousness pre-source file changed: " path)
  pure ()
 return string claimed

def validateExternalEvidence (root : String) (audit targets : Value) (files : List Snapshot) : Except String (Value × Value) := do
 let audit ← verifyIdentityPayload audit "audit_hash" (Text.intercalate "/" [root,"experiments/consciousness/source_feature_audit.json"])
 let targets ← verifyIdentityPayload targets "targets_hash" (Text.intercalate "/" [root,"experiments/consciousness/claim_specific_external_targets.json"])
 let auditBytes ← readSnapshot files "experiments/consciousness/source_feature_audit.json"
 if !Text.equal (string (field targets "source_feature_audit_file_hash")) (bytesHash auditBytes) then
  throw "Consciousness target record binds a different feature-audit file"
 if !Text.equal (string (field targets "source_feature_audit_hash")) (string (field audit "audit_hash")) then
  throw "Consciousness target record binds a different feature-audit identity"
 if !(integerEqual (field targets "claim_count") claimCount) || !(integerEqual (field targets "passed_claim_count") claimCount) then
  throw "Consciousness target record is incomplete or unresolved"
 let unresolved ← required targets "unresolved_claim_count" >>= number
 if !(Text.equal (render (.integer unresolved)) "0") then
  throw "an unresolved external target cannot be silently admitted"
 let present ← required audit "present_feature_count" >>= number
 let absent ← required audit "absent_feature_count" >>= number
 let registered ← required audit "registered_feature_count" >>= number
 if !(Text.equal (render (.integer (Int.add present absent))) (render (.integer registered))) then throw "Consciousness feature accounting is incomplete"
 let manifests ← required audit "manifest_hashes" >>= objectEntries
 let _ ← manifests.mapM fun (path,wanted) => do
  let bytes ← readSnapshot files path
  if !Text.equal (bytesHash bytes) (string wanted) then throw (Text.append "Consciousness capture manifest changed: " path)
  pure ()
 let sources ← required audit "sources" >>= arrayEntries
 let _ ← sources.mapM fun source => do
  let transports ← required source "transport_history" >>= arrayEntries
  let _ ← transports.mapM fun transport => do
   let path := field transport "snapshot_path"
   let wanted := field transport "snapshot_hash"
   if truthy path && truthy wanted then
    let bytes ← readSnapshot files (string path)
    if !Text.equal (bytesHash bytes) (string wanted) then throw (Text.append "Consciousness source snapshot changed: " (string path))
   pure ()
  pure ()
 return (audit,targets)

def targetRow (root claimId targetId expectedLabel : String) (audit targets : Value)
 (files : List Snapshot) : Except String (Value × String) := do
 let (audit,targets) ← validateExternalEvidence root audit targets files
 let rows ← required targets "targets" >>= arrayEntries
 let row ← match rows.find? (fun row => Text.equal (string (field row "claim_id")) claimId) with
  | some row => pure row
  | none => throw "StopIteration"
 if !Text.equal (string (field row "target_id")) targetId || !Text.equal (string (field row "expected_label")) expectedLabel then
  throw "Consciousness external target binding changed"
 if !Text.equal (string (field row "observed_label")) (string (field row "expected_label")) || !(isTrue (field row "exact_match")) then
  throw "Consciousness external consequence is unresolved or adverse"
 if !(isFalse (field row "phenomenal_occurrence_directly_observed_by_third_person")) then
  throw "third-person evidence was relabelled as direct phenomenal access"
 if !(isFalse (field row "formal_structure_relabelled_as_empirical_phenomenal_fact")) then
  throw "formal structure was relabelled as an empirical phenomenal fact"
 return (row,identity (.array [field audit "audit_hash",field targets "targets_hash",row]))
end SFT.Consciousness.Source
