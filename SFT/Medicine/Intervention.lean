import SFT.Host.Text
namespace SFT.Medicine.Intervention
structure Obligation where
 claimId : String
 title : String
 family : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-MED-INTERVENTION-001","Clinical intervention","intervention_comparator_counterfactual","patient-directed-action","action-to-course-transition","content-delivery-and-adherence","eligibility-setting-time-and-provider","An intervention is a completely specified patient-directed action whose content, delivery, adherence, context and timing remain recorded."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Medicine.Intervention
