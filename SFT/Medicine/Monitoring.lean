import SFT.Host.Text
namespace SFT.Medicine.Monitoring
structure Obligation where
 claimId : String
 title : String
 family : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-MED-MONITORING-001","Clinical monitoring","screening_prevention_treatment_rehabilitation","ordered-patient-measurements","change-to-decision-relation","schedule-threshold-action-trace","method-interval-and-care-context","Monitoring is a predeclared sequence of measurements and action rules; the measurement history may not be replaced by the latest value."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Medicine.Monitoring
