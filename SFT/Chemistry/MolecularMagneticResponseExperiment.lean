def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-012 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["source_value_present","source_value_inscription","native_value","external_orientation"]
 if !sameValue (get document "schema") (.text "sft-v3-magnetic-response-identities/1") ||
  !sameValue (get document "all_magnetic_values_and_orientations_absent") (.boolean true) ||
  !sameValue (get document "complete_target_count") (.integer 174) || rows.length != 174 ||
  !(rows.all fun row => sameValue (get row "target_value_absent") (.boolean true) && !(forbidden.any (hasKey row))) then
  throw "PROP-012 value-free identity boundary changed"
 pure rows
def identityFields : List (String × String) := [("source_id","source-identity"),("database","molecular-database"),
 ("section","source-section"),("magnetic_parameter","magnetic-parameter"),("measurement_kind","measurement-kind"),("source_locator","source-locator")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "molecular-magnetic-response-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= text
  let destination := Text.intercalate "" [rowPrefix,"-label-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let contextRows ← field row "identity_context" >>= RunningConvergenceMeasurement.array
 let contextStrings ← contextRows.mapM text
 let context := Text.intercalate " | " contextStrings
 let contextDestination := Text.append rowPrefix "-identity-context"
 let contextInstruction := instruction "label" contextDestination ["source-identity-context",if Text.equal context "" then "held-source-cell" else context]
 let counted ← ["table_ordinal","row_ordinal","column_ordinal"].zipIdx.mapM fun (key,index) => do
  let value ← field row key >>= JointCorrelationTargets.integer
  let destination := Text.intercalate "" [rowPrefix,"-count-",toString (index+1)]
  let action := if @decide (Int.lt value 1) (Int.decLt _ _) then instruction "label" destination ["source-position-absence","structural-EmptyOne"]
   else instruction "count" destination [(match value with | .ofNat n => toString n | .negSucc n => Text.append "-" (toString (n+1)))]
  pure (action,destination)
 let laws := [("orientation-law","opposed-directions-are-held-labels"),
  ("closure-law","balanced-support-is-structural-EmptyOne"),
  ("moment-law","positive-response-per-positive-angular-recurrence"),
  ("susceptibility-law","positive-induced-response-per-positive-field-act"),
  ("extension-law","equal-repetition-preserves-exact-response-ratio")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (11+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ [contextDestination] ++ counted.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  [contextInstruction] ++ counted.map Prod.fst ++ lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "molecular-magnetic-response-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["molecular-magnetic-response-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_target_registry",.array [.text targetPath,.text targetHash]),
 ("normalized_primary_records",.array [.text primaryPath,.text primaryHash]),
 ("complete_holdings",.array [.array [.text diatomicHoldingsPath,.text diatomicHoldingsHash],
  .array [.text triatomicHoldingsPath,.text triatomicHoldingsHash],.array [.text hydrocarbonHoldingsPath,.text hydrocarbonHoldingsHash]]),
 ("diatomic_reference_pdf",.array [.text diatomicPdfPath,.text diatomicPdfHash]),
 ("diatomic_extracted_text",.array [.text diatomicTextPath,.text diatomicTextHash]),
 ("constants_page_resolution",.array [.text resolutionPath,.text resolutionHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_174_values_presence_flags_and_orientations_absent_from_prediction",.boolean true),
