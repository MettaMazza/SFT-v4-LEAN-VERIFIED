abbrev View := List (List String) × List (List String × List (String × String)) × String
def view : Except String BranchSupport → Except String View
 | .error e => .error e | .ok row => .ok (row.completeBranchSupport,row.branchProvenance,row.amplitudes)
def same {α : Type} [DecidableEq α] (a b : Except String α) : Bool := match a with
 | .error e => match b with | .error f => decide (e=f) | .ok _ => false
 | .ok x => match b with | .error _ => false | .ok y => decide (x=y)
