structure ReleasedTargets where
 iaea : Value
 codataRows : List String
 sourceRecord : Value
def releasedTargets (files : List (String × ByteArray)) (payload : Value) : Except String ReleasedTargets := do
 let record ← ScatteringMeasurement.authoritativeRecord files payload
 pure ⟨← field (← field record "measurement_scope") "iaea_handbook",← ScatteringMeasurement.codataRows files,record⟩
