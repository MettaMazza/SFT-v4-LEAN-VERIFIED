def sys : SFT.Computation.StateTransition.System := ⟨["a","b"],["set"],[("a","set","b"),("b","set","b")]⟩
def r0a : Replica := ⟨"r0","a"⟩
def r0b : Replica := ⟨"r0","b"⟩
def r1a : Replica := ⟨"r1","a"⟩
def r1b : Replica := ⟨"r1","b"⟩
def u0 : Update := ⟨"u0","r0","r0","set"⟩
def u1 : Update := ⟨"u1","r0","r1","set"⟩
def events := [u0,u1]
def propagation := [("r0","r0"),("r0","r1")]
def initial := [r0a,r1a]
def final := [r0b,r1b]
theorem firstOrder : Trace sys events propagation initial [u0,u1] [initial,[r0b,r1a]] final :=
  .next _ _ _ _ _ _ ⟨.head _,.head _,.head _,.here r0a [r1a] "b" rfl rfl⟩
    (.next _ _ _ _ _ _ ⟨.tail _ (.head _),.tail _ (.head _),.head _,.later r0b _ _ (.here r1a [] "b" rfl rfl)⟩ (.identity final))
theorem secondOrder : Trace sys events propagation initial [u1,u0] [initial,[r0a,r1b]] final :=
  .next _ _ _ _ _ _ ⟨.tail _ (.head _),.tail _ (.head _),.head _,.later r0a _ _ (.here r1a [] "b" rfl rfl)⟩
    (.next _ _ _ _ _ _ ⟨.head _,.head _,.head _,.here r0a [r1b] "b" rfl rfl⟩ (.identity final))
theorem realLostOrder (recover : List Replica → List Update) :
    ¬ (recover final = [u0,u1] ∧ recover final = [u1,u0]) :=
  nativeOrderLossCannotRecover _ _ _ _ _ _ _ _ _ firstOrder secondOrder (by decide) recover
