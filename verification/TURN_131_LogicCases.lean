#eval do
  for (initial,steps,rules,expected) in replayCases do
    unless proofIsValid initial steps rules == expected do throw (IO.userError "proof replay mismatch")
  for (generated,decided,expected) in grammarCases do
    unless grammarComplete generated decided == expected do throw (IO.userError "grammar completeness mismatch")
  for (admitted,expected) in consistencyCases do
    unless consistent admitted == expected do throw (IO.userError "consistency mismatch")
  for (left,right,held,expected) in disjunctionCases do
    let actual := match disjunction left right held with
      | .error _ => false
      | .ok result => decide (result = ("held-alternative",held,(left,right)))
    unless actual == expected do throw (IO.userError "disjunction mismatch")
  for (form,orientation,expected) in propositionCases do
    let actual := match makeProposition form orientation with
      | .error _ => false
      | .ok p => decide (p.form = form) && decide (orientationName p.orientation = orientation)
    unless actual == expected do throw (IO.userError "proposition constructor mismatch")
  for (premises,rule,expected) in stepCases do
    let actual := match makeProofStep premises p2 rule with
      | .error _ => false
      | .ok s => decide (s.premises = premises) && decide (s.conclusion = p2) && decide (s.rule = rule)
    unless actual == expected do throw (IO.userError "proof step constructor mismatch")
  for p in [p0,p1,p2,p3] do
    unless decide (denied (denied p) = p) do throw (IO.userError "denial mismatch")
    unless decide (conjunction p p2 = ("joint-complete",p,p2)) do throw (IO.userError "conjunction mismatch")
  IO.println s!"PASS: {replayCases.length} replay; {grammarCases.length} completeness; {consistencyCases.length} consistency; {disjunctionCases.length} disjunction; {propositionCases.length} proposition constructors; {stepCases.length} step constructors; 4 denial/conjunction cases"
