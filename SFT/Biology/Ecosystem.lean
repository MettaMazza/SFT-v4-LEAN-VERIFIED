import SFT.Host.Text
namespace SFT.Biology.Ecosystem
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-ECOSYSTEM-001","Ecosystem organization","population_ecology","community-environment-joint-carrier","biotic-abiotic-transfer-network","stocks-flows-boundaries-and-history-held","spatial-temporal-boundary","An ecosystem is a bounded joint organization of communities and abiotic supports with complete registered stocks, transfers, losses and observation history."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.Ecosystem
