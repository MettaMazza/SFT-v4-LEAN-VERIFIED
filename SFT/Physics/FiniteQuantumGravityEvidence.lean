def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
  claimId := "SFT-PHYS-FINITE-QUANTUM-GRAVITY-TERMINAL-023"
  title := "Single finite Fold quantum-gravity composition"
  branch := "physics"
  statement := "The admitted quantum branch support and gravitational curvature-source law compose on one and the same finite Fold lattice.  Three forced spatial directions plus one process direction give four coordinate roles and ten symmetric rank-two slots.  Four exact source-conservation constraints and four generated coordinate-shift redundancies retain exactly two physical polarizations.  The detached carrier has an empty mass/rest record and advances one causal cell per tick.  At every positive depth the quantum support, positive distance floor, finite rational loop sum and quarter-area horizon ledger are held together, while the unique three-space theorem leaves the extra-dimension record empty."
  evidenceMode := .formal
  rootTheorems := [SFT.Engine.rootTheoremId]
  dependencies := ["SFT-FOUNDATION-FOLD-DYNAMICS-001", "SFT-PHYS-SPACE-DIMENSION-THREE-001", "SFT-PHYS-QUANTUM-PHYSICAL-STATE-001", "SFT-PHYS-QUANTUM-EVOLUTION-001", "SFT-PHYS-GRAVITY-LATTICE-CURVATURE-003", "SFT-PHYS-SYMMETRIC-SOURCE-CONSERVATION-TERMINAL-010", "SFT-PHYS-GRAVITY-WAVE-QUADRUPOLE-003", "SFT-PHYS-FIELD-FINITE-LOOP-CLOSURE-003", "SFT-PHYS-GRAVITY-STRONG-FIELD-HORIZON-003", "SFT-PHYS-GRAVITY-HORIZON-INFORMATION-003", "SFT-PHYS-VALIDATION-GRAVITY-HORIZONS-003", "SFT-PHYS-VALIDATION-FINITE-LOOPS-003", "SFT-MATH-EXACT-ARITHMETIC-001"]
  axioms := []
  freeParameters := []
  provenance := [.observationalDerivation]
  sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)

def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
  candidateId := candidateId c
  exactForm := exactForm c
  traceHash := identity (.array [.text "SFT-PHYS-FINITE-QUANTUM-GRAVITY-TERMINAL-023",.text generationRule,candidateRecord c])

def censusData : SFT.Engine.CandidateCensus where
  generationRule := generationRule
  grammarBoundary := grammarBoundary
  expectedCardinality := .ofNat candidates.length
  completenessCertificateHash := identity completenessRecord
  candidates := candidates.map generatedCandidateData

def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
  candidateId := candidateId c
  survives := survives c
  reason := decisionReason c
  proofHash := identity (.array [.text "SFT-PHYS-FINITE-QUANTUM-GRAVITY-TERMINAL-023",.array ((registrationData "").dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])

def decision (c : Candidate) : Value := SFT.Engine.decisionValue (decisionData c)

def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
  match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
  | some c => .ok (decisionData c)
  | none => .error "StopIteration"

def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
  scope := .depthIndependent
  exactBoundary := grammarBoundary
  minimalityPassed := true
  namedShapeUniquenessPassed := true
  proofHash := identity (.array [FiniteQuantumGravityControls.closureValue,.array (decisions.map SFT.Engine.decisionValue)])
  generalityCertificateHash := some (identity FiniteQuantumGravityControls.closureValue)

def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

theorem nativeDecisionPreservesSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl

theorem nativeDecisionPreservesReason (c : Candidate) : (decisionData c).reason = decisionReason c := rfl

theorem registrationHasNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl

theorem registrationHasNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl

set_option maxRecDepth 100000
set_option maxHeartbeats 100000000 in
theorem lookupDependsOnlyOnIdentifier (id formA formB hashA hashB : String) :
    decideCandidate ⟨id,formA,hashA⟩ = decideCandidate ⟨id,formB,hashB⟩ := rfl

end SFT.Physics.FiniteQuantumGravityEvidence
