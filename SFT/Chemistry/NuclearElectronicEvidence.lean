import SFT.Chemistry.NuclearElectronicGrammar
import SFT.Chemistry.NuclearElectronic
import SFT.Engine.RegistrationGate
namespace SFT.Chemistry.NuclearElectronicEvidence
open SFT.Host.Canonical NuclearElectronicGrammar
set_option maxRecDepth 20000

def witnesses : Value := .array [.array [.text "three-nuclear-supports",.text "H2, HD and D2 retain three distinct nuclear-support keys.",.boolean NuclearElectronic.threeSupportsWitness],.array [.text "equal-electronic-support",.text "Isotope replacement preserves the held electronic support and state.",.boolean NuclearElectronic.equalElectronicWitness],.array [.text "incomplete-support-control",.text "A missing isotope label rejects.",.boolean NuclearElectronic.incompleteWitness]]
def claimId : String := "SFT-CHEM-NUCLEAR-ELECTRONIC-COMPOSITION-012"
def dependencies : List String := ["SFT-FOUNDATION-FORM-ENFORCEMENT-001","SFT-MATH-EXACT-ARITHMETIC-001","SFT-MATH-DISCRETE-001","SFT-MATH-COMBINATORICS-001","SFT-INFO-SYMBOL-DISTINCTION-001","SFT-INFO-CONSERVATION-LOSS-001","SFT-QUANTUM-STATE-COMPOSITION-001","SFT-PHYS-NUCLEAR-DEUTERON-DINUCLEON-TERMINAL-006","SFT-CHEM-ELEM-ISOTOPE-001","SFT-CHEM-ELECTRONIC-STATE-IDENTITY-001","SFT-CHEM-ORBITAL-SUPPORT-OCCUPANCY-003","SFT-CHEM-CONFIGURATION-ORDER-PATH-011"]
def candidateRecord (c : Candidate) : Value := .object [("candidate_id",.text (candidateId c)),("coordinates",.array [.array [.text "carrier",.text (carrierName c.carrier)],.array [.text "nuclear",.text (nuclearName c.nuclear)],.array [.text "electronic",.text (electronicName c.electronic)],.array [.text "composition",.text (compositionName c.composition)],.array [.text "scale",.text (scaleName c.scale)],.array [.text "transport",.text (transportName c.transport)],.array [.text "absence",.text (absenceName c.absence)],.array [.text "record",.text (recordName c.record)]]),("exact_form",.text (exactForm c))]
def completenessRecord : Value := .object [("claim_id",.text claimId),("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),("dimensions",.array [.array [.text "carrier",.array [.array [.text "detached-nuclear-and-electronic-records",.text "Detached records do not identify one molecular state."],.array [.text "retained-joint-molecular-carrier",.text "Nuclear and electronic coordinates remain bound to one carrier."]]],.array [.text "nuclear",.array [.array [.text "mass-number-without-occurrence-identity",.text "A magnitude alone erases which nuclear occurrence carries an isotope."],.array [.text "retained-occurrence-and-isotope-support",.text "Every occurrence retains one exact isotope label."]]],.array [.text "electronic",.array [.array [.text "isotope-replacement-erases-electronic-identity",.text "Erasing electronic identity prevents lawful equal-support comparison."],.array [.text "retained-electronic-support-and-state",.text "Electronic support and state remain held through isotope replacement."]]],.array [.text "composition",.array [.array [.text "nuclear-or-electronic-factor-erased",.text "Either erasure merges empirically distinguishable states."],.array [.text "finite-nuclear-electronic-joint-product",.text "The state is the exact finite product of both supports."]]],.array [.text "scale",.array [.array [.text "imported-continuum-separation",.text "A continuum scale approximation is not generated by Fold structure."],.array [.text "exact-coordinate-partition-without-separation-parameter",.text "Distinct coordinate families force a finite partition without a fitted scale."]]],.array [.text "transport",.array [.array [.text "isotopologue-coordinates-declared-invariant",.text "Invariant coordinates erase observed isotope transport."],.array [.text "exact-isotope-labelled-coordinate-transport",.text "Equal electronic labels retain isotope-specific exact coordinate records."]]],.array [.text "absence",.array [.array [.text "numerical-zero-or-signed-proof-value",.text "Numerical zero and signed magnitudes are outside the SFT proof domain."],.array [.text "EmptyOne-or-held-external-inscription",.text "Absence is EmptyOne; external signed inscriptions remain labels only."]]],.array [.text "record",.array [.array [.text "selected-common-state-highlights",.text "A selected intersection hides unmatched and absent source rows."],.array [.text "complete-isotopologue-and-vibronic-record",.text "Every registered H2, HD and D2 state and cell remains present."]]]]),("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),("exhaustion",.text "The literal product contains each registered form combination exactly once.")]
def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
 claimId := claimId
 title := "Exact nuclear-electronic joint composition and isotopologue scale-separation law"
 branch := "chemistry"
 statement := "A molecular isotopologue is one retained joint carrier whose nuclear occurrences and isotope labels compose with, but do not erase, its electronic support and state. Their distinct exact coordinate families force lawful scale separation without a continuum approximation or fitted separation parameter; equal-electronic-support isotopologues transport distinct exact vibronic records while every absence remains structural EmptyOne and every external signed inscription remains held provenance."
 evidenceMode := .empirical
 rootTheorems := [SFT.Engine.rootTheoremId]
 dependencies := dependencies
 axioms := []
 freeParameters := []
 provenance := [.observationalDerivation]
 sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)
def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
 candidateId := candidateId c
 exactForm := exactForm c
 traceHash := identity (.array [.text claimId,candidateRecord c])
def censusData : SFT.Engine.CandidateCensus where
 generationRule := generationRule
 grammarBoundary := grammarBoundary
 expectedCardinality := .ofNat candidates.length
 completenessCertificateHash := identity completenessRecord
 candidates := candidates.map generatedCandidateData
def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
 candidateId := candidateId c
 survives := survives c
 reason := decisionReason c
 proofHash := identity (.array [.text claimId,.array (dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
 | some c => .ok (decisionData c)
 | none => .error "StopIteration"
def closureValue : Value := .object [("claim_id",.text claimId),("result",.text "retained-joint-molecular-carrier__retained-occurrence-and-isotope-support__retained-electronic-support-and-state__finite-nuclear-electronic-joint-product__exact-coordinate-partition-without-separation-parameter__exact-isotope-labelled-coordinate-transport__EmptyOne-or-held-external-inscription__complete-isotopologue-and-vibronic-record"),("base",.text "One molecular carrier with one positive nuclear occurrence requires one retained isotope label and one retained electronic support/state pair; neither factor can identify the joint state after the other is erased."),("successor",.text "Appending one nuclear occurrence with its held isotope label extends only the nuclear factor of the finite joint product; the electronic factor, coordinate-family partition, existing records and absence boundary remain unchanged."),("exclusions",.array [.text "no numerical zero; source glyph 0 denotes structural EmptyOne only",.text "no negative, irrational, imaginary, floating, signed or continuum proof magnitude",.text "no Born-Oppenheimer, continuum potential, differential equation, fitted mass, fitted scale or isotope coefficient",.text "no NIST molecular weights, state cells or isotopologue outcomes before prediction seal",.text "no common-state-only or favorable-value-only subset"]),("witnesses",witnesses),("survivor",.text survivorId)]
def exclusions : List String := ["no numerical zero; source glyph 0 denotes structural EmptyOne only","no negative, irrational, imaginary, floating, signed or continuum proof magnitude","no Born-Oppenheimer, continuum potential, differential equation, fitted mass, fitted scale or isotope coefficient","no NIST molecular weights, state cells or isotopologue outcomes before prediction seal","no common-state-only or favorable-value-only subset"]
def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
 scope := .depthIndependent
 exactBoundary := grammarBoundary
 minimalityPassed := true
 namedShapeUniquenessPassed := true
 proofHash := identity (.array [closureValue,.array (decisions.map SFT.Engine.decisionValue)])
 generalityCertificateHash := some (identity closureValue)
def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

def control (kind : SFT.Engine.ControlKind) (passed : Bool) (observation : String) : SFT.Engine.ControlResult where
 kind := kind
 passed := passed
 expectedBehavior := observation
 observedBehavior := if passed then observation else "control failed"
 receiptHash := identity (.array [.text claimId,.text (SFT.Engine.kindName kind),.boolean passed,.text observation])
def runControls (sourceHash : String) : Value := .array ([
 control .falsePremise (!(SFT.Host.Text.equal (candidateId {survivor with carrier := .rejected}) survivorId)) "reject the generated form lacking the complete physical carrier",
 control .tamperedSource (!(SFT.Host.Text.equal (identity (.object [("changed",.text sourceHash)])) sourceHash)) "reject a changed registered source identity",
 control .tamperedArtifact ((candidates.filter survives).length == 1) "reject a missing, duplicate or additional survivor",
 control .boundary (!exclusions.isEmpty) "reject target access, forbidden proof values, imported laws and free parameters"].map SFT.Engine.controlResultValue)

theorem registrationNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl
theorem registrationNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl
theorem decisionSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl
end SFT.Chemistry.NuclearElectronicEvidence
