import SFT.Mathematics.CombinatoricsControls
import SFT.Engine.RegistrationGate
namespace SFT.Mathematics.CombinatoricsEvidence
open SFT.Host.Canonical CombinatoricsGrammar

def candidateRecord (c : Candidate) : Value := .object [
  ("candidate_id",.text (candidateId c)),
  ("coordinates",.array [.array [.text "carrier",.text (carrierName c.carrier)],.array [.text "choice",.text (choiceName c.choice)],.array [.text "provenance",.text (provenanceName c.provenance)],.array [.text "duplicates",.text (duplicatesName c.duplicates)],.array [.text "symmetry",.text (symmetryName c.symmetry)],.array [.text "accounting",.text (accountingName c.accounting)],.array [.text "generality",.text (generalityName c.generality)],.array [.text "addition",.text (additionName c.addition)]]),
  ("exact_form",.text (exactForm c))]

def completenessRecord : Value := .object [
  ("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),
  ("dimensions",.array [.object [("key",.text "carrier"),("question",.text "Is the source carrier complete and canonical?"),("choices",.array [.array [.text "partial-carrier",.text "A partial carrier silently omits possible generated choices."],.array [.text "complete-canonical-carrier",.text "Every distinct generated source member is present once."]])],.object [("key",.text "choice"),("question",.text "How are combinatorial forms generated?"),("choices",.array [.array [.text "sampled-choices",.text "Sampling does not exhaust the registered choice positions."],.array [.text "held-choice-recurrence",.text "Each available member is held once at the next position and recursion continues on the exact remainder."]])],.object [("key",.text "provenance"),("question",.text "Are construction choices retained?"),("choices",.array [.array [.text "erased-origin",.text "Erasing origin prevents reconstruction and duplicate diagnosis."],.array [.text "complete-choice-trace",.text "Every result retains the ordered held-choice construction trace."]])],.object [("key",.text "duplicates"),("question",.text "How are repeated outputs treated?"),("choices",.array [.array [.text "presentation-deduplication",.text "Presentation equality can merge structurally distinct results."],.array [.text "canonical-identity-deduplication",.text "Only identical canonical construction traces are identified."]])],.object [("key",.text "symmetry"),("question",.text "How are symmetric forms compared?"),("choices",.array [.array [.text "assumed-symmetry",.text "An assumed quotient may remove distinguishable held labels."],.array [.text "generated-bijection-witness",.text "A declared label-preserving bijection is required before forms share a symmetry class."]])],.object [("key",.text "accounting"),("question",.text "How are overlapping predicates counted?"),("choices",.array [.array [.text "signed-inclusion-subtraction",.text "Signed subtraction imports negative quantities."],.array [.text "disjoint-provenance-classes",.text "Each generated form is assigned once to a held disjoint class before counts are joined."]])],.object [("key",.text "generality"),("question",.text "What closes every finite carrier size?"),("choices",.array [.array [.text "finite-size-table",.text "A table of small sizes does not force the next recurrence."],.array [.text "carrier-successor-recurrence",.text "Adding one fresh carrier member partitions new forms by whether and where it is held."]])],.object [("key",.text "addition"),("question",.text "Is an imported counting formula used?"),("choices",.array [.array [.text "imported-formula",.text "A stored factorial, binomial or inclusion formula selects the conventional answer."],.array [.text "no-imported-formula",.text "Counts are identities of the complete generated output traces."]])]]),
  ("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),
  ("product_exhaustion",.text "Every named option in every registered dimension occurs once with every option in every other dimension; duplicate candidate identities are forbidden.")]

def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
  claimId := "SFT-MATH-COMBINATORICS-001"
  title := "Exact finite combinatorial generation"
  branch := "mathematics"
  statement := "Every admitted finite combinatorial family is generated by an explicit held-choice recurrence over a complete canonical carrier, preserves construction order and provenance, removes duplicates only by canonical form identity, and counts the resulting complete trace; selections include the structural empty One form rather than numerical zero."
  evidenceMode := .formal
  rootTheorems := [SFT.Engine.rootTheoremId]
  dependencies := ["SFT-FOUNDATION-FOLD-ASSEMBLY-001","SFT-MATH-EXACT-ARITHMETIC-001","SFT-MATH-DISCRETE-001"]
  axioms := []
  freeParameters := []
  provenance := [.forwardForcing]
  sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)

def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
  candidateId := candidateId c
  exactForm := exactForm c
  traceHash := identity (.object [("claim_id",.text "SFT-MATH-COMBINATORICS-001"),("generator",.text generationRule),("record",candidateRecord c)])

def censusData : SFT.Engine.CandidateCensus where
  generationRule := generationRule
  grammarBoundary := grammarBoundary
  expectedCardinality := .ofNat candidates.length
  completenessCertificateHash := identity completenessRecord
  candidates := candidates.map generatedCandidateData

def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
  candidateId := candidateId c
  survives := survives c
  reason := decisionReason c
  proofHash := identity (.object [("claim_id",.text "SFT-MATH-COMBINATORICS-001"),
    ("dependencies",.array [.text "SFT-FOUNDATION-FOLD-ASSEMBLY-001",.text "SFT-MATH-EXACT-ARITHMETIC-001",.text "SFT-MATH-DISCRETE-001"]),
    ("record",candidateRecord c),("survives",.boolean (survives c)),("reason",.text (decisionReason c))])

def decision (c : Candidate) : Value := SFT.Engine.decisionValue (decisionData c)

def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
  match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
  | some c => .ok (decisionData c)
  | none => .error "StopIteration"

def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
  scope := .depthIndependent
  exactBoundary := grammarBoundary
  minimalityPassed := true
  namedShapeUniquenessPassed := true
  proofHash := identity (.object [("closure",CombinatoricsControls.closureValue),
    ("decisions",.array (decisions.map SFT.Engine.decisionValue))])
  generalityCertificateHash := some (identity (.object [
    ("claim_id",.text "SFT-MATH-COMBINATORICS-001"),
    ("base",.text "A one-member carrier has one complete arrangement and two structural selection forms: empty One and held member."),
    ("successor",.text "For a fresh carrier member, arrangements partition by its held position and recurse on the prior remainder; selections partition into prior forms and the same forms with the fresh member held. These disjoint generated classes exhaust the successor carrier without an imported formula."),
    ("laws",.array (CombinatoricsControls.laws.map Value.text)),
    ("witnesses",.array (CombinatoricsWitnesses.witnesses.map fun w => .object [("name",.text w.name),("statement",.text w.statement),("passed",.boolean w.passed)]))]))

def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

theorem nativeDecisionPreservesSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl

theorem nativeDecisionPreservesReason (c : Candidate) : (decisionData c).reason = decisionReason c := rfl

theorem registrationHasNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl

theorem registrationHasNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl

set_option maxRecDepth 20000 in
theorem lookupDependsOnlyOnIdentifier (id formA formB hashA hashB : String) :
    decideCandidate ⟨id,formA,hashA⟩ = decideCandidate ⟨id,formB,hashB⟩ := rfl

end SFT.Mathematics.CombinatoricsEvidence
