 let document ← predictionProgramDocument
 pure (.object [("schema",.text "sft-v3-decay-width-branching-lifetime-experiment/1"),("claim_id",.text "SFT-PHYS-DECAY-WIDTH-BRANCHING-LIFETIME-TERMINAL-006"),("experiment_id",.text "SFT-EXP-PHYS-DECAY-WIDTH-BRANCHING-LIFETIME-TERMINAL-006"),("registered_by",.text "Maria Smith"),("evidence_mode",.text "observational_derivation"),("protocol",.text "observational-data-informed_target-inaccessible_sealed-prediction"),("frozen_relation",.text "Every positive open-channel partial width is paired transition support per action; total width is their complete sum, each branch is partial over total, complete exclusive branches partition the One, and lifetime is action over total width."),("prediction_program",document),("withheld_target_ids",.array [.text "PDG-W-COMPLETE-WIDTH-AND-BRANCHING-VECTOR",.text "NIST-CODATA-REDUCED-ACTION-CARRIER"]),("source_id",.text "PDG-NIST-DECAY-WIDTH-BRANCHING-LIFETIME-2026"),("source_ids",.array [.text "PDG-2026-W-BOSON-LISTING",.text "NIST-CODATA-2022"]),("source_record_path",.text "experiments/external_sources/physics/snapshots/decay-width-branching-lifetime-source-record.json"),("source_record_hash",.text "sha256:331b5b194d2282f2a9e9dde4d92c9635844f0e3cac08fd0389083287d81890fc"),("source_hashes",.object [("experiments/external_sources/physics/snapshots/decay-width-branching-lifetime-source-record.json",.text "sha256:331b5b194d2282f2a9e9dde4d92c9635844f0e3cac08fd0389083287d81890fc"),("experiments/external_sources/physics/snapshots/pdg-2026-w-boson-listing.pdf",.text "sha256:f1905e46980fb732a525de5a1eaa58cb6a87ff97a9dc135e3d7935912ba1d2a1"),("experiments/external_sources/physics/snapshots/nist-codata-2022-allascii.txt",.text "sha256:77fb90e66c40db3e6eb16630bc9c88e4c7c8beddbe5e71be406f2f26e3f67e67")]),("row_retention_policy",.text "all sixteen PDG W-width rows including unused inputs and every printed uncertainty; all thirteen primary decay-mode rows with aggregate/subset classification; both complete exclusive fit vectors; the exact PDG complement statement; and the complete NIST reduced-action row"),("target_access_policy",.text "capability-closed prediction; release only after matching seal"),("comparison_protocol",.text "exact rational interval sums, forced exclusive complements, partial-width interval transport, exact rational enclosure of the NIST ellipsis and adverse omitted/double-counted/direct-lifetime controls"),("falsification_condition",.text "Reject if the complete registered PDG W-width table, thirteen-row decay-mode table or either exclusive branching organization is incomplete; if PDG does not identify each branch as Gamma_i/Gamma or does not close the hadronic branch as One take three leptonic branches; if the complete measured exclusive intervals do not contain the One, if the exact complements forced from the printed leptonic values miss the printed hadronic interval, or if inclusive subsets are double counted; if the NIST action-prefix enclosure and PDG width interval do not yield a finite positive inverse-width lifetime interval and ordering; if any registered row, uncertainty, source identity or unfavorable control is omitted; or if target content enters before seal.")])
structure ReleasedTargets where
 pdg : Value
 nist : String
 sourceRecord : Value
def releasedTargets (files : List (String × ByteArray)) (payload : Value) : Except String ReleasedTargets := do
 let record ← DecayWidthMeasurement.authoritativeRecord files payload
 let sources ← array (← field record "sources")
 let pdg ← match sources with | a::_ => .ok a | [] => .error "IndexError"
 let target : Value := .object [("width_scope",← field pdg "width_scope"),("decay_mode_scope",← field pdg "decay_mode_scope"),("branching_scope",← field pdg "branching_scope")]
 pure ⟨target,← DecayWidthMeasurement.codataActionRow files,record⟩
def targetValues (t : ReleasedTargets) : List (String × Value) := [("PDG-W-COMPLETE-WIDTH-AND-BRANCHING-VECTOR",t.pdg),("NIST-CODATA-REDUCED-ACTION-CARRIER",.text t.nist)]
def envelope (derivationSeal : String) (inputs : List (String × CapabilityValues.Value)) (registrationHash : String) : Value := .object [
 ("experiment_id",.text experimentId),("registered_inputs",.object (inputs.map (fun (key,value) => (key,.text (admissionIdentity (CapabilityValues.canonical value)))))),
 ("withheld_target_ids",.array (targetIds.map Value.text)),("frozen_relation_hash",.text (admissionIdentity (.array [.text derivationSeal,.text frozenRelation]))),("experiment_registration_hash",.text registrationHash)]
theorem completeTargetCount : targetIds.length = 2 := rfl
end SFT.Physics.DecayWidthExperiment
