def sameIndependence (a b : Except String Bool) : Bool :=
  match a,b with
  | .ok x,.ok y => x == y
  | .error x,.error y => x == y
  | _,_ => false
def sameMode (a b : Except String (List String)) : Bool :=
  match a,b with
  | .ok x,.ok y => x == y
  | .error x,.error y => x == y
  | _,_ => false
