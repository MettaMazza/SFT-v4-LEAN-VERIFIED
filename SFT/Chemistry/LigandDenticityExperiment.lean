def specDimensions : List (String × List Bool) := [("carrier",[false,true]),("membership",[false,true]),("centre",[false,true]),("quantity",[false,true]),("chelation",[false,true]),("boundary",[false,true]),("observation",[false,true]),("extension",[false,true])]
