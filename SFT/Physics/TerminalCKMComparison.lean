import SFT.Physics.TerminalCKM
import SFT.Physics.TerminalQuarkRoots
namespace SFT.Physics.TerminalCKMComparison
open LeptonIntervals VacuumLedgerProofs QuarkComparison
set_option maxRecDepth 20000
set_option maxHeartbeats 100000000
structure Predictions where
 s12Squared : Interval
 s23Squared : Interval
 s13Squared : Interval
 jarlskogSquared : Interval

def predictionIntervals : Except String Predictions := do
 let (down,up) ← TerminalQuarkRoots.refinedQuarkRoots
 let d0 ← LeptonRatios.atIndex down 0
 let d1 ← LeptonRatios.atIndex down 1
 let d2 ← LeptonRatios.atIndex down 2
 let u1 ← LeptonRatios.atIndex up 1
 let u2 ← LeptonRatios.atIndex up 2
 let x ← squareRatioInterval d0 d1
 let dl ← LeptonRatios.divide d1.1 d2.2
 let du ← LeptonRatios.divide d1.2 d2.1
 let ul ← LeptonRatios.divide u1.1 u2.2
 let uu ← LeptonRatios.divide u1.2 u2.1
 let addition ← TerminalCKM.slopeContribution
 let slope := (add (subtract dl uu) addition,add (subtract du ul) addition)
 if !(normalize 1 (10^9) (by decide)).blt slope.1 then
  throw "terminal CKM slope lost its positive separation"
 let y := (square slope.1,square slope.2)
 let zl ← LeptonRatios.divide (multiply x.1 y.1) (wholeRatio 6)
 let zu ← LeptonRatios.divide (multiply x.2 y.2) (wholeRatio 6)
 let z := (zl,zu)
 if !x.2.blt (normalize 1 2 (by decide)) || !y.2.blt (normalize 1 2 (by decide)) || !z.2.blt (normalize 1 3 (by decide)) then
  throw "CKM endpoint monotonicity boundary changed"
 let first := (multiply x.1 (subtract (wholeRatio 1) x.1),multiply x.2 (subtract (wholeRatio 1) x.2))
 let second := (multiply y.1 (subtract (wholeRatio 1) y.1),multiply y.2 (subtract (wholeRatio 1) y.2))
 let third := (multiply z.1 (square (subtract (wholeRatio 1) z.2)),multiply z.2 (square (subtract (wholeRatio 1) z.1)))
 let j := (multiply (multiply first.1 second.1) third.1,multiply (multiply first.2 second.2) third.2)
 pure ⟨x,y,z,j⟩
