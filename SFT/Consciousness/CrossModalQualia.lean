import SFT.Consciousness.StructuralModel
namespace SFT.Consciousness.CrossModalQualia
structure Obligation where
 claim_id : String
 title : String
 family : String
 carrier : String
 distinction : String
 operation : String
 retained_record : String
 evidence_boundary : String
 statement : String
def original : Obligation := ⟨"SFT-CONSC-CROSS-MODAL-QUALIA-001","Cross-modal qualitative binding","qualia_resonance_composition","qualities-from-distinct-modal-sources","same-modal/cross-modal","shared-observation-class-composition","source-modality-component-joint-record","first-person-psychophysical","Cross-modal qualitative binding is a joint interior composition whose distinct source modalities and qualitative identities remain traceable."⟩
def carrierWitness : Bool := SFT.Physics.CapabilityValues.nonblank original.carrier
def distinctionWitness : Bool := !(SFT.Host.Text.equal original.distinction original.operation)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.evidence_boundary original.carrier) && !(SFT.Host.Text.equal original.evidence_boundary original.distinction)
def exactFoldWitness : Bool := ((match StructuralModel.structuralWitnesses.find? (fun row => SFT.Host.Text.equal row.1 "three_quality_support_recurs") with | some (_, passed) => passed | none => false))
theorem carrierWitnessPassed : carrierWitness = true := rfl
theorem distinctionWitnessPassed : distinctionWitness = true := rfl
theorem boundaryWitnessPassed : boundaryWitness = true := rfl
theorem exactFoldWitnessPassed : exactFoldWitness = true := by decide
end SFT.Consciousness.CrossModalQualia
