def validate (payload : Value) (files : List Snapshot) : Except String String := do
 if !(hasField payload "sealed_payload_hash") then throw "KeyError: sealed_payload_hash"
 let claimed := string (field payload "sealed_payload_hash")
 let content := match payload with
  | .object fields => Value.object (fields.filter (fun row => !Text.equal row.1 "sealed_payload_hash"))
  | .null | .text _ | .boolean _ | .integer _ | .array _ => payload
 if !Text.equal (identity content) claimed then throw "Biology pre-source seal payload changed"
 if !(isFalse (field payload "external_source_identities_selected")) || !(isFalse (field payload "external_target_content_opened")) then
  throw "Biology derivation was not sealed before source selection"
 if !(integerEqual (field payload "required_claim_count") 75) then throw "Biology pre-source claim count changed"
 if !(integerEqual (field payload "candidate_count") (75*256)) then throw "Biology pre-source candidate count changed"
 if !Text.equal (string (field payload "claim_prediction_set_hash")) (identity predictionSet) then
  throw "Biology sealed prediction set changed"
 let _ ← [("inventory_path","inventory_hash"),("structural_counts_path","structural_counts_hash"),("derivation_path","derivation_hash")].mapM fun (pathKey,hashKey) => do
  let path := string (field payload pathKey)
  let bytes ← readSnapshot files path
  if !Text.equal (bytesHash bytes) (string (field payload hashKey)) then
   throw (Text.append "Biology sealed source changed: " path)
 return claimed
#print axioms predictionSet
#print axioms validate
end SFT.Biology.LifeOrganizationSeal
