def main : IO Unit := do
  for (n,d,expected) in cases do
    if hn : 0 < n then
      if hb : n ≤ d then
        let actual := firstReturn (normalizePart n d hn hb)
        let actualKeys := match actual with
          | .ok trace => Except.ok (trace.map key)
          | .error message => Except.error message
        let same := match actualKeys,expected with
          | .ok a,.ok b => a == b
          | .error a,.error b => a == b
          | _,_ => false
        if !same then throw (IO.userError s!"Mismatch {n}/{d}")
      else throw (IO.userError "invalid case")
    else throw (IO.userError "invalid case")
  let invalid : List Input := [.nonFraction,
    .fraction ⟨.ofNat 0,1,by decide,by decide⟩,
    .fraction ⟨.negSucc 0,2,by decide,by decide⟩,
    .fraction ⟨.ofNat 2,1,by decide,by decide⟩]
  for input in invalid do
    match checkedFirstReturn input with
    | .error e => if e != "ValueError: first return requires one exact positive Fold part" then throw (IO.userError "wrong input error")
    | .ok _ => throw (IO.userError "invalid admitted")
  IO.println "PASS 820 complete first-return outputs and 4 invalid-input cases"
