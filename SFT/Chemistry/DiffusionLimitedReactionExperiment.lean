def hasKey (row : Value) (key : String) : Bool := match row with
 | .object fields => fields.any fun (name,_) => Text.equal name key
 | .null | .boolean _ | .integer _ | .text _ | .array _ => false
def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "KIN-011 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 let forbidden := ["target_payload", "target_payload_hash", "complete_extracted_page_text", "complete_document_hash", "complete_member_hash", "complete_movie_hash", "distance", "time", "velocity", "yield", "rate", "fit", "distribution", "simulation", "uncertainty", "condition", "status", "value"]
 if !sameValue (get document "complete_registered_target_count") (.integer 251) ||
  !sameValue (get document "complete_pdf_page_count") (.integer 43) ||
  !sameValue (get document "complete_supplementary_video_count") (.integer 2) ||
  !sameValue (get document "complete_supplementary_video_frame_count") (.integer 1350) ||
  !sameValue (get document "complete_archive_count") (.integer 2) ||
  !sameValue (get document "complete_source_data_archive_member_count") (.integer 204) ||
  !sameValue (get document "target_values_or_hashes_present") (.boolean false) ||
  !sameValue (get document "all_distance_time_velocity_yield_rate_fit_distribution_simulation_uncertainty_condition_status_value_and_target_hash_values_absent") (.boolean true) ||
  rows.length != 251 || rows.any (fun row=>forbidden.any (hasKey row)) then
  throw "KIN-011 value-free identity boundary changed"
 let ordinals ← rows.mapM fun row=>field row "source_record_ordinal"
 let ids ← rows.mapM fun row=>field row "target_id"
 if !(ordinals.zipIdx.all fun (v,i)=>sameValue v (.integer (i+1))) ||
  (ids.foldl (fun found x=>if found.any (sameValue x) then found else found++[x]) []).length != 251 then
  throw "KIN-011 value-free identity boundary changed"
 pure rows
def identityString (value : Value) : Except String String := match value with
 | .text s => pure s
 | .integer (.ofNat n) => pure (toString n)
 | .integer (.negSucc n) => pure (Text.append "-" (toString (n+1)))
 | .boolean b => pure (if b then "True" else "False")
 | .null => pure "None"
 | .array _ | .object _ => throw "registered finite-microstate identity field is not scalar"
def identityFields : List (String × String) := [("source_id","registered-source-identity"),("article_doi","registered-source-identity"),("figshare_repository_doi","registered-source-identity"),("diffusion_reaction_system_identity","registered-source-identity"),("source_document_identity","registered-source-identity"),("source_record_class","registered-source-identity"),("source_record_identity","registered-source-identity"),("source_record_ordinal","registered-source-identity")]
def identityValue (row : Value) (key : String) : Except String String := field row key >>= identityString
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "diffusion-limited-reaction-record-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← identityValue row key
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
