def decoderEq (a b : Option Decoder) : Bool := match a with
 | none => match b with | none => true | some _ => false
 | some x => match b with | none => false | some y => decide (x = y)
def resultEq (a b : Except String String) : Bool := match a,b with
 | .ok x,.ok y => decide (x = y)
 | .error x,.error y => decide (x = y)
 | _,_ => false
