import SFT.Host.Text
namespace SFT.Biology.LifeAutocatalyticClosure
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-LIFE-AUTOCATALYTIC-CLOSURE-001","Autocatalytic closure and origin-of-life boundary","life_boundary","complete-catalytic-network","product-to-required-catalyst-recurrence","boundary-and-resource-input-retained","finite-network-closure-test","Autocatalytic closure is the least complete finite reaction support in which every required catalytic role is regenerated by the network while resources and boundary conditions remain explicit."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.LifeAutocatalyticClosure
