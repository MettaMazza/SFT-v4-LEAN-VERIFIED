import SFT.Physics.TerminalCKMMeasurement
namespace SFT.Physics.TerminalBaryon
open LeptonIntervals VacuumLedgerProofs
structure Result where
 mixingSource : String
 cpMeasure : String
 imbalanceShare : Rat
 etaRelation : String
def terminalBaryonRelation : Result := ⟨"SFT-PHYS-MATTER-CKM-TERMINAL-004","terminal-Jarlskog-square",normalize 1 2 (by decide),"terminal-Jarlskog-square-times-half-One"⟩
theorem retainedHalfOne : terminalBaryonRelation.imbalanceShare=normalize 1 2 (by decide) := rfl

def predictionInterval : Except String (Rat × Rat) := do
 let p ← TerminalCKMComparison.predictionIntervals
 let lower ← LeptonRatios.divide p.jarlskogSquared.1 (wholeRatio 2)
 let upper ← LeptonRatios.divide p.jarlskogSquared.2 (wholeRatio 2)
 pure (lower,upper)
def originalPrediction : Rat × Rat := (normalize   (by decide),normalize   (by decide))
set_option maxRecDepth 20000
set_option maxHeartbeats 100000000
theorem completePrediction : predictionInterval=.ok originalPrediction := rfl
theorem completeSourceRecord : terminalBaryonRelation=⟨"SFT-PHYS-MATTER-CKM-TERMINAL-004","terminal-Jarlskog-square",normalize 1 2 (by decide),"terminal-Jarlskog-square-times-half-One"⟩ := rfl
end SFT.Physics.TerminalBaryon
