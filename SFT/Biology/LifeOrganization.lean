import SFT.Host.Text
namespace SFT.Biology.LifeOrganization
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-LIFE-ORGANIZATION-001","Living organization","life_boundary","bounded-process-carrier","self-maintaining-transition-relation","identity-through-turnover","viability-window-declared","Living organization is a bounded process network that retains its identity by regulated material and energy turnover within a declared viability window."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.LifeOrganization
