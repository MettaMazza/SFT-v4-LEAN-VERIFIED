def identities (bytes : ByteArray) (document : Value) : Except String (List Value) := do
 if !bytesMatch bytes identityHash then throw "PROP-008 identity registry changed"
 let rows ← RunningConvergenceMeasurement.array (get document "rows")
 if !sameValue (get document "schema") (.text "sft-v3-molecular-electron-affinity-identities/1") ||
    !sameValue (get document "all_values_and_state_order_orientations_absent") (.boolean true) ||
    !sameValue (get document "complete_row_count") (.integer 96) || rows.length != 96 ||
    !(rows.all fun row => sameValue (get row "target_value_and_orientation_absent") (.boolean true) &&
     match row with
     | .object fields => !(fields.any fun (key,_) => ["source_orientation_glyph","fold_state_order_orientation",
       "magnitude_inscription","exact_positive_magnitude","uncertainty_inscription","exact_positive_uncertainty",
       "display_magnitude_lower","display_magnitude_upper"].any (Text.equal key))
     | .null | .boolean _ | .integer _ | .text _ | .array _ => false) then
  throw "PROP-008 value-and-orientation-free identity boundary changed"
 pure rows
def identityFields : List (String × String) := [("formula","molecular-formula"),("name","molecular-name"),("casno","source-species-identity"),("initial_molecular_state","initial-molecular-state"),("resulting_anion_state","resulting-anion-state"),("gained_carrier","gained-carrier"),("gain_path","electron-gain-path"),("condition","measurement-condition"),("units","measurement-unit"),("source_id","source-identity"),("source_locator","source-locator")]
def rowInstructions (row : Value) (ordinal : Nat) : Except String (List Value × List String) := do
 let rowPrefix := Text.append "electron-affinity-row-" (toString ordinal)
 let target ← field row "target_id" >>= text
 let labeled ← identityFields.zipIdx.mapM fun ((key,family),index) => do
  let value ← field row key >>= text
  let destination := Text.intercalate "" [rowPrefix,"-identity-",toString (index+1)]
  pure (instruction "label" destination [family,value],destination)
 let laws := [("held-gain-orientation","neutral-plus-one-electron-to-retained-anion"),
 ("affinity-state-law","held-order-and-positive-higher-Take-lower"),
 ("affinity-absence-law","coincident-state-distinction-is-structural-EmptyOne")]
 let lawRows := laws.zipIdx.map fun ((family,label),index) =>
  let destination := Text.intercalate "" [rowPrefix,"-law-",toString (12+index)]
  (instruction "label" destination [family,label],destination)
 let registers := ["premise"] ++ labeled.map Prod.snd ++ lawRows.map Prod.snd
 pure ([instruction "label" (Text.append rowPrefix "-target") ["target-id",target]] ++ labeled.map Prod.fst ++
  lawRows.map Prod.fst ++ [instruction "word" (Text.append rowPrefix "-word") registers],
  [Text.append rowPrefix "-target",Text.append rowPrefix "-word"])
def predictionProgramDocument (identityBytes : ByteArray) (document : Value) : Except String Value := do
 let rows ← identities identityBytes document
 let parts ← rows.zipIdx.mapM fun (row,index) => rowInstructions row (index+1)
 pure (.object [("schema",.text "sft-v3-fold-program/1"),
 ("program_id",.text (Text.append experimentId "-value-and-orientation-free-complete-vector")),
 ("instructions",.array ([instruction "input" "premise" ["registered-premise"]] ++ parts.flatMap Prod.fst ++
 [instruction "table" "molecular-electron-affinity-vector" (parts.flatMap Prod.snd),instruction "emit" "" ["molecular-electron-affinity-vector"]]))])
def experimentRegistrationRecord (identityBytes : ByteArray) (identitiesDocument : Value) : Except String Value := do
 let document ← predictionProgramDocument identityBytes identitiesDocument
 pure (.object [("experiment_id",.text experimentId),("claim_id",.text claimId),
 ("provenance",.text "observational_derivation"),("frozen_relation",.text frozenRelation),
 ("identity_registry",.array [.text identityPath,.text identityHash]),
 ("withheld_measurement_registry",.array [.text targetPath,.text targetHash]),
 ("catalog_source",.array [.text catalogPath,.text catalogHash]),
 ("definition_source",.array [.text guidePath,.text guideHash]),
 ("normalized_primary_records",.array [.text primaryPath,.text primaryHash]),
 ("value_free_source_page_manifest",.array [.text pageManifestPath,.text pageManifestHash]),
 ("prediction_program",document),("target_ids",.array (targetIds.map Value.text)),
 ("all_96_values_and_state_order_orientations_absent_from_prediction",.boolean true),("falsification_condition",.text falsification)])
