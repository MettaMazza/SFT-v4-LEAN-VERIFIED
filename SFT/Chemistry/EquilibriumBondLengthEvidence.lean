import SFT.Chemistry.EquilibriumBondLengthGrammar
import SFT.Chemistry.EquilibriumBondLength
import SFT.Engine.RegistrationGate
namespace SFT.Chemistry.EquilibriumBondLengthEvidence
open SFT.Host.Canonical EquilibriumBondLengthGrammar
set_option maxRecDepth 20000

def witnesses : Value := .array [.array [.text "forced-common-base",.text "The common equilibrium base is exactly up-support over down-support.",.boolean (EquilibriumBondLength.commonBaseWitness.toOption.getD false)],.array [.text "typed-isotopologue-corrections",.text "H2 and D2 correction counts close as 21 and 24 from their distinct typed routes.",.boolean (EquilibriumBondLength.typedCorrectionsWitness.toOption.getD false)],.array [.text "exact-positive-order",.text "Both multipliers are exact positive fractions and the retained heavy-isotope route is larger.",.boolean (EquilibriumBondLength.positiveOrderWitness.toOption.getD false)]]
def claimId : String := "SFT-CHEM-EQUILIBRIUM-BOND-LENGTH-001"
def dependencies : List String := ["SFT-FOUNDATION-FORM-ENFORCEMENT-001","SFT-FOUNDATION-MEASURED-VALUE-BOUNDARY-001","SFT-MATH-EXACT-ARITHMETIC-001","SFT-INFO-CONSERVATION-LOSS-001","SFT-PHYS-CONSTANT-INVERSE-FINE-STRUCTURE-001","SFT-PHYS-MOLECULAR-SPECTROSCOPY-TERMINAL-005","SFT-PHYS-MEAS-UNIT-COMPARISON-001","SFT-CHEM-BOND-COVALENT-001","SFT-CHEM-CONFIGURATION-ORDER-PATH-011","SFT-CHEM-NUCLEAR-ELECTRONIC-COMPOSITION-012","SFT-CHEM-RESOLVED-ROVIBRONIC-SPIN-COMPOSITION-013"]
def candidateRecord (c : Candidate) : Value := .object [("candidate_id",.text (candidateId c)),("coordinates",.array [.array [.text "identity",.text (identityName c.identity)],.array [.text "equilibrium",.text (equilibriumName c.equilibrium)],.array [.text "scale",.text (scaleName c.scale)],.array [.text "base",.text (baseName c.base)],.array [.text "correction",.text (correctionName c.correction)],.array [.text "isotope",.text (isotopeName c.isotope)],.array [.text "measurement",.text (measurementName c.measurement)],.array [.text "extension",.text (extensionName c.extension)]]),("exact_form",.text (exactForm c))]
def completenessRecord : Value := .object [("claim_id",.text claimId),("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),("dimensions",.array [.array [.text "identity",.array [.array [.text "generic-diatomic-with-erased-state",.text "A generic diatomic label cannot own a quantitative molecular value."],.array [.text "named-isotopologue-state-and-condition",.text "Species, isotopologue, electronic state and gas-phase condition remain held."]]],.array [.text "equilibrium",.array [.array [.text "arbitrary-distance-sample",.text "A sampled distance is not the generated equilibrium fixed point."],.array [.text "configuration-minimum-distance",.text "The admitted configuration-order law identifies the stable minimum coordinate."]]],.array [.text "scale",.array [.array [.text "free-angstrom-scale",.text "A freely chosen physical scale is a fitted parameter."],.array [.text "held-atomic-length-reference",.text "The admitted same-dimension atomic-length carrier transports the exact ratio."]]],.array [.text "base",.array [.array [.text "free-leading-ratio",.text "A chosen leading ratio can place the prediction near any target."],.array [.text "up-support-over-down-support",.text "The forced molecular up/down supports supply the common electronic base seven-fifths."]]],.array [.text "correction",.array [.array [.text "linear-or-open-correction-series",.text "A linear or open series has no typed closure and can be extended to fit."],.array [.text "binary-order-alpha-return",.text "The binary return forces the first closed correction at exact alpha squared."]]],.array [.text "isotope",.array [.array [.text "one-universal-isotope-correction",.text "One correction erases the admitted nuclear-support distinction."],.array [.text "distinct-light-and-heavy-typed-routes",.text "H2 uses generator-times-up; D2 uses terminal-plus-up-plus-One."]]],.array [.text "measurement",.array [.array [.text "target-readable-or-selected-value",.text "Target-readable execution cannot provide an empirical prediction seal."],.array [.text "sealed-exact-interval-transport",.text "Exact multipliers and the public scale input are sealed before the target vector opens."]]],.array [.text "extension",.array [.array [.text "free-species-term-or-fit",.text "A species correction not generated by the typed boundary is a free parameter."],.array [.text "finite-typed-vector-exhaustion",.text "The registered H2/D2 typed routes are exhausted and halt without another term."]]]]),("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),("exhaustion",.text "The literal product contains each registered form combination exactly once.")]
def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
 claimId := claimId
 title := "Exact H2/D2 equilibrium bond-length relation"
 branch := "chemistry"
 statement := "For the complete registered gas-phase H2/D2 X-state boundary, the common Fold electronic base is seven-fifths of the held atomic-length carrier. The binary-order alpha return adds twenty-one alpha squared for H2 and twenty-four alpha squared for D2. Thus r_e(H2)/a0=7/5+21 alpha^2 and r_e(D2)/a0=7/5+24 alpha^2 before either NIST distance target is released."
 evidenceMode := .empirical
 rootTheorems := [SFT.Engine.rootTheoremId]
 dependencies := dependencies
 axioms := []
 freeParameters := []
 provenance := [.observationalDerivation]
 sourceHash := sourceHash

def registration (sourceHash : String) : Value := SFT.Engine.registrationValue (registrationData sourceHash)
def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
 candidateId := candidateId c
 exactForm := exactForm c
 traceHash := identity (.array [.text claimId,candidateRecord c])
def censusData : SFT.Engine.CandidateCensus where
 generationRule := generationRule
 grammarBoundary := grammarBoundary
 expectedCardinality := .ofNat candidates.length
 completenessCertificateHash := identity completenessRecord
 candidates := candidates.map generatedCandidateData
def census : Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
 candidateId := candidateId c
 survives := survives c
 reason := decisionReason c
 proofHash := identity (.array [.text claimId,.array (dependencies.map Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])
def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
 match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
 | some c => .ok (decisionData c)
 | none => .error "StopIteration"
def closureValue : Value := .object [("claim_id",.text claimId),("boundary",.text grammarBoundary),("result",.text "named-isotopologue-state-and-condition__configuration-minimum-distance__held-atomic-length-reference__up-support-over-down-support__binary-order-alpha-return__distinct-light-and-heavy-typed-routes__sealed-exact-interval-transport__finite-typed-vector-exhaustion"),("base",.text "The admitted equal electronic support fixes one common up/down equilibrium base for the light homonuclear state; the binary alpha return supplies its first closed positive correction."),("successor",.text "Replacing both retained light nuclei by the admitted heavy isotope preserves the common electronic base and forces the distinct terminal-plus-up-plus-One correction route; the two-row registered vector is then exhausted."),("exclusions",.array [.text "no numerical zero, negative, irrational, imaginary, floating, signed or continuum proof value",.text "no NIST distance, CODATA scale inscription or angstrom conversion in the executable law",.text "no imported wavefunction, potential, rigid-rotor length equation or conventional molecular model",.text "no fitted bond parameter, selected decimal coefficient, species lookup or free correction term",.text "no target access before the exact interval vector is sealed",.text "no claim beyond the registered H2/D2 X-state gas-phase boundary"]),("witnesses",witnesses),("survivor",.text survivorId)]
def exclusions : List String := ["no numerical zero, negative, irrational, imaginary, floating, signed or continuum proof value","no NIST distance, CODATA scale inscription or angstrom conversion in the executable law","no imported wavefunction, potential, rigid-rotor length equation or conventional molecular model","no fitted bond parameter, selected decimal coefficient, species lookup or free correction term","no target access before the exact interval vector is sealed","no claim beyond the registered H2/D2 X-state gas-phase boundary"]
def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
 scope := .finiteComplete
 exactBoundary := grammarBoundary
 minimalityPassed := true
 namedShapeUniquenessPassed := true
 proofHash := identity (.array [closureValue,.array (decisions.map SFT.Engine.decisionValue)])
 generalityCertificateHash := none
def closure (decisions : List SFT.Engine.CandidateDecision) : Value := SFT.Engine.closureEvidenceValue (closureData decisions)

def control (kind : SFT.Engine.ControlKind) (passed : Bool) (observation : String) : SFT.Engine.ControlResult where
 kind := kind
 passed := passed
 expectedBehavior := observation
 observedBehavior := if passed then observation else "control failed"
 receiptHash := identity (.array [.text claimId,.text (SFT.Engine.kindName kind),.boolean passed,.text observation])
def runControls (sourceHash : String) : Value := .array ([
 control .falsePremise (!(SFT.Host.Text.equal (candidateId {survivor with identity := .rejected}) survivorId)) "reject the generated form lacking the complete physical carrier",
 control .tamperedSource (!(SFT.Host.Text.equal (identity (.object [("changed",.text sourceHash)])) sourceHash)) "reject a changed registered source identity",
 control .tamperedArtifact ((candidates.filter survives).length == 1) "reject a missing, duplicate or additional survivor",
 control .boundary (!exclusions.isEmpty) "reject target access, forbidden proof values, imported laws and free parameters"].map SFT.Engine.controlResultValue)

theorem registrationNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl
theorem registrationNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl
theorem decisionSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl
end SFT.Chemistry.EquilibriumBondLengthEvidence
