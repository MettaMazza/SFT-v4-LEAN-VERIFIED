import SFT.Host.Text
namespace SFT.Biology.BiologicalVariation
structure Obligation where
 claimId : String
 title : String
 subbranch : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-BIO-VARIATION-001","Biological variation","variation_evolution","population-state-carrier","within-class-distinction-relation","individual-lineage-and-state-held","sampling-boundary-declared","Variation is the complete retained set of distinguishable biological states within a declared population and sampling boundary."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Biology.BiologicalVariation
