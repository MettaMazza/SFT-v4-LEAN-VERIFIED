def ratio (v : Rat) : Value := .array [.integer v.num,.integer (.ofNat v.den)]
def pair (v : Rat × Rat) : Value := .array [ratio v.1,ratio v.2]
def enc : Except String Analysis → Value
 | .error e => .object [("error",.text e)]
