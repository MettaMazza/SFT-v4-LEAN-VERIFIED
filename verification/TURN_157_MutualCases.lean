set_option synthInstance.maxSize 100000
set_option synthInstance.maxHeartbeats 100000
abbrev CV := String × String × List String × Option (Nat × Nat)
abbrev JV := String × String × List String × Option (Nat × Nat) × (Nat × Nat) × (Nat × Nat) × (Nat × Nat) × String
def pv (p : PositiveFraction) : Nat × Nat := (p.numerator,p.denominator)
def cp : ExactCell → Option (Nat × Nat) | .emptyOne => none | .part p => some (pv p)
def cv (r : MutualConditional.ConditionalRow) : CV := (r.givenLabel,r.targetLabel,r.members,cp r.exactGivenPart)
def jv (r : MutualJoint.JointRow) : JV := (r.leftLabel,r.rightLabel,r.members,cp r.jointPart,pv r.leftPart,pv r.rightPart,pv r.productPart,comparisonName r.relation)
def conditionalView : Except String (List MutualConditional.ConditionalRow) → Except String (List CV)
 | .error e => .error e | .ok rows => .ok (rows.map cv)
def dependenceView : Except String Dependence → Except String (Option (List JV))
 | .error e => .error e | .ok .emptyOne => .ok none | .ok (.cells rows) => .ok (some (rows.map jv))
def same {α : Type} [DecidableEq α] (a b : Except String α) : Bool := match a with
 | .error e => match b with | .error f => decide (e=f) | .ok _ => false
 | .ok x => match b with | .error _ => false | .ok y => decide (x=y)
