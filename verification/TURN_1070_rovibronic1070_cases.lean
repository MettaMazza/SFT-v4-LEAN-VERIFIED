s-8-5",runCase ({hydrogen with vibrationalOrdinal := ⟨8,by decide⟩, rotationalOrdinal := ⟨5,by decide⟩}))] : List (String × SFT.Host.Canonical.Value)).map fun (name,v)=>.array [.text name,v])),("comparisons",.array (([("same",comparison (hydrogen)),("isotope",comparison (deuterium)),("renamed-occurrences",comparison ({hydrogen with nuclearOccurrenceIds := ["a","b"]})),("other-carrier",comparison ({hydrogen with electronicState := {electronic with molecularCarrierId := "other"}}))] : List (String × SFT.Host.Canonical.Value)).map fun (name,v)=>.array [.text name,v])),("witnesses",.array (witnesses.map fun x=>.array [.text x.name,.text x.statement,.boolean x.passed]))]))
