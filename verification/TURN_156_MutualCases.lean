abbrev View := String × String × List String × Option (Nat × Nat) × (Nat × Nat) × (Nat × Nat) × (Nat × Nat) × String
def partView (p : PositiveFraction) : Nat × Nat := (p.numerator,p.denominator)
def cellView : ExactCell → Option (Nat × Nat)
 | .emptyOne => none
 | .part p => some (partView p)
def view (row : JointRow) : View :=
 (row.leftLabel,row.rightLabel,row.members,cellView row.jointPart,partView row.leftPart,partView row.rightPart,partView row.productPart,comparisonName row.relation)
def ledgerView (value : Except String (List JointRow)) : Except String (List View) := match value with
 | .error e => .error e
 | .ok rows => .ok (rows.map view)
def same {α : Type} [DecidableEq α] (a b : Except String α) : Bool := match a with
 | .error e => match b with | .error f => decide (e=f) | .ok _ => false
 | .ok x => match b with | .error _ => false | .ok y => decide (x=y)
