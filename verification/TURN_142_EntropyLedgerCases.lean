abbrev View := String × Nat × Nat × List String × Bool × List Pair
def recordView (row : Record) : View :=
  (row.observation,row.exactSupportPart.numerator,row.exactSupportPart.denominator,row.microstates,
    match row.unresolvedDistinctions with | .emptyOne => true | .pairs _ => false,
    uncertaintyPairs row.unresolvedDistinctions)
def ledgerView (value : Except String (List Record)) : Except String (List View) := match value with
  | .error e => .error e
  | .ok rows => .ok (rows.map recordView)
def outputEq (a b : Except String (List View)) : Bool := match a,b with
  | .ok x,.ok y => decide (x = y)
  | .error x,.error y => decide (x = y)
  | _,_ => false
