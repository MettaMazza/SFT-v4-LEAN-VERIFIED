import SFT.Computation.ErrorPropagation
set_option maxRecDepth 1000000
open SFT.Computation.ErrorPropagation SFT.Computation.NumericalError
def rowView (rows : List Row) : List (String × Nat × Nat × String) := rows.map fun r => (r.1,r.2.1.numerator,r.2.1.denominator,r.2.2)
def localView (result : Except String (List LocalLedger)) : Except String (List (String × List (String × Nat × Nat × String))) := result.map fun xs => xs.map fun l => (l.edge.identity,rowView l.rows)
def terminalView (result : Except String (List Row)) := result.map rowView
