import SFT.Chemistry.MolecularBondAngleValidation
open SFT.Chemistry.MolecularBondAngleValidation SFT.Host.Canonical
def renderPrediction (p : Prediction) : Value := .object [
 ("species",.text p.species),("state",.text p.state),("geometry",.text p.geometry),("coordinate",.text p.coordinate),
 ("role",.text p.role),("sector_count",.integer p.sectorCount),("sector_separation",.integer p.sectorSeparation),
 ("turn_fraction",ratValue p.turnFraction)]
def result (value : SFT.Physics.CapabilityValues.Value) : Value :=
 match predictionMap value with
 | .error error => .object [("error",.text error)]
 | .ok rows => .object [("ok",.object (rows.map fun p => (p.targetId,renderPrediction p)))]
