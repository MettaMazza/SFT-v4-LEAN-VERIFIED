def validate (payload : Value) (files : List Snapshot) : Except String String := do
 if !(hasField payload "complete_branch_pre_source_seal_hash") then throw "KeyError: complete_branch_pre_source_seal_hash"
 let claimed := string (field payload "complete_branch_pre_source_seal_hash")
 let content := match payload with
  | .object fields => Value.object (fields.filter (fun row => !Text.equal row.1 "complete_branch_pre_source_seal_hash"))
  | .null | .text _ | .boolean _ | .integer _ | .array _ => payload
 if !Text.equal (identity content) claimed then throw "Medicine pre-source seal payload changed"
 if !(isFalse (field payload "external_source_identities_selected")) || !(isFalse (field payload "external_outcomes_opened")) then
  throw "Medicine derivation was not sealed before source selection"
 if !(integerEqual (field payload "required_claim_count") 72) then throw "Medicine pre-source claim count changed"
 if !(integerEqual (field payload "candidate_count") (72*256)) then throw "Medicine pre-source candidate count changed"
 if !Text.equal (string (field payload "claim_prediction_set_hash")) (identity predictionSet) then
  throw "Medicine sealed prediction set changed"
 let _ ← [("inventory_path","inventory_file_hash"),("obligations_path","obligations_hash"),("generated_law_path","generated_law_hash"),("structural_counts_path","structural_counts_hash")].mapM fun (pathKey,hashKey) => do
  let path := string (field payload pathKey)
  let bytes ← readSnapshot files path
  if !Text.equal (bytesHash bytes) (string (field payload hashKey)) then
   throw (Text.append "Medicine sealed source changed: " path)
 return claimed
#print axioms predictionSet
#print axioms validate
end SFT.Medicine.PatientIdentitySeal
