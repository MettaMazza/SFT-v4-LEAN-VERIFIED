 ("generation_rule",.text generationRule),("grammar_boundary",.text grammarBoundary),
 ("axes",.array [.object [("key",.text "carrier"),("question",.text "What is a spatial dimension count?"),("choices",.array [.array [.text "coordinate-name-only",.text "A coordinate name has no independence or incidence trace."],.array [.text "independent-generated-direction-carrier",.text "Each direction is a distinct generated incidence role retained in the complete carrier."]])],.object [("key",.text "lower"),("question",.text "What supplies the lower boundary?"),("choices",.array [.array [.text "one-or-collapsed-fibre-count",.text "At or below the fibre count the common return is identified with a fibre role."],.array [.text "strictly-beyond-two-Fold-fibres",.text "Both fibre roles and a distinct return require a count strictly beyond two."]])],.object [("key",.text "upper"),("question",.text "What supplies the upper boundary?"),("choices",.array [.array [.text "unbounded-coordinate-extension",.text "An unbounded extension adds roles not generated by one Fold closure."],.array [.text "strictly-within-four-pair-cells",.text "The ordered product of the two fibres supplies four one-Fold pair roles; stability retains a proper positive remainder before saturation."]])],.object [("key",.text "interval"),("question",.text "Are the boundaries included?"),("choices",.array [.array [.text "closed-or-one-sided-window",.text "Including two collapses return; including four exhausts the restoring remainder."],.array [.text "open-Fold-stability-window",.text "Only counts strictly above two and strictly below four satisfy both constraints."]])],.object [("key",.text "census"),("question",.text "How are possible counts treated?"),("choices",.array [.array [.text "selected-dimension",.text "Selecting a familiar dimension is not forcing."],.array [.text "complete-positive-count-enumeration",.text "Every generated positive count in the open interval is retained."]])],.object [("key",.text "value"),("question",.text "Which enumerated count survives?"),("choices",.array [.array [.text "two-directions",.text "Two does not remain beyond both Fold fibres."],.array [.text "three-directions",.text "Three is the only positive count strictly between two and four."],.array [.text "four-directions",.text "Four saturates the pair-cell boundary."],.array [.text "target-selected-directions",.text "A measured spatial target cannot enter derivation."]])],.object [("key",.text "crosslock"),("question",.text "What independently checks the count?"),("choices",.array [.array [.text "no-independent-lock",.text "A single route cannot expose a changed stability bound."],.array [.text "equals-generator-three",.text "The unique stability member equals the separately forced second Fold generator."]])],.object [("key",.text "measurement"),("question",.text "What is the empirical direction?"),("choices",.array [.array [.text "space-count-read-from-measurement",.text "Measurement cannot select the spatial law."],.array [.text "forced-count-then-observed",.text "The exact count is sealed before physical observation tests it."]])],.object [("key",.text "extension"),("question",.text "Is another dimensional premise added?"),("choices",.array [.array [.text "extra-dimensional-model",.text "An added manifold or conventional dimension rule supplies the answer."],.array [.text "no-extra-rule",.text "Fold fibres, pair cells, positive counts and recurrence provide the complete law."]])]]),
 ("candidate_ids",.array (candidates.map fun c => .text (candidateId c))),
 ("product_exhaustion",.text "Every registered choice occurs once with every choice on every other axis.")]

def registrationData (sourceHash : String) : SFT.Engine.ClaimRegistration where
  claimId := "SFT-PHYS-SPACE-DIMENSION-THREE-001"
  title := "Three-dimensional Fold stability"
  branch := "physics"
  statement := "A Fold-stable spatial carrier has exactly three independent generated directions: it must strictly exceed the two fibre roles so their return remains distinct, remain strictly within the four ordered pair-cell roles so a restoring return is retained, and the complete positive-count census of that open window has the sole member three, independently equal to the second Fold generator."
  evidenceMode := .formal
  rootTheorems := [SFT.Engine.rootTheoremId]
  dependencies := ["SFT-PHYS-STRUCT-GENERATOR-THREE-001", "SFT-FOUNDATION-FOLD-001", "SFT-FOUNDATION-FOLD-ASSEMBLY-001", "SFT-MATH-EXACT-ARITHMETIC-001", "SFT-MATH-COMBINATORICS-001", "SFT-MATH-GEOMETRY-TOPOLOGY-001", "SFT-MATH-DYNAMICAL-SYSTEMS-001"]
  axioms := []
  freeParameters := []
  provenance := [.forwardForcing]
  sourceHash := sourceHash

def registration (sourceHash : String) : SFT.Host.Canonical.Value := SFT.Engine.registrationValue (registrationData sourceHash)

def generatedCandidateData (c : Candidate) : SFT.Engine.Candidate where
  candidateId := candidateId c
  exactForm := exactForm c
  traceHash := identity (.array [.text "SFT-PHYS-SPACE-DIMENSION-THREE-001",.text generationRule,candidateRecord c])

def censusData : SFT.Engine.CandidateCensus where
  generationRule := generationRule
  grammarBoundary := grammarBoundary
  expectedCardinality := .ofNat candidates.length
  completenessCertificateHash := identity completenessRecord
  candidates := candidates.map generatedCandidateData

def census : SFT.Host.Canonical.Value := SFT.Engine.censusValue censusData

def decisionData (c : Candidate) : SFT.Engine.CandidateDecision where
  candidateId := candidateId c
  survives := survives c
  reason := decisionReason c
  proofHash := identity (.array [.text "SFT-PHYS-SPACE-DIMENSION-THREE-001",.array ((registrationData "").dependencies.map SFT.Host.Canonical.Value.text),candidateRecord c,.boolean (survives c),.text (decisionReason c)])

def decision (c : Candidate) : SFT.Host.Canonical.Value := SFT.Engine.decisionValue (decisionData c)

def decideCandidate (candidate : SFT.Engine.Candidate) : Except String SFT.Engine.CandidateDecision :=
  match candidates.find? (fun c => SFT.Host.Text.equal (candidateId c) candidate.candidateId) with
  | some c => .ok (decisionData c)
  | none => .error "StopIteration"

def closureData (decisions : List SFT.Engine.CandidateDecision) : SFT.Engine.ClosureEvidence where
  scope := .depthIndependent
  exactBoundary := grammarBoundary
  minimalityPassed := true
  namedShapeUniquenessPassed := true
  proofHash := identity (.array [SpatialThreeControls.closureValue,.array (decisions.map SFT.Engine.decisionValue)])
  generalityCertificateHash := some (identity SpatialThreeControls.closureValue)

def closure (decisions : List SFT.Engine.CandidateDecision) : SFT.Host.Canonical.Value := SFT.Engine.closureEvidenceValue (closureData decisions)

theorem nativeDecisionPreservesSurvival (c : Candidate) : (decisionData c).survives = survives c := rfl

theorem nativeDecisionPreservesReason (c : Candidate) : (decisionData c).reason = decisionReason c := rfl

theorem registrationHasNoAxioms (sourceHash : String) : (registrationData sourceHash).axioms = [] := rfl

theorem registrationHasNoFreeParameters (sourceHash : String) : (registrationData sourceHash).freeParameters = [] := rfl

set_option maxRecDepth 20000 in
theorem lookupDependsOnlyOnIdentifier (id formA formB hashA hashB : String) :
    decideCandidate ⟨id,formA,hashA⟩ = decideCandidate ⟨id,formB,hashB⟩ := rfl

end SFT.Physics.SpatialThreeEvidence
