import SFT.Host.Text
namespace SFT.Medicine.Dysfunction
structure Obligation where
 claimId : String
 title : String
 family : String
 carrier : String
 relation : String
 organization : String
 observation : String
 statement : String
def original : Obligation := ⟨"SFT-MED-DYSFUNCTION-001","Dysfunction boundary","variation_dysfunction_disease_injury","person-function-state","impaired-relation-to-declared-function","function-context-and-consequence","method-and-baseline-boundary","Dysfunction requires a retained functional relation, baseline, context and consequence and cannot be inferred from difference alone."⟩
def carrierWitness : Bool := !(SFT.Host.Text.equal original.carrier "")
def relationWitness : Bool := !(SFT.Host.Text.equal original.relation original.organization)
def boundaryWitness : Bool := !(SFT.Host.Text.equal original.observation original.relation)
theorem carrierWitnessPassed : carrierWitness = true := by rfl
theorem relationWitnessPassed : relationWitness = true := by rfl
theorem boundaryWitnessPassed : boundaryWitness = true := by rfl
end SFT.Medicine.Dysfunction
