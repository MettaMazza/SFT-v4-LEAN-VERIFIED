set_option maxHeartbeats 100000000
open SFT.Foundation
set_option maxRecDepth 20000

inductive Carrier where
  | rejected | admitted

def carrierName : Carrier → String
  | .rejected => "saddle-point-or-continuum-transition-state-premise"
  | .admitted => "finite-generated-path-boundary-carrier"

inductive Identity where
  | rejected | admitted

def identityName : Identity → String
  | .rejected => "isotopologue-or-reaction-identity-collapsed"
  | .admitted => "held-reaction-path-and-isotopologue-identities"

inductive Location where
  | rejected | admitted

def locationName : Location → String
  | .rejected => "arbitrary-named-state-or-fitted-coordinate"
  | .admitted => "unique-greatest-exact-positive-path-support"

inductive Partition where
  | rejected | admitted

def partitionName : Partition → String
  | .rejected => "endpoint-only-or-boundary-answer-only"
  | .admitted => "complete-entry-boundary-exit-partition"

inductive Orientation where
  | rejected | admitted

def orientationName : Orientation → String
  | .rejected => "signed-or-negative-proof-scalar"
  | .admitted => "positive-magnitude-plus-held-orientation"

inductive Observation where
  | rejected | admitted

def observationName : Observation → String
  | .rejected => "single-favorable-isotope-or-barrier-only"
  | .admitted => "complete-H2-D2-signature-uncertainty-and-adverse-record"

inductive Provenance where
  | rejected | admitted

def provenanceName : Provenance → String
  | .rejected => "experimental-calculated-fitted-records-mixed"
  | .admitted => "experimental-targets-separated-from-calculated-and-fitted-records"

inductive Prediction where
  | rejected | admitted

def predictionName : Prediction → String
  | .rejected => "conventional-KIE-equation-target-access-or-refit"
  | .admitted => "value-free-complete-isotopologue-identity-seal-and-depth-independent-append"

structure Candidate where
  carrier : Carrier
  identity : Identity
  location : Location
  partition : Partition
  orientation : Orientation
  observation : Observation
  provenance : Provenance
  prediction : Prediction

def sourceFields (c : Candidate) : List String := [carrierName c.carrier, identityName c.identity, locationName c.location, partitionName c.partition, orientationName c.orientation, observationName c.observation, provenanceName c.provenance, predictionName c.prediction]

def candidateId (c : Candidate) : String := SFT.Host.Text.intercalate "__" (sourceFields c)
def exactForm (c : Candidate) : String := SFT.Host.Text.intercalate "; " [SFT.Host.Text.append "carrier=" (carrierName c.carrier), SFT.Host.Text.append "identity=" (identityName c.identity), SFT.Host.Text.append "location=" (locationName c.location), SFT.Host.Text.append "partition=" (partitionName c.partition), SFT.Host.Text.append "orientation=" (orientationName c.orientation), SFT.Host.Text.append "observation=" (observationName c.observation), SFT.Host.Text.append "provenance=" (provenanceName c.provenance), SFT.Host.Text.append "prediction=" (predictionName c.prediction)]
def survivorId : String := "finite-generated-path-boundary-carrier__held-reaction-path-and-isotopologue-identities__unique-greatest-exact-positive-path-support__complete-entry-boundary-exit-partition__positive-magnitude-plus-held-orientation__complete-H2-D2-signature-uncertainty-and-adverse-record__experimental-targets-separated-from-calculated-and-fitted-records__value-free-complete-isotopologue-identity-seal-and-depth-independent-append"
def survives (c : Candidate) : Bool := SFT.Host.Text.equal (candidateId c) survivorId
def criteriaDecision (c : Candidate) : Bool :=
  SFT.Host.Text.equal (carrierName c.carrier) "finite-generated-path-boundary-carrier" &&
  SFT.Host.Text.equal (identityName c.identity) "held-reaction-path-and-isotopologue-identities" &&
  SFT.Host.Text.equal (locationName c.location) "unique-greatest-exact-positive-path-support" &&
  SFT.Host.Text.equal (partitionName c.partition) "complete-entry-boundary-exit-partition" &&
  SFT.Host.Text.equal (orientationName c.orientation) "positive-magnitude-plus-held-orientation" &&
  SFT.Host.Text.equal (observationName c.observation) "complete-H2-D2-signature-uncertainty-and-adverse-record" &&
  SFT.Host.Text.equal (provenanceName c.provenance) "experimental-targets-separated-from-calculated-and-fitted-records" &&
  SFT.Host.Text.equal (predictionName c.prediction) "value-free-complete-isotopologue-identity-seal-and-depth-independent-append"

def decisionReason (c : Candidate) : String :=
  if !(SFT.Host.Text.equal (carrierName c.carrier) "finite-generated-path-boundary-carrier") then "A named continuum saddle imports geometry not generated by the Fold path." else
  if !(SFT.Host.Text.equal (identityName c.identity) "held-reaction-path-and-isotopologue-identities") then "Collapsed identities cannot preserve isotope-dependent observations." else
  if !(SFT.Host.Text.equal (locationName c.location) "unique-greatest-exact-positive-path-support") then "A selected state or fitted coordinate could choose the boundary." else
  if !(SFT.Host.Text.equal (partitionName c.partition) "complete-entry-boundary-exit-partition") then "Endpoints alone erase the states adjacent to crossing." else
  if !(SFT.Host.Text.equal (orientationName c.orientation) "positive-magnitude-plus-held-orientation") then "A signed scalar imports a prohibited negative number." else
  if !(SFT.Host.Text.equal (observationName c.observation) "complete-H2-D2-signature-uncertainty-and-adverse-record") then "Selecting one isotope erases the measured contrast." else
  if !(SFT.Host.Text.equal (provenanceName c.provenance) "experimental-targets-separated-from-calculated-and-fitted-records") then "Mixing provenance can promote a fitted calculation to measurement." else
  if !(SFT.Host.Text.equal (predictionName c.prediction) "value-free-complete-isotopologue-identity-seal-and-depth-independent-append") then "A conventional equation, target access or refit can select the outcome." else
  "finite-generated-path-boundary-carrier__held-reaction-path-and-isotopologue-identities__unique-greatest-exact-positive-path-support__complete-entry-boundary-exit-partition__positive-magnitude-plus-held-orientation__complete-H2-D2-signature-uncertainty-and-adverse-record__experimental-targets-separated-from-calculated-and-fitted-records__value-free-complete-isotopologue-identity-seal-and-depth-independent-append"

def generationRule : String := "Generate the literal product of carrier, identity, location, partition, orientation, observation, provenance and prediction forms; decide all 256 candidates only from admitted exact arithmetic, finite path, state-transition, order, retained-information, reaction-mechanism, temperature-dependence and activation-boundary laws."
def grammarBoundary : String := "Every finite generated reaction path with held reaction/path/isotopologue identities, structural EmptyOne or exact positive supports, and one unique greatest support. External testing preserves the complete predeclared primary article and supplement, both measured H2/D2 signatures, all thirteen supplementary files, and all disclosed calculated/fitted records as separately classified provenance."

def candidates : List Candidate :=
  ([Carrier.rejected,Carrier.admitted]).flatMap fun carrier =>
  ([Identity.rejected,Identity.admitted]).flatMap fun identity =>
  ([Location.rejected,Location.admitted]).flatMap fun location =>
  ([Partition.rejected,Partition.admitted]).flatMap fun partition =>
  ([Orientation.rejected,Orientation.admitted]).flatMap fun orientation =>
  ([Observation.rejected,Observation.admitted]).flatMap fun observation =>
  ([Provenance.rejected,Provenance.admitted]).flatMap fun provenance =>
  ([Prediction.rejected,Prediction.admitted]).map fun prediction =>
  ⟨carrier,identity,location,partition,orientation,observation,provenance,prediction⟩

def survivor : Candidate := ⟨.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted,.admitted⟩

theorem generatedCardinality : candidates.length = 256 := rfl

theorem candidatesComplete (c : Candidate) : c ∈ candidates := by
  cases c with
  | mk carrier identity location partition orientation observation provenance prediction =>
    have hcarrier : carrier ∈ [Carrier.rejected,Carrier.admitted] := by
      cases carrier <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hidentity : identity ∈ [Identity.rejected,Identity.admitted] := by
      cases identity <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hlocation : location ∈ [Location.rejected,Location.admitted] := by
      cases location <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hpartition : partition ∈ [Partition.rejected,Partition.admitted] := by
      cases partition <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have horientation : orientation ∈ [Orientation.rejected,Orientation.admitted] := by
      cases orientation <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hobservation : observation ∈ [Observation.rejected,Observation.admitted] := by
      cases observation <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hprovenance : provenance ∈ [Provenance.rejected,Provenance.admitted] := by
      cases provenance <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    have hprediction : prediction ∈ [Prediction.rejected,Prediction.admitted] := by
      cases prediction <;> repeat first | exact List.Mem.head _ | apply List.Mem.tail
    unfold candidates
    apply CommonRefinement.memFlatMap _ _ carrier _ hcarrier
    apply CommonRefinement.memFlatMap _ _ identity _ hidentity
    apply CommonRefinement.memFlatMap _ _ location _ hlocation
    apply CommonRefinement.memFlatMap _ _ partition _ hpartition
    apply CommonRefinement.memFlatMap _ _ orientation _ horientation
    apply CommonRefinement.memFlatMap _ _ observation _ hobservation
    apply CommonRefinement.memFlatMap _ _ provenance _ hprovenance
    exact Count.TraceDerivation.memMap _ prediction _ hprediction

